// A high-level HTTP app: no C source files, socket plumbing, or accept loop.
//
// Run:
//   zexic run examples/http_app.zx
// Then visit:
//   curl 'http://127.0.0.1:8000/?name=Ada'
//   curl http://127.0.0.1:8000/hello/Grace
//   curl -X POST --data 'hello' http://127.0.0.1:8000/echo
//
// `import http.server;` is a friendly alias for the embedded `http` module.
// Handlers register on the process-wide default mux (like Go's http.HandleFunc)
// and `listen` takes an address string. Imported declarations are currently
// available directly, so handlers use Request, Response, and the helpers
// without a namespace prefix.

import http.server;

// escape_html encodes the characters that could break out of text context, so
// a visitor-supplied query value is rendered instead of executed.
fn escape_html(s: &String) -> String {
    let mut out = String::with_capacity(s.len());
    let mut i: usize = 0;
    while i < s.len() {
        let b = s.byte_at(i);
        if b == 38 {
            out.push_str("&amp;");
        } else if b == 60 {
            out.push_str("&lt;");
        } else if b == 62 {
            out.push_str("&gt;");
        } else if b == 34 {
            out.push_str("&quot;");
        } else if b == 39 {
            out.push_str("&#39;");
        } else {
            out.push_byte(b as u8);
        }
        i += 1;
    }
    return out;
}

fn home(req: &Request) -> Response {
    let name = req.query("name");
    if name.len() == 0 {
        return Response::html(200, "<h1>Hello from Zexi</h1><p>Try ?name=Ada or /hello/Grace</p>");
    }
    let safe = escape_html(&name);
    let body = f"<h1>Hello, {safe}!</h1>";
    return Response::html(200, body.as_str());
}

// user shows a named path parameter: `{name}` captures one segment.
fn user(req: &Request) -> Response {
    let raw = req.param("name");
    let safe = escape_html(&raw);
    let body = f"<h1>Hello, {safe}!</h1>";
    return Response::html(200, body.as_str());
}

fn echo(req: &Request) -> Response {
    return Response::text(200, req.body.as_str());
}

fn health(req: &Request) -> Response {
    return Response::json(200, "{\"ok\":true}");
}

fn main() -> i32 {
    handle_get("/", home);
    handle_post("/echo", echo);
    handle_get("/health", health);
    handle_get("/hello/{name}", user);

    println("listening on http://127.0.0.1:8000");
    listen("127.0.0.1:8000")
}
