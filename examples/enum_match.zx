// examples/enum_match.zx
// Tagged unions + exhaustive match. No null: absence is Option<T>.

#[copy]
enum Shape {
    Circle(f64),
    Rect { w: f64, h: f64 },
    Unit,
}

fn area(s: Shape) -> f64 {
    match s {
        Shape::Circle(r) => 3.141592653589793 * r * r,
        Shape::Rect { w, h } => w * h,
        Shape::Unit => 0.0,
    }
}

fn first_positive(xs: [i64; 4]) -> Option<i64> {
    for x in xs {
        if x > 0 { return Some(x); }
    }
    return None;
}

fn main() -> i32 {
    let shapes = [Shape::Circle(1.0), Shape::Rect { w: 2.0, h: 3.0 }, Shape::Unit];
    let mut total = 0.0;
    for s in shapes { total += area(s); }
    println(total);

    match first_positive([0, -1, 7, 9]) {
        Some(n) => println(n),
        None    => println("none"),
    }
    0
}
