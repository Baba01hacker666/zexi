// find: recursively list a path and everything below it. Directory entries are
// sorted so output is stable across filesystems.

use common;
use fs;

fn walk(dir: str) -> i32 {
    match fs::list_dir(dir) {
        Ok(found) => {
            let mut names = found;
            common::sort_names(&mut names);
            let mut i: usize = 0;
            while i < names.len() {
                let full = common::join_path(dir, names[i].as_str());
                println(full.as_str());
                if fs::is_dir(full.as_str()) {
                    let code = walk(full.as_str());
                    if code != 0 {
                        return code;
                    }
                }
                i += 1;
            }
            return 0;
        }
        Err(e) => {
            common::report_io("find", e);
            return 1;
        }
    }
}

pub fn run(root: str) -> i32 {
    if !fs::exists(root) {
        common::report("find", "no such file or directory");
        return 1;
    }
    println(root);
    if fs::is_dir(root) {
        return walk(root);
    }
    return 0;
}
