// examples/result.zx
// Errors are values. `?` is the single piece of implicit control flow and it
// is syntactically visible at the call site.

enum ParseError { Empty, BadDigit { pos: usize } }

fn parse_u32(s: str) -> Result<u32, ParseError> {
    if s.len() == 0 { return Err(ParseError::Empty); }
    let text = String::from(s);
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < text.len() {
        let c = text.byte_at(i);
        if c < 48 || c > 57 {
            return Err(ParseError::BadDigit { pos: i });
        }
        acc = acc * 10 + (c - 48) as u32;
        i += 1;
    }
    Ok(acc)
}

fn double(s: str) -> Result<u32, ParseError> {
    let n = parse_u32(s)?;      // early-return on Err, erase the Ok
    Ok(n * 2)
}

fn describe(e: ParseError) -> i32 {
    match e {
        ParseError::Empty => { println("empty"); 1 }
        ParseError::BadDigit { pos } => { println(pos); 2 }
    }
}

fn main() -> i32 {
    match double("21") {
        Ok(n) => { println(n); 0 }
        Err(e) => describe(e),
    }
}
