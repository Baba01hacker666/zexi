// examples/http_client.zx
//
// An HTTP client written in Zexi: it fetches a URL and prints the status and
// body. Run it against the example server:
//
//     zexic run examples/http_server.zx lib/http.zx      # terminal 1
//     zexic run examples/http_client.zx lib/http.zx      # terminal 2
//
// or point it at any HTTP/1.1 server that closes the connection, e.g.
//
//     python3 -m http.server 8080
//     zexic run examples/http_client.zx lib/http.zx

fn main() -> i32 {
    let host = "127.0.0.1";
    let port = 9090;
    let path = "/";

    let raw = http_get(host, port, path);
    if raw.len() == 0 {
        println("request failed (is a server listening on 127.0.0.1:9090?)");
        return 1;
    }

    let resp = parse_response(&raw);
    print("HTTP ");
    println(resp.status);
    print("reason: ");
    println(resp.reason);
    print("body: ");
    println(resp.body.trim());

    0
}
