// tests/syntax.zx
// A compact, runnable tour of Zexi's surface syntax. Read it alongside
// docs/07-cheatsheet.md: every construct shown there appears here as working
// code, and the program's output demonstrates each one.

// ---- constants ----------------------------------------------------------
const MAX: i32 = 100;
const GREETING = "hello, zexi";

/* Block comments nest, so /* like this */ is fine. */

// ---- functions and control flow ----------------------------------------
// `if` / `else if` / `else` as statements:
fn sign(n: i32) -> str {
    if n < 0 {
        return "negative";
    } else if n == 0 {
        return "zero";
    } else {
        return "positive";
    }
}

// `if` is also an expression: the chosen branch's value is the value.
fn sign_num(n: i32) -> i32 {
    return if n < 0 { -1 } else if n == 0 { 0 } else { 1 };
}

// Recursion.
fn factorial(n: i32) -> i32 {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

// ---- structs and methods ------------------------------------------------
struct Counter { count: i32 }

// `#[copy]` opts a type into copy semantics (the default is move-only).
#[copy]
struct Vec2 { x: f64, y: f64 }

impl Counter {
    fn bump(&mut self) -> i32 {
        self.count += 1;
        return self.count;
    }
}

impl Vec2 {
    fn dot(&self, o: Vec2) -> f64 {
        return self.x * o.x + self.y * o.y;
    }
}

// ---- enums and match ----------------------------------------------------
enum Direction { North, South, East, West }

fn turn_right(d: Direction) -> Direction {
    match d {
        Direction::North => Direction::East,
        Direction::East => Direction::South,
        Direction::South => Direction::West,
        Direction::West => Direction::North,
    }
}

fn name_of(d: Direction) -> str {
    match d {
        Direction::North => "N",
        Direction::South => "S",
        Direction::East => "E",
        Direction::West => "W",
    }
}

fn main() -> i32 {
    // ---- bindings: inferred/annotated, immutable/mutable ----------------
    let answer = 42;
    let mut total: i64 = 0;
    total += answer as i64;
    println(total); // 42

    // ---- operators ------------------------------------------------------
    println(2 + 3 * 4);       // 14
    println((2 + 3) * 4);     // 20
    println(17 / 5);          // 3
    println(17 % 5);          // 2
    println(1 << 4);          // 16
    println(0b1100 & 0b1010); // 8
    println(0b1100 | 0b1010); // 14
    println(3 < 5 && 5 < 3);  // false
    println(3 < 5 || 5 < 3);  // true
    println(!(3 < 5));        // false

    // ---- if / else ------------------------------------------------------
    println(sign(-7));     // negative
    println(sign(0));      // zero
    println(sign(9));      // positive
    println(sign_num(-7)); // -1
    println(factorial(5)); // 120

    // ---- while / loop / for --------------------------------------------
    let mut i: i32 = 0;
    let mut sum = 0;
    while i < 5 {
        sum += i;
        i += 1;
    }
    println(sum); // 10

    let mut n = 0;
    loop {
        n += 1;
        if n == 3 {
            break;
        }
    }
    println(n); // 3

    let mut acc = 0;
    for k in 1..=4 {
        acc += k;
    }
    println(acc); // 10

    // ---- casts ----------------------------------------------------------
    let big: i64 = 300;
    println(big as i32); // 300
    println(65 as char); // A

    // ---- char and bool --------------------------------------------------
    let ch: char = 'Z';
    let yes: bool = true;
    println(ch);  // Z
    println(yes); // true

    // ---- structs and methods -------------------------------------------
    let mut c = Counter { count: 0 };
    println(c.bump()); // 1
    println(c.bump()); // 2

    let v = Vec2 { x: 3.0, y: 4.0 };
    println(v.dot(Vec2 { x: 1.0, y: 2.0 })); // 11

    // ---- enums and match ------------------------------------------------
    println(name_of(Direction::North));                // N
    println(name_of(turn_right(Direction::North)));    // E

    // ---- arrays ---------------------------------------------------------
    let xs: [i32; 3] = [10, 20, 30];
    println(len(xs)); // 3
    println(xs[1]);   // 20
    let zeros = [0; 4];
    println(len(zeros)); // 4

    // ---- String (owning heap value) and Drop ---------------------------
    let mut s = String::from("zexi");
    s.push_str("!");
    println(s);       // zexi!
    println(s.len()); // 5

    // ---- printing -------------------------------------------------------
    print("no ");
    print("newline; ");
    println(GREETING); // no newline; hello, zexi
    println(MAX);      // 100

    0
}
