// tests/enums.zx
// Enums (tagged unions) and `match`: tuple variants, unit variants, struct
// variants, binding payloads, exhaustiveness with a wildcard, and integer
// matching.

enum Shape {
    Circle(f64),
    Rect(f64, f64),
    Point,
}

enum Message {
    Quit,
    Move { x: i32, y: i32 },
    Write(str),
}

fn area(s: Shape) -> f64 {
    match s {
        Shape::Circle(r) => 3.14159 * r * r,
        Shape::Rect(w, h) => w * h,
        Shape::Point => 0.0,
    }
}

impl Shape {
    // Methods on enums are supported, including matching through `&self`.
    fn is_point(&self) -> bool {
        match *self {
            Shape::Point => true,
            _ => false,
        }
    }
}

fn describe(n: i32) -> str {
    match n {
        0 => "zero",
        1 => "one",
        _ => "many",
    }
}

fn handle(m: Message) -> i32 {
    match m {
        Message::Quit => 0,
        Message::Move { x, y } => x + y,
        Message::Write(_) => -1,
    }
}

// Owned payloads: matching through a borrow must not steal the payload.
enum Owned { Text(String), Empty }

fn peek(o: &Owned) -> i32 {
    match *o {
        Owned::Text(_) => 1,
        Owned::Empty => 0,
    }
}

struct Holder { o: Owned }

impl Holder {
    fn is_text(&self) -> bool {
        match self.o {
            Owned::Text(_) => true,
            Owned::Empty => false,
        }
    }
}

// Enums with no heap payloads are only read by `match`, so they can be
// matched more than once.
enum Color { Red, Green }

fn main() -> i32 {
    let a = Shape::Circle(2.0);
    let b = Shape::Rect(3.0, 4.0);
    let c = Shape::Point;

    println(a.is_point());
    println(c.is_point());

    println(area(a));
    println(area(b));
    println(area(c));

    println(describe(0));
    println(describe(1));
    println(describe(7));

    println(handle(Message::Quit));
    println(handle(Message::Move { x: 3, y: 4 }));
    println(handle(Message::Write("hi")));

    let mut s = Shape::Circle(1.0);
    s = Shape::Rect(2.0, 5.0);
    println(area(s));

    let owned = Owned::Text(String::from("kept"));
    println(peek(&owned));
    println(peek(&owned));
    match owned { Owned::Text(t) => println(t), Owned::Empty => println("empty") }

    let h = Holder { o: Owned::Text(String::from("field")) };
    println(h.is_text());
    match h.o { Owned::Text(t) => println(t), Owned::Empty => println("empty") }

    let col = Color::Red;
    match col { Color::Red => println("red"), Color::Green => println("green") }
    match col { Color::Red => println("again"), Color::Green => println("green") }

    0
}
