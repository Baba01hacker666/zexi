// tests/tour.zx
// Exercises the M0-alpha subset: functions, recursion, let/inference, while,
// for-range, if/else, arithmetic, comparison, casts, and printing.

const LIMIT: i32 = 10;
const GREETING = "hello from zexi";

fn fib(n: i32) -> i32 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn sum_to(n: i32) -> i32 {
    let mut total: i32 = 0;
    for k in 1..=n {
        total += k;
    }
    return total;
}

fn classify(n: i32) -> str {
    if n < 0 {
        return "negative";
    } else if n == 0 {
        return "zero";
    } else {
        return "positive";
    }
}

fn main() -> i32 {
    println(GREETING);

    let mut i: i32 = 0;
    while i < LIMIT {
        print(fib(i));
        print(" ");
        i += 1;
    }
    println("");

    let s = sum_to(10);
    println(s);
    println(classify(s - 55));

    let big: i64 = 9000000000;
    println(big);

    let ratio: f64 = 3.5;
    println(ratio * 2.0);

    let ok: bool = s > 40;
    println(ok);

    let ch: char = 'Z';
    println(ch);

    let narrowed = (big as i32);
    println(narrowed);

    0
}
