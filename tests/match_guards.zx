// tests/match_guards.zx
// `match` guards: `pat if cond => body`. When a pattern matches but its guard
// fails, the next arm is tried, so the same variant may appear more than once.

enum Shape {
    Circle(i32),
    Rect(i32, i32),
    Point,
}

fn area(s: Shape) -> i32 {
    match s {
        Shape::Circle(r) if r <= 0 => 0,
        Shape::Circle(r) => 3 * r * r,
        Shape::Rect(w, h) if w == h => w * w,
        Shape::Rect(w, h) => w * h,
        Shape::Point => 0,
    }
}

fn classify(n: i32) -> str {
    match n {
        0 => "zero",
        x if x < 0 => "negative",
        x if x > 100 => "big",
        _ => "small",
    }
}

fn main() -> i32 {
    println(area(Shape::Circle(3)));
    println(area(Shape::Circle(0)));
    println(area(Shape::Rect(4, 4)));
    println(area(Shape::Rect(3, 5)));
    println(area(Shape::Point));
    println(classify(0));
    println(classify(-7));
    println(classify(500));
    println(classify(9));
    0
}
