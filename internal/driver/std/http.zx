// http — a high-level HTTP/1.x client and server for Zexi.
//
// Client (urllib/requests-flavoured):
//
//     import http.client;
//
//     fn main() {
//         let r = fetch("http://example.com/");
//         if r.ok() {
//             println(r.status);
//             println(r.body);
//         } else {
//             println(r.error);
//         }
//     }
//
// `Client` adds timeouts, extra headers, redirect following, and the usual
// verbs. URLs are parsed with `parse_url`; query/form values are decoded for
// you. Connections are plaintext HTTP only — `https://` reports an error.
//
// Server (Go-style default mux, or an explicit Router):
//
//     import http.server;
//     fn hello(req: &Request) -> Response { Response::html(200, "<h1>hi</h1>") }
//     fn main() -> i32 {
//         handle_get("/", hello);
//         listen(":8080")
//     }
//
// `{name}` path segments are captured (`req.param("name")`), and
// `use_before`/`use_after` attach middleware. An explicit Router
// (`new_app()`, `app.get`, `app.listen`) is available when a program holds
// several servers.
//
// A handler may return `Result<Response, String>` instead, registered through
// `get_result` and friends: `Err(e)` becomes a 500 with a generic body, and
// the message goes to the server log. Inside the handler the `?` operator
// propagates a lookup failure to that answer, so a data or file error does not
// need a match at every step.
//
// Many users at once: the single-threaded `listen` handles one request at a
// time, which is fine for a laptop demo and wrong for a real site. A worker
// pool serves several connections in parallel:
//
//     import http.server;
//     fn main() -> i32 {
//         handle_get("/", hello);
//         listen_workers(":8080", 8)   // eight OS threads accepting together
//     }
//
// `listen_workers`, `listen_workers_n`, and the `Router` methods of the same
// name pin the router, spawn OS threads that accept on one shared listener,
// and join them. `stop_serving()` asks the pool to wind down, and
// `requests_served()` / `connections_served()` report what the whole pool did.
//
// Bodies are framed by Content-Length or chunked encoding (responses) and
// Content-Length (requests); reads are bounded and client I/O has a timeout.

use net;
use thread;
use io;

// File helpers are declared by `net`, which owns the shared opt-in C shim.

// --- limits and defaults ---------------------------------------------------

// MAX_BODY caps how much response/request body is buffered.
const MAX_BODY: usize = 16777216;
// MAX_FILE caps a single static file or download.
const MAX_FILE: usize = 33554432;
// DEFAULT_TIMEOUT_MS bounds blocking I/O on client connections.
const DEFAULT_TIMEOUT_MS: i32 = 30000;
// HEAD_TIMEOUT_MS bounds how long a peer may take to send a complete request
// head. It is deliberately short: a connection that trickles a head, or opens
// and sends nothing, occupies a worker for the whole timeout, so a handful of
// slow peers is enough to stall a small pool. Raise it per router with
// `header_timeout` when clients are expected to be slow.
const HEAD_TIMEOUT_MS: i32 = 1000;
// MAX_HEAD is how much of a request head a worker buffers (net's receive
// buffer). A head that does not end within this many bytes is refused with
// 431 instead of being parsed as a truncated request line.
const MAX_HEAD: usize = 8192;
// FIRST_BYTE_MS is how long an accepted connection gets to send its first
// byte before it is dropped. A connected client sends the request line
// immediately, so a socket that stays quiet is a probe or a deliberate stall
// and should not hold a worker for the full head timeout.
const FIRST_BYTE_MS: i32 = 250;
// DRAIN_MS bounds the pre-close drain, which keeps a reset from destroying the
// response the peer has not read yet.
const DRAIN_MS: i32 = 100;
// DEFAULT_MAX_REDIRECTS is how many redirect hops a client follows.
const DEFAULT_MAX_REDIRECTS: i32 = 5;

// SUBSTR_ALL is the sentinel length passed to `substr` when the caller wants
// "the rest of the string". 2^32 - 1 is the largest value a `usize`-shaped
// length argument can carry without overflowing.
const SUBSTR_ALL: usize = 4294967295;

// --- URLs ------------------------------------------------------------------

pub struct Url {
    pub scheme: String,
    pub host: String,
    pub port: i32,
    // path has no query string; it starts with "/".
    pub path: String,
    // query is the raw text after "?" (not decoded).
    pub query: String,
    // error is non-empty when the URL could not be parsed.
    pub error: String,
}

impl Url {
    pub fn valid(&self) -> bool {
        return self.error.len() == 0 && self.host.len() > 0;
    }

    // target is the request-target: path plus "?query" when present.
    pub fn target(&self) -> String {
        let mut out = self.path.clone();
        if self.query.len() > 0 {
            out.push_byte(63); // '?'
            out.push_str(self.query.as_str());
        }
        return out;
    }

    // host_port is the Host header value, omitting the default port.
    pub fn host_port(&self) -> String {
        let mut out = self.host.clone();
        if self.port != 80 {
            out.push_byte(58); // ':'
            push_int(&mut out, self.port as i64);
        }
        return out;
    }

    // origin is "http://host[:port]", used to resolve relative redirects.
    pub fn origin(&self) -> String {
        let mut out = String::from("http://");
        let hp = self.host_port();
        out.push_str(hp.as_str());
        return out;
    }
}

// parse_url splits an absolute http:// URL into its parts. On failure the
// returned Url has a non-empty error and valid() is false.
pub fn parse_url(raw: str) -> Url {
    let s = String::from(raw);
    let sep = s.find("://");
    if sep < 0 {
        return empty_url("missing URL scheme (expected http://host/path)");
    }
    let scheme_raw = s.substr(0, sep as usize);
    let scheme = http_lower(&scheme_raw);
    if scheme.as_str() != "http" {
        if scheme.as_str() == "https" {
            return empty_url("https is not supported (this client is plaintext HTTP only)");
        }
        return empty_url("unsupported URL scheme");
    }

    let after = s.substr((sep + 3) as usize, SUBSTR_ALL);
    let hash = after.find("#");
    let rest = if hash < 0 { after } else { after.substr(0, hash as usize) };

    // The authority ends at the first "/" or "?".
    let slash = rest.find("/");
    let qmark = rest.find("?");
    let mut auth_end = rest.len();
    if slash >= 0 && (slash as usize) < auth_end {
        auth_end = slash as usize;
    }
    if qmark >= 0 && (qmark as usize) < auth_end {
        auth_end = qmark as usize;
    }
    let authority = rest.substr(0, auth_end);
    let tail = rest.substr(auth_end, SUBSTR_ALL);

    if authority.len() == 0 {
        return empty_url("missing host in URL");
    }

    let colon = authority.find(":");
    let host = if colon < 0 { authority.clone() } else { authority.substr(0, colon as usize) };
    if host.len() == 0 {
        return empty_url("missing host in URL");
    }

    let mut port: i32 = 80;
    if colon >= 0 {
        let ps = authority.substr((colon + 1) as usize, SUBSTR_ALL);
        let p = parse_dec(&ps);
        if p <= 0 || p > 65535 {
            return empty_url("invalid port in URL");
        }
        port = p as i32;
    }

    let mut path = String::from("/");
    let mut query = String::new();
    if tail.len() > 0 {
        if tail.starts_with("/") {
            let q = tail.find("?");
            if q < 0 {
                path = tail;
            } else {
                path = tail.substr(0, q as usize);
                query = tail.substr((q + 1) as usize, SUBSTR_ALL);
            }
        } else {
            // tail starts with "?": no path was given.
            query = tail.substr(1, SUBSTR_ALL);
        }
    }
    return Url { scheme: scheme, host: host, port: port, path: path, query: query, error: String::new() };
}

fn empty_url(err: str) -> Url {
    return Url {
        scheme: String::from("http"), host: String::new(), port: 80,
        path: String::from("/"), query: String::new(), error: String::from(err),
    };
}

// url_encode percent-encodes a value for use in a query string.
pub fn url_encode(s: str) -> String {
    let v = String::from(s);
    let mut out = String::new();
    let mut i: usize = 0;
    while i < v.len() {
        let b = v.byte_at(i);
        if is_unreserved(b) {
            out.push_byte(b as u8);
        } else {
            out.push_byte(37); // '%'
            out.push_byte(hex_digit((b >> 4) & 15));
            out.push_byte(hex_digit(b & 15));
        }
        i += 1;
    }
    return out;
}

// url_decode decodes %XX escapes and '+' as space.
pub fn url_decode(s: str) -> String {
    let v = String::from(s);
    let mut out = String::new();
    let mut i: usize = 0;
    while i < v.len() {
        let b = v.byte_at(i);
        if b == 43 {
            out.push_byte(32);
            i += 1;
        } else if b == 37 && i + 2 < v.len() {
            let hi = hex_value(v.byte_at(i + 1));
            let lo = hex_value(v.byte_at(i + 2));
            if hi >= 0 && lo >= 0 {
                out.push_byte((hi * 16 + lo) as u8);
                i += 3;
            } else {
                out.push_byte(37);
                i += 1;
            }
        } else {
            out.push_byte(b as u8);
            i += 1;
        }
    }
    return out;
}

fn is_unreserved(b: i64) -> bool {
    if b >= 48 && b <= 57 {
        return true;
    }
    if b >= 65 && b <= 90 {
        return true;
    }
    if b >= 97 && b <= 122 {
        return true;
    }
    return b == 45 || b == 46 || b == 95 || b == 126;
}

fn hex_digit(n: i64) -> u8 {
    if n < 10 {
        return (48 + n) as u8;
    }
    return (55 + n) as u8;
}

fn hex_value(b: i64) -> i64 {
    if b >= 48 && b <= 57 {
        return b - 48;
    }
    if b >= 65 && b <= 70 {
        return b - 55;
    }
    if b >= 97 && b <= 102 {
        return b - 87;
    }
    return -1;
}

// query_value returns the decoded value of `name` in a raw query string, or
// "" when absent. Works for both query strings and form bodies.
pub fn query_value(raw: &String, name: str) -> String {
    // The lookup compares bytes, so no key allocation is needed.
    let mut pos: usize = 0;
    while pos <= raw.len() {
        let rest = raw.substr(pos, SUBSTR_ALL);
        let amp = rest.find("&");
        let pair = if amp < 0 { rest.clone() } else { rest.substr(0, amp as usize) };
        let eq = pair.find("=");
        let key_raw = if eq < 0 { pair.clone() } else { pair.substr(0, eq as usize) };
        let val_raw = if eq < 0 { String::new() } else { pair.substr((eq + 1) as usize, SUBSTR_ALL) };
        let key = url_decode(key_raw.as_str());
        if key.as_str() == name {
            return url_decode(val_raw.as_str());
        }
        if amp < 0 {
            break;
        }
        pos = pos + (amp as usize) + 1;
    }
    return String::new();
}

// --- model -----------------------------------------------------------------

pub struct Request {
    pub method: String,
    // path includes the query string, as sent by the client.
    pub path: String,
    pub version: String,
    // headers is the raw head block after the request line.
    pub headers: String,
    pub body: String,
    // params holds values captured by `{name}` route segments. It is encoded
    // as `\x1fname\x1fvalue` pairs and is filled in by Router.dispatch.
    params: String,
    // head_bytes is how many bytes of head arrived, so a server can tell a
    // silent probe (answer nothing) from a malformed request (answer 400).
    head_bytes: usize,
    // head_overflow reports a head that did not end within MAX_HEAD bytes.
    head_overflow: bool,
}

pub struct Response {
    pub status: i32,
    pub reason: String,
    // headers holds raw extra header lines (each ending in CRLF) for an
    // outgoing response; for a parsed response it is the raw header block.
    pub headers: String,
    pub body: String,
    pub content_type: String,
    // error explains a client-side failure (status is 0 in that case).
    pub error: String,
    // keep_alive asks send_response to advertise a persistent connection.
    pub keep_alive: bool,
}

impl Request {
    // header returns the value of the named header (case-insensitive), or "".
    pub fn header(&self, name: str) -> String {
        return header_value(&self.headers, name);
    }

    // content_length returns Content-Length, or -1 when absent or invalid.
    pub fn content_length(&self) -> i64 {
        let value = header_value(&self.headers, "Content-Length");
        return parse_dec(&value);
    }

    // chunked reports a request whose body uses chunked transfer encoding.
    // Such a body is read until its terminator, and a malformed one leaves
    // unread bytes behind, so the server drains before it closes.
    pub fn chunked(&self) -> bool {
        let value = header_value(&self.headers, "Transfer-Encoding");
        let enc = http_lower(&value);
        return enc.contains("chunked");
    }

    // body_complete reports whether the whole declared body was read.
    pub fn body_complete(&self) -> bool {
        let want = self.content_length();
        if want < 0 {
            return true;
        }
        return (self.body.len() as i64) >= want;
    }

    // body_too_large reports a Content-Length above the buffering cap.
    pub fn body_too_large(&self) -> bool {
        let want = self.content_length();
        return want > MAX_BODY as i64;
    }

    // valid reports whether a request line was parsed.
    pub fn valid(&self) -> bool {
        return self.method.len() > 0;
    }

    // path_only is the path without its query string.
    pub fn path_only(&self) -> String {
        let q = self.path.find("?");
        if q < 0 {
            return self.path.clone();
        }
        return self.path.substr(0, q as usize);
    }

    // raw_query is the undecoded query string ("" when absent).
    pub fn raw_query(&self) -> String {
        let q = self.path.find("?");
        if q < 0 {
            return String::new();
        }
        return self.path.substr((q + 1) as usize, SUBSTR_ALL);
    }

    // query returns a decoded query-string parameter.
    pub fn query(&self, name: str) -> String {
        let q = self.raw_query();
        return query_value(&q, name);
    }

    // cookie returns the value of a Cookie header pair ("sid=abc" -> "abc").
    pub fn cookie(&self, name: str) -> String {
        let header = self.header("Cookie");
        let want = String::from(name);
        let mut pos: usize = 0;
        while pos <= header.len() {
            let rest = header.substr(pos, SUBSTR_ALL);
            let semi = rest.find(";");
            let pair = if semi < 0 { rest.clone() } else { rest.substr(0, semi as usize) };
            let eq = pair.find("=");
            if eq >= 0 {
                let key = pair.substr(0, eq as usize).trim();
                if key.as_str() == want.as_str() {
                    return pair.substr((eq + 1) as usize, SUBSTR_ALL).trim();
                }
            }
            if semi < 0 {
                break;
            }
            pos = pos + (semi as usize) + 1;
        }
        return String::new();
    }

    // param looks in the query string, then at a `{name}` route segment, then
    // in an application/x-www-form-urlencoded body.
    pub fn param(&self, name: str) -> String {
        let q = self.raw_query();
        let v = query_value(&q, name);
        if v.len() > 0 {
            return v;
        }
        let rv = self.route_param(name);
        if rv.len() > 0 {
            return rv;
        }
        let ct = self.header("Content-Type");
        let ct_l = http_lower(&ct);
        if ct_l.contains("application/x-www-form-urlencoded") {
            return query_value(&self.body, name);
        }
        return String::new();
    }

    // route_param returns a value captured by a `{name}` segment in the route
    // pattern that matched this request ("" when the route has no such name).
    // Route parameters are also available through `param`.
    pub fn route_param(&self, name: str) -> String {
        let want = String::from(name);
        let mut pos: usize = 0;
        while pos < self.params.len() {
            let rest = self.params.substr(pos, SUBSTR_ALL);
            let lead = rest.find("\x1f");
            if lead < 0 {
                break;
            }
            pos = pos + (lead as usize) + 1;
            let rest2 = self.params.substr(pos, SUBSTR_ALL);
            let mid = rest2.find("\x1f");
            if mid < 0 {
                break;
            }
            let key = rest2.substr(0, mid as usize);
            pos = pos + (mid as usize) + 1;
            let rest3 = self.params.substr(pos, SUBSTR_ALL);
            let next = rest3.find("\x1f");
            let val = if next < 0 { rest3 } else { rest3.substr(0, next as usize) };
            if key.as_str() == want.as_str() {
                return val;
            }
            if next < 0 {
                break;
            }
            pos = pos + (next as usize);
        }
        return String::new();
    }

    // collect_params copies every captured `{name}` segment into `out`.
    pub fn collect_params(&self, out: &mut HashMap<String, String>) {
        let mut pos: usize = 0;
        while pos < self.params.len() {
            let rest = self.params.substr(pos, SUBSTR_ALL);
            let lead = rest.find("\x1f");
            if lead < 0 {
                break;
            }
            pos = pos + (lead as usize) + 1;
            let rest2 = self.params.substr(pos, SUBSTR_ALL);
            let mid = rest2.find("\x1f");
            if mid < 0 {
                break;
            }
            let key = rest2.substr(0, mid as usize);
            pos = pos + (mid as usize) + 1;
            let rest3 = self.params.substr(pos, SUBSTR_ALL);
            let next = rest3.find("\x1f");
            let val = if next < 0 { rest3 } else { rest3.substr(0, next as usize) };
            out.insert(key, val);
            if next < 0 {
                break;
            }
            pos = pos + (next as usize);
        }
    }

    // params_map copies the captured `{name}` segments into a new map.
    pub fn params_map(&self) -> HashMap<String, String> {
        let mut out: HashMap<String, String> = HashMap::new();
        self.collect_params(&mut out);
        return out;
    }

    // query_map copies the decoded query string into a new map.
    pub fn query_map(&self) -> HashMap<String, String> {
        let mut out: HashMap<String, String> = HashMap::new();
        self.collect_query(&mut out);
        return out;
    }

    // form_map copies an x-www-form-urlencoded body into a new map.
    pub fn form_map(&self) -> HashMap<String, String> {
        let mut out: HashMap<String, String> = HashMap::new();
        self.collect_form(&mut out);
        return out;
    }

    // collect_query copies every decoded query value into `out`.
    pub fn collect_query(&self, out: &mut HashMap<String, String>) {
        let raw = self.raw_query();
        collect_query_into(&raw, out);
    }

    // collect_form copies an x-www-form-urlencoded body into `out`.
    pub fn collect_form(&self, out: &mut HashMap<String, String>) {
        collect_query_into(&self.body, out);
    }

    // wants_keep_alive reports whether the client asked to reuse the socket.
    pub fn wants_keep_alive(&self) -> bool {
        let cv = self.header("Connection");
        let conn = http_lower(&cv);
        if conn.contains("close") {
            return false;
        }
        if self.version.as_str() == "HTTP/1.0" {
            return conn.contains("keep-alive");
        }
        return true;
    }
}

impl Response {
    // new builds a text/plain response.
    pub fn new(status: i32, body: str) -> Response {
        return Response {
            status: status,
            reason: String::from(reason_phrase(status)),
            headers: String::new(),
            body: String::from(body),
            content_type: String::from("text/plain; charset=utf-8"),
            error: String::new(),
            keep_alive: false,
        };
    }

    // from_string takes an owning body without round-tripping through `str`,
    // so binary data (including NUL bytes) survives intact.
    pub fn from_string(status: i32, body: String) -> Response {
        return Response {
            status: status,
            reason: String::from(reason_phrase(status)),
            headers: String::new(),
            body: body,
            content_type: String::from("text/plain; charset=utf-8"),
            error: String::new(),
            keep_alive: false,
        };
    }

    pub fn text(status: i32, body: str) -> Response {
        return Response::new(status, body);
    }

    pub fn html(status: i32, body: str) -> Response {
        let mut r = Response::new(status, body);
        r.content_type = String::from("text/html; charset=utf-8");
        return r;
    }

    pub fn json(status: i32, body: str) -> Response {
        let mut r = Response::new(status, body);
        r.content_type = String::from("application/json");
        return r;
    }

    pub fn empty(status: i32) -> Response {
        return Response::new(status, "");
    }

    // redirect builds a 302 with a Location header.
    pub fn redirect(location: str) -> Response {
        let mut r = Response::empty(302);
        r.set_header("Location", location);
        return r;
    }

    // set_header appends an extra header, ignoring CR/LF injection.
    pub fn set_header(&mut self, name: str, value: str) {
        if contains_crlf(name) || contains_crlf(value) {
            return;
        }
        self.headers.push_str(name);
        self.headers.push_str(": ");
        self.headers.push_str(value);
        self.headers.push_str("\r\n");
    }

    // set_cookie appends a Set-Cookie header for a simple name=value pair.
    pub fn set_cookie(&mut self, name: str, value: str) {
        if contains_crlf(name) || contains_crlf(value) {
            return;
        }
        let mut cookie = String::from(name);
        cookie.push_byte(61); // '='
        cookie.push_str(value);
        self.set_header("Set-Cookie", cookie.as_str());
    }

    // header returns the value of the named header (case-insensitive), or "".
    pub fn header(&self, name: str) -> String {
        return header_value(&self.headers, name);
    }

    // content_length returns Content-Length, or -1 when absent or invalid.
    pub fn content_length(&self) -> i64 {
        let value = header_value(&self.headers, "Content-Length");
        return parse_dec(&value);
    }

    // valid reports whether a status line was parsed.
    pub fn valid(&self) -> bool {
        return self.status > 0;
    }

    // ok reports a 2xx status.
    pub fn ok(&self) -> bool {
        return self.status >= 200 && self.status < 300;
    }
}

// --- server ----------------------------------------------------------------

// reason_phrase returns the conventional reason phrase for a status code.
pub fn reason_phrase(status: i32) -> str {
    if status == 200 { return "OK"; }
    if status == 201 { return "Created"; }
    if status == 202 { return "Accepted"; }
    if status == 204 { return "No Content"; }
    if status == 206 { return "Partial Content"; }
    if status == 301 { return "Moved Permanently"; }
    if status == 302 { return "Found"; }
    if status == 303 { return "See Other"; }
    if status == 304 { return "Not Modified"; }
    if status == 307 { return "Temporary Redirect"; }
    if status == 308 { return "Permanent Redirect"; }
    if status == 400 { return "Bad Request"; }
    if status == 401 { return "Unauthorized"; }
    if status == 403 { return "Forbidden"; }
    if status == 404 { return "Not Found"; }
    if status == 405 { return "Method Not Allowed"; }
    if status == 409 { return "Conflict"; }
    if status == 413 { return "Payload Too Large"; }
    if status == 415 { return "Unsupported Media Type"; }
    if status == 422 { return "Unprocessable Entity"; }
    if status == 429 { return "Too Many Requests"; }
    if status == 500 { return "Internal Server Error"; }
    if status == 501 { return "Not Implemented"; }
    if status == 502 { return "Bad Gateway"; }
    if status == 503 { return "Service Unavailable"; }
    if status == 504 { return "Gateway Timeout"; }
    return "OK";
}

// response renders a complete text/plain response with Connection: close.
pub fn response(status: i32, reason: str, body: str) -> String {
    return response_type(status, reason, "text/plain; charset=utf-8", body);
}

// response_type renders a response with an explicit Content-Type.
pub fn response_type(status: i32, reason: str, content_type: str, body: str) -> String {
    let mut r = Response::new(status, body);
    r.reason = String::from(reason);
    r.content_type = String::from(content_type);
    return render_response(&r);
}

// response_head serializes the status line and headers, ending with the blank
// line that separates them from the body.
pub fn response_head(r: &Response) -> String {
    let mut out = String::new();
    out.push_str("HTTP/1.1 ");
    push_int(&mut out, r.status as i64);
    out.push_str(" ");
    if r.reason.len() == 0 {
        out.push_str(reason_phrase(r.status));
    } else {
        out.push_str(r.reason.as_str());
    }
    out.push_str("\r\nContent-Type: ");
    out.push_str(r.content_type.as_str());
    out.push_str("\r\nContent-Length: ");
    push_int(&mut out, r.body.len() as i64);
    out.push_str("\r\n");
    out.push_str(r.headers.as_str());
    out.push_str("Connection: ");
    if r.keep_alive {
        out.push_str("keep-alive");
    } else {
        out.push_str("close");
    }
    out.push_str("\r\n\r\n");
    return out;
}

// render_response serializes a response to a single string. It is meant for
// text bodies: use send_response for binary payloads, which writes the body
// separately and preserves NUL bytes.
pub fn render_response(r: &Response) -> String {
    let mut out = response_head(r);
    out.push_str(r.body.as_str());
    return out;
}

// send_response writes a complete response. Returns bytes sent, or -1.
pub fn send_response(c: &Conn, r: &Response) -> i64 {
    let head = response_head(r);
    let sent = c.write(head);
    if sent < 0 {
        return -1;
    }
    if r.body.len() == 0 {
        return sent;
    }
    let body_sent = c.write_raw(r.body.as_str(), r.body.len());
    if body_sent < 0 {
        return -1;
    }
    return sent + body_sent;
}

// parse_request splits a raw request into method, path, version, headers and
// body. `raw` may be just the head (as returned by Conn.read_head) or a
// complete request with a body.
pub fn parse_request(raw: &String) -> Request {
    let end = raw.find("\r\n");
    if end < 0 {
        return Request {
            method: String::new(), path: String::new(), version: String::new(),
            headers: String::new(), body: String::new(), params: String::new(),
            head_bytes: raw.len(), head_overflow: false,
        };
    }
    let line = raw.substr(0, end as usize);
    let sp1 = line.find(" ");
    let method = if sp1 < 0 { line.clone() } else { line.substr(0, sp1 as usize) };
    let rest = if sp1 < 0 { String::new() } else { line.substr((sp1 + 1) as usize, SUBSTR_ALL) };
    let sp2 = rest.find(" ");
    let path = if sp2 < 0 { rest.clone() } else { rest.substr(0, sp2 as usize) };
    let version = if sp2 < 0 { String::new() } else { rest.substr((sp2 + 1) as usize, SUBSTR_ALL).trim() };

    let headers = header_block(raw);
    let he = head_end(raw);
    let body = if he < 0 { String::new() } else { raw.substr(he as usize, SUBSTR_ALL) };
    return Request {
        method: method, path: path, version: version, headers: headers, body: body,
        params: String::new(), head_bytes: raw.len(), head_overflow: false,
    };
}

// read_request reads a request head and then its body, using Content-Length
// when the client declared one. Connections that send nothing (readiness
// probes) yield an invalid request with an empty method and body.
pub fn read_request(c: &Conn) -> Request {
    let head = c.read_head();
    let mut req = parse_request(&head);
    req.head_bytes = head.len();
    // read_head stops one byte short of its buffer, so the last possible
    // length is MAX_HEAD - 1.
    req.head_overflow = head.len() >= MAX_HEAD - 1 && head_end(&head) < 0;
    // The head deadline is short; a body is being sent by a client that already
    // spoke, so it gets the ordinary I/O timeout.
    c.set_timeout(DEFAULT_TIMEOUT_MS);
    let want = req.content_length();
    if want > 0 && want <= MAX_BODY as i64 {
        let have = req.body.len() as i64;
        if have < want {
            let take = want - have;
            let more = c.read_exact(take as usize);
            req.body.push_str(more);
        }
    }
    return req;
}

// --- client ----------------------------------------------------------------

// Client holds settings shared by a group of requests.
pub struct Client {
    pub timeout_ms: i32,
    pub follow_redirects: bool,
    pub max_redirects: i32,
    pub user_agent: String,
    // headers is raw extra header lines, each ending in CRLF.
    pub headers: String,
}

impl Client {
    pub fn new() -> Client {
        return Client {
            timeout_ms: DEFAULT_TIMEOUT_MS,
            follow_redirects: true,
            max_redirects: DEFAULT_MAX_REDIRECTS,
            user_agent: String::from("zexi-http/0.2"),
            headers: String::new(),
        };
    }

    // set_header adds a header sent with every request from this client.
    pub fn set_header(&mut self, name: str, value: str) {
        if contains_crlf(name) || contains_crlf(value) {
            return;
        }
        self.headers.push_str(name);
        self.headers.push_str(": ");
        self.headers.push_str(value);
        self.headers.push_str("\r\n");
    }

    pub fn get(&self, url: str) -> Response {
        return self.send("GET", url, "", "");
    }

    pub fn post(&self, url: str, body: str) -> Response {
        return self.send("POST", url, body, "text/plain; charset=utf-8");
    }

    pub fn post_type(&self, url: str, body: str, content_type: str) -> Response {
        return self.send("POST", url, body, content_type);
    }

    pub fn put(&self, url: str, body: str) -> Response {
        return self.send("PUT", url, body, "text/plain; charset=utf-8");
    }

    pub fn delete(&self, url: str) -> Response {
        return self.send("DELETE", url, "", "");
    }

    // post_form sends an application/x-www-form-urlencoded body.
    pub fn post_form(&self, url: str, form: str) -> Response {
        return self.send("POST", url, form, "application/x-www-form-urlencoded");
    }

    // download fetches a URL and writes its body to dest. The returned
    // Response has `error` set when the file could not be written.
    pub fn download(&self, url: str, dest: str) -> Response {
        let mut resp = self.get(url);
        if resp.ok() {
            let body_len = resp.body.len();
            let n = zxn_write_file(dest, resp.body.as_str(), body_len as i32);
            if n < 0 {
                resp.error = String::from("cannot write file");
            }
        }
        return resp;
    }

    // send performs one logical request, following redirects when enabled.
    pub fn send(&self, method: str, url: str, body: str, content_type: str) -> Response {
        let m = String::from(method);
        let u = String::from(url);
        let b = String::from(body);
        let ct = String::from(content_type);
        return self.send_inner(&m, &u, &b, &ct, 0, true);
    }

    fn send_inner(&self, method: &String, url: &String, body: &String, content_type: &String, depth: i32, send_headers: bool) -> Response {
        let u = parse_url(url.as_str());
        if !u.valid() {
            return bad_response(u.error.as_str());
        }
        let resp = self.one(&u, method, body, content_type, send_headers);
        if self.follow_redirects && is_redirect(resp.status) {
            let loc = resp.header("Location");
            if loc.len() > 0 {
                if depth >= self.max_redirects {
                    return bad_response("too many redirects");
                }
                let next = resolve_location(&u, &loc);
                let nu = parse_url(next.as_str());
                let same_origin = nu.host.as_str() == u.host.as_str() && nu.port == u.port;
                let next_headers = send_headers && same_origin;
                if resp.status == 301 || resp.status == 302 || resp.status == 303 {
                    let get = String::from("GET");
                    let none = String::new();
                    return self.send_inner(&get, &next, &none, &none, depth + 1, next_headers);
                }
                return self.send_inner(method, &next, body, content_type, depth + 1, next_headers);
            }
        }
        return resp;
    }

    // one performs exactly one request/response exchange.
    fn one(&self, u: &Url, method: &String, body: &String, content_type: &String, send_headers: bool) -> Response {
        let mut c = connect(u.host.as_str(), u.port);
        if c.fd < 0 {
            return bad_response("connection failed");
        }
        c.set_timeout(self.timeout_ms);

        let mut req = String::new();
        req.push_str(method.as_str());
        req.push_str(" ");
        let target = u.target();
        req.push_str(target.as_str());
        req.push_str(" HTTP/1.1\r\nHost: ");
        let hp = u.host_port();
        req.push_str(hp.as_str());
        req.push_str("\r\nUser-Agent: ");
        req.push_str(self.user_agent.as_str());
        req.push_str("\r\nAccept: */*\r\n");
        if send_headers && self.headers.len() > 0 {
            req.push_str(self.headers.as_str());
        }
        if body.len() > 0 {
            req.push_str("Content-Type: ");
            req.push_str(content_type.as_str());
            req.push_str("\r\nContent-Length: ");
            push_int(&mut req, body.len() as i64);
            req.push_str("\r\n");
        }
        req.push_str("Connection: close\r\n\r\n");
        req.push_str(body.as_str());

        c.write(req);
        let raw = read_raw(&c);
        c.close();
        let mut resp = parse_response(&raw);
        if raw.len() == 0 {
            resp.error = String::from("empty response");
        } else if !resp.valid() {
            resp.error = String::from("malformed response");
        }
        return resp;
    }
}

// fetch is Client::new().get(url): a one-call GET that follows redirects.
pub fn fetch(url: str) -> Response {
    let c = Client::new();
    return c.get(url);
}

// request is the high-level one-call client entry point. It accepts the usual
// HTTP method and absolute URL; body and content_type default to empty values,
// so `request("GET", url)` is equivalent to fetch(url).
pub fn request(method: str, url: str, body: str = "", content_type: str = "") -> Response {
    let c = Client::new();
    return c.send(method, url, body, content_type);
}

// do is the one-call form for any method: `do("GET", url)` is fetch(url),
// `do("POST", url, body)` posts text. It returns a Response even on failure
// (status 0, error set).
pub fn do(method: str, url: str, body: str = "", content_type: str = "") -> Response {
    return request(method, url, body, content_type);
}

// These URL-shaped helpers avoid the older low-level get/post names below,
// whose host/port/path arguments are kept for backwards compatibility.
pub fn get_url(url: str) -> Response { fetch(url) }

pub fn post_url(url: str, body: str) -> Response {
    return request("POST", url, body, "text/plain; charset=utf-8");
}

pub fn post_json(url: str, body: str) -> Response {
    return request("POST", url, body, "application/json");
}

// post_form_url is the simple URL-encoded form counterpart to post_json.
pub fn post_form_url(url: str, form: str) -> Response {
    return request("POST", url, form, "application/x-www-form-urlencoded");
}

// get_status is handy when only a health/status code is needed.
pub fn get_status(url: str) -> i32 {
    let response = fetch(url);
    return response.status;
}

pub fn put_url(url: str, body: str) -> Response {
    return request("PUT", url, body, "text/plain; charset=utf-8");
}

pub fn delete_url(url: str) -> Response { request("DELETE", url) }

// download is the one-call counterpart to Client.download.
pub fn download(url: str, dest: str) -> Response {
    let c = Client::new();
    return c.download(url, dest);
}

// get performs a one-call GET and returns a Response (`fetch` with Go's name).
// It follows redirects; on a transport failure status is 0 and error is set.
pub fn get(url: str) -> Response {
    return fetch(url);
}

// post sends a text body to url and returns a Response.
pub fn post(url: str, body: str) -> Response {
    return request("POST", url, body, "text/plain; charset=utf-8");
}

// get_raw performs a low-level GET against host:port and returns the raw
// response text ("" on error). Kept for callers that build requests by hand.
pub fn get_raw(host: str, port: i32, path: str) -> String {
    return send_request("GET", host, port, path, "", "");
}

// post_raw performs a low-level POST and returns the raw response text.
pub fn post_raw(host: str, port: i32, path: str, body: str) -> String {
    return send_request("POST", host, port, path, body, "text/plain; charset=utf-8");
}

fn send_request(method: str, host: str, port: i32, path: str, body: str, content_type: str) -> String {
    let mut c = connect(host, port);
    if c.fd < 0 {
        return String::new();
    }
    c.set_timeout(DEFAULT_TIMEOUT_MS);

    let mut req = String::new();
    req.push_str(method);
    req.push_str(" ");
    if path.len() == 0 {
        req.push_str("/");
    } else {
        req.push_str(path);
    }
    req.push_str(" HTTP/1.1\r\nHost: ");
    req.push_str(host);
    if port != 80 {
        req.push_byte(58); // ':'
        push_int(&mut req, port as i64);
    }
    req.push_str("\r\nUser-Agent: zexi-http/0.2\r\nAccept: */*\r\nConnection: close\r\n");
    if len(body) > 0 {
        req.push_str("Content-Type: ");
        req.push_str(content_type);
        req.push_str("\r\nContent-Length: ");
        push_int(&mut req, len(body) as i64);
        req.push_str("\r\n");
    }
    req.push_str("\r\n");
    req.push_str(body);

    c.write(req);
    let raw = read_raw(&c);
    c.close();
    return raw;
}

// read_response is get_raw plus parsing, for low-level callers.
pub fn read_response(host: str, port: i32, path: str) -> Response {
    let raw = get_raw(host, port, path);
    return parse_response(&raw);
}

// parse_response splits a raw response into status, reason, headers and body.
pub fn parse_response(raw: &String) -> Response {
    let end = raw.find("\r\n");
    if end < 0 {
        return Response {
            status: 0, reason: String::new(), headers: String::new(), body: raw.clone(),
            content_type: String::new(), error: String::new(), keep_alive: false,
        };
    }
    let line = raw.substr(0, end as usize);
    let sp1 = line.find(" ");
    let rest = if sp1 < 0 { String::new() } else { line.substr((sp1 + 1) as usize, SUBSTR_ALL) };
    let sp2 = rest.find(" ");
    let code = if sp2 < 0 { rest.clone() } else { rest.substr(0, sp2 as usize) };
    let reason = if sp2 < 0 { String::new() } else { rest.substr((sp2 + 1) as usize, SUBSTR_ALL).trim() };

    let headers = header_block(raw);
    let ct = header_value(&headers, "Content-Type");
    let he = head_end(raw);
    let body = if he < 0 { String::new() } else { raw.substr(he as usize, SUBSTR_ALL) };
    return Response {
        status: parse_dec(&code) as i32, reason: reason, headers: headers, body: body,
        content_type: ct, error: String::new(), keep_alive: false,
    };
}

// read_raw reads one complete response: the head, then the body according to
// Content-Length, chunked transfer encoding, or connection close.
fn read_raw(c: &Conn) -> String {
    let head = c.read_head();
    let mut raw = head.clone();
    if raw.len() > 0 {
        let headers = header_block(&head);
        let te_value = header_value(&headers, "Transfer-Encoding");
        let te = http_lower(&te_value);
        if te.contains("chunked") {
            let body = read_chunked(c, MAX_BODY);
            raw.push_str(body);
        } else {
            let cl_value = header_value(&headers, "Content-Length");
            let cl = parse_dec(&cl_value);
            if cl < 0 {
                let body = c.read_all_max(MAX_BODY);
                raw.push_str(body);
            } else if cl > 0 {
                let take = if cl > MAX_BODY as i64 { MAX_BODY } else { cl as usize };
                let body = c.read_exact(take);
                raw.push_str(body);
            }
        }
    }
    return raw;
}

fn bad_response(msg: str) -> Response {
    let mut r = Response::empty(0);
    r.error = String::from(msg);
    return r;
}

fn is_redirect(status: i32) -> bool {
    return status == 301 || status == 302 || status == 303 || status == 307 || status == 308;
}

// resolve_location turns a Location header into an absolute URL.
fn resolve_location(base: &Url, loc: &String) -> String {
    if loc.starts_with("http://") {
        return loc.clone();
    }
    if loc.starts_with("//") {
        let mut out = String::from("http:");
        out.push_str(loc.as_str());
        return out;
    }
    if loc.starts_with("/") {
        let mut out = base.origin();
        out.push_str(loc.as_str());
        return out;
    }
    // Relative to the directory of the current path.
    let mut out = base.origin();
    let dir = dir_prefix(&base.path);
    out.push_str(dir.as_str());
    out.push_str(loc.as_str());
    return out;
}

// dir_prefix returns everything up to and including the last '/'.
fn dir_prefix(path: &String) -> String {
    let mut cut: usize = 0;
    let mut pos: usize = 0;
    while pos < path.len() {
        let rest = path.substr(pos, SUBSTR_ALL);
        let i = rest.find("/");
        if i < 0 {
            break;
        }
        cut = pos + (i as usize) + 1;
        pos = cut;
    }
    return path.substr(0, cut);
}

// --- routing ---------------------------------------------------------------

// MAX_ROUTES is how many handlers a Router can hold.
const MAX_ROUTES: i32 = 32;

// MAX_MOUNTS is how many folders one router can serve.
const MAX_MOUNTS: i32 = 4;

// MAX_MIDDLEWARE is the number of before/after hooks a Router can hold.
const MAX_MIDDLEWARE: i32 = 8;

// not_found_handler is the default fallback.
fn not_found_handler(req: &Request) -> Response {
    return Response::empty(404);
}

// pass_through is the neutral before-hook: an invalid response means "keep
// going". A middleware that returns a valid response short-circuits routing.
fn pass_through(req: &Request) -> Response {
    return Response::empty(0);
}

// noop_after is the neutral after-hook.
fn noop_after(req: &Request, res: &mut Response) {
}

// internal_error is what a `Result` handler's `Err(e)` becomes: 500, a generic
// body, and the real message in the server log. A failure inside a handler is
// the server's fault, so the response says nothing about whose fault else it
// could be and logs what happened instead.
fn internal_error(message: str) -> Response {
    let mut line = String::from("zexi: handler error: ");
    line.push_str(message);
    io::eprintln(line.as_str());
    let body = "<!doctype html><html><body><h1>500 Internal Server Error</h1><p>The server could not handle the request; see its log for the reason.</p></body></html>";
    return Response::html(500, body);
}

// route_result runs a `Result`-returning handler and folds its failure side
// into a response. Handlers keep the natural `Result<Response, String>` shape
// — and their `?`s — and the framework decides what `Err` looks like to the
// client.
fn route_result(handler: fn(&Request) -> Result<Response, String>, req: &Request) -> Response {
    match handler(req) {
        Ok(resp) => return resp,
        Err(e) => return internal_error(e.as_str()),
    }
}

// The default mux is a process-global Router for the top-level handlers:
//
//     handle_get("/users/{id}", user);
//     listen(":8080");
//
// The storage lives in the networking C shim (which http already links), since
// the language has no mutable globals yet; it is initialized once, on first
// use, from Zexi.
extern "C" fn zxh_default_mux() -> *Router;
extern "C" fn zxh_default_mux_ready() -> i32;

fn default_router() -> *Router {
    let p = zxh_default_mux();
    if zxh_default_mux_ready() == 1 {
        *p = Router::new();
    }
    return p;
}

// Router maps (method, path) pairs to handlers. Register routes once,
// then call dispatch(req) or serve(conn). Paths are `str` values, so pass
// literals; `{name}` segments are captured and can be read with
// `req.param("name")` or `req.route_param("name")`.
pub struct Router {
    methods: [str; 32],
    paths: [str; 32],
    handlers: [fn(&Request) -> Response; 32],
    fallback: fn(&Request) -> Response,
    before: [fn(&Request) -> Response; 8],
    after: [fn(&Request, &mut Response); 8],
    before_count: i32,
    after_count: i32,
    count: i32,
    // Mounted folders for unmatched paths (`files`/`pages`), in registration
    // order; `views` names the template folder `web` renders from.
    mounts: [str; MAX_MOUNTS],
    roots: [str; MAX_MOUNTS],
    mount_count: i32,
    views: str,
    // header_timeout_ms bounds how long a peer may take to send a head.
    header_timeout_ms: i32,
}

impl Router {
    pub fn new() -> Router {
        return Router {
            methods: [""; 32],
            paths: [""; 32],
            handlers: [not_found_handler; 32],
            fallback: not_found_handler,
            before: [pass_through; 8],
            after: [noop_after; 8],
            before_count: 0,
            after_count: 0,
            count: 0,
            mounts: [""; MAX_MOUNTS],
            roots: [""; MAX_MOUNTS],
            mount_count: 0,
            views: "",
            header_timeout_ms: HEAD_TIMEOUT_MS,
        };
    }

    pub fn get(&mut self, path: str, handler: fn(&Request) -> Response) {
        self.add("GET", path, handler);
    }

    pub fn post(&mut self, path: str, handler: fn(&Request) -> Response) {
        self.add("POST", path, handler);
    }

    pub fn put(&mut self, path: str, handler: fn(&Request) -> Response) {
        self.add("PUT", path, handler);
    }

    pub fn delete(&mut self, path: str, handler: fn(&Request) -> Response) {
        self.add("DELETE", path, handler);
    }

    // header_timeout sets how long a connection may take to send a complete
    // request head, in milliseconds. It is the knob that bounds how long a slow
    // or silent peer can hold a worker.
    pub fn header_timeout(&mut self, ms: i32) {
        if ms > 0 {
            self.header_timeout_ms = ms;
        }
    }

    // files serves a folder for URLs under `prefix`, with index.html for
    // directory URLs and a ".html" fallback for extension-less ones:
    //
    //     app.files("/assets", "public/assets");
    pub fn files(&mut self, prefix: str, root: str) {
        if self.mount_count >= MAX_MOUNTS {
            return;
        }
        let i = self.mount_count as usize;
        self.mounts[i] = prefix;
        self.roots[i] = root;
        self.mount_count = self.mount_count + 1;
    }

    // pages serves a folder as the whole site (`prefix` is "/").
    pub fn pages(&mut self, root: str) {
        self.files("/", root);
    }

    // views names the template folder that `web::template` reads from.
    pub fn views(&mut self, dir: str) {
        self.views = dir;
    }

    // set_fallback replaces the 404 handler.
    pub fn set_fallback(&mut self, handler: fn(&Request) -> Response) {
        self.fallback = handler;
    }

    // use_before registers a middleware that runs before routing. It may
    // return a valid response to short-circuit the request (auth, rate limits,
    // redirects); returning Response::empty(0) means "continue".
    pub fn use_before(&mut self, mw: fn(&Request) -> Response) {
        if self.before_count >= MAX_MIDDLEWARE {
            return;
        }
        self.before[self.before_count as usize] = mw;
        self.before_count = self.before_count + 1;
    }

    // use_after registers a middleware that runs after the handler and may
    // add headers (CORS, server timing, cookies) to the response.
    pub fn use_after(&mut self, mw: fn(&Request, &mut Response)) {
        if self.after_count >= MAX_MIDDLEWARE {
            return;
        }
        self.after[self.after_count as usize] = mw;
        self.after_count = self.after_count + 1;
    }

    // listen serves on an address string: ":8080", "8080", "127.0.0.1:8080",
    // or "http://127.0.0.1:8080". It runs until the process stops; a non-zero
    // return means the address was invalid or the listener could not open.
    pub fn listen(&self, addr: str = "0.0.0.0:8000") -> i32 {
        let a = parse_addr(addr);
        if !a.ok {
            return 2;
        }
        return serve(self, a.port, a.host.as_str());
    }

    // listen_and_serve is the Go-flavoured name for listen.
    pub fn listen_and_serve(&self, addr: str = "0.0.0.0:8000") -> i32 {
        return self.listen(addr);
    }

    // listen_n serves at most max_requests requests (useful for tests and
    // one-shot tools) on an address string.
    pub fn listen_n(&self, addr: str, max_requests: i32) -> i32 {
        let a = parse_addr(addr);
        if !a.ok {
            return 2;
        }
        return serve_n(self, max_requests, a.port, a.host.as_str());
    }

    // listen_workers serves this router with a thread pool, so several users
    // are handled at once instead of one after another.
    pub fn listen_workers(&self, addr: str = "0.0.0.0:8000", workers: i32 = 0) -> i32 {
        let a = parse_addr(addr);
        if !a.ok {
            return 2;
        }
        return serve_workers(self, workers, a.port, a.host.as_str());
    }

    // listen_workers_n is listen_workers with a pool-wide request budget.
    pub fn listen_workers_n(&self, addr: str, workers: i32, max_requests: i32) -> i32 {
        let a = parse_addr(addr);
        if !a.ok {
            return 2;
        }
        return serve_workers_n(self, workers, max_requests, a.port, a.host.as_str());
    }

    pub fn add(&mut self, method: str, path: str, handler: fn(&Request) -> Response) {
        if self.count >= MAX_ROUTES {
            return;
        }
        let i = self.count as usize;
        self.methods[i] = method;
        self.paths[i] = path;
        self.handlers[i] = handler;
        self.count = self.count + 1;
    }

    // get_result/controller_result register a handler that returns
    // `Result<Response, String>`. The framework wraps it once at registration,
    // so dispatch stays the plain handler shape: an `Ok` is served as-is, an
    // `Err` becomes a logged 500. Inside the handler, `?` propagates a lookup
    // failure to exactly this turn.
    pub fn get_result(&mut self, path: str, handler: fn(&Request) -> Result<Response, String>) {
        self.add("GET", path, |req| route_result(handler, req));
    }

    pub fn post_result(&mut self, path: str, handler: fn(&Request) -> Result<Response, String>) {
        self.add("POST", path, |req| route_result(handler, req));
    }

    pub fn put_result(&mut self, path: str, handler: fn(&Request) -> Result<Response, String>) {
        self.add("PUT", path, |req| route_result(handler, req));
    }

    pub fn delete_result(&mut self, path: str, handler: fn(&Request) -> Result<Response, String>) {
        self.add("DELETE", path, |req| route_result(handler, req));
    }

    // add_result registers any method ("PATCH", "OPTIONS", ...) with a
    // Result-returning handler.
    pub fn add_result(&mut self, method: str, path: str, handler: fn(&Request) -> Result<Response, String>) {
        self.add(method, path, |req| route_result(handler, req));
    }

    // dispatch routes one parsed request through the before hooks, the
    // matching handler (or fallback), and the after hooks. Captured `{name}`
    // values are stored on the request for `param`/`route_param`.
    pub fn dispatch(&self, req: &mut Request) -> Response {
        if !req.valid() {
            return Response::empty(400);
        }
        let path = req.path_only();
        req.params = String::new();

        let mut b: usize = 0;
        while b < (self.before_count as usize) {
            let mw = self.before[b];
            let early = mw(req);
            if early.valid() {
                return early;
            }
            b += 1;
        }

        let mut res = Response::empty(404);
        let mut matched = false;
        let mut i: usize = 0;
        while i < (self.count as usize) {
            if self.methods[i] == req.method.as_str() {
                let mut captured = String::new();
                if route_match(self.paths[i], &path, &mut captured) {
                    req.params = captured;
                    let handler = self.handlers[i];
                    res = handler(req);
                    matched = true;
                    break;
                }
            }
            i += 1;
        }
        if !matched {
            // The longest matching prefix wins, so `/static` beats a `/` mount
            // no matter which was registered first.
            let mut best: i64 = -1;
            let mut best_len: usize = 0;
            let mut m: usize = 0;
            while m < (self.mount_count as usize) {
                let prefix = self.mounts[m];
                if path.starts_with(prefix) && (best < 0 || prefix.len() > best_len) {
                    best = m as i64;
                    best_len = prefix.len();
                }
                m += 1;
            }
            if best >= 0 {
                let rest = path.substr(best_len, SUBSTR_ALL);
                res = serve_page(self.roots[best as usize], rest.as_str());
                matched = true;
            }
        }
        if !matched {
            let fallback = self.fallback;
            res = fallback(req);
        }

        let mut a: usize = 0;
        while a < (self.after_count as usize) {
            let mw = self.after[a];
            mw(req, &mut res);
            a += 1;
        }
        return res;
    }

    // serve reads one request from c, dispatches it, and writes the response.
    // It returns false when the peer sent nothing usable (a probe or EOF).
    pub fn serve(&self, c: &Conn) -> bool {
        if !c.wait_readable(FIRST_BYTE_MS) {
            return false;
        }
        c.set_timeout(self.header_timeout_ms);
        let mut req = read_request(c);
        if req.head_overflow {
            let too_big = Response::empty(431);
            send_response(c, &too_big);
            c.drain(DRAIN_MS);
            return true;
        }
        if !req.valid() {
            // Nothing arrived: a readiness probe or an immediate EOF, so there
            // is nobody to answer. A peer that did send bytes gets a 400.
            if req.head_bytes == 0 {
                return false;
            }
            let bad = Response::empty(400);
            send_response(c, &bad);
            c.drain(DRAIN_MS);
            return true;
        }
        if req.body_too_large() {
            let too_large = Response::empty(413);
            send_response(c, &too_large);
            return true;
        }
        if !req.body_complete() {
            let bad = Response::empty(400);
            send_response(c, &bad);
            return true;
        }
        let res = self.dispatch(&mut req);
        send_response(c, &res);
        if req.chunked() {
            // A malformed chunked body can leave bytes in the socket; draining
            // makes close() send FIN, so the status line survives.
            c.drain(DRAIN_MS);
        }
        return true;
    }
}

// new_app is the short constructor for a Router: `let mut app = new_app();`.
pub fn new_app() -> Router {
    return Router::new();
}

// handle registers a method/path pair on the process-wide default mux. The
// matching `Router` is also available explicitly through new_app().
pub fn handle(method: str, path: str, handler: fn(&Request) -> Response) {
    let mux = default_router();
    mux.add(method, path, handler);
}

// handle_get/handle_post/handle_put/handle_delete are Go-style conveniences
// that register on the default mux.
pub fn handle_get(path: str, handler: fn(&Request) -> Response) {
    let mux = default_router();
    mux.get(path, handler);
}

pub fn handle_post(path: str, handler: fn(&Request) -> Response) {
    let mux = default_router();
    mux.post(path, handler);
}

pub fn handle_put(path: str, handler: fn(&Request) -> Response) {
    let mux = default_router();
    mux.put(path, handler);
}

pub fn handle_delete(path: str, handler: fn(&Request) -> Response) {
    let mux = default_router();
    mux.delete(path, handler);
}

// handle_get_result/post_result/... register a Result-returning handler on the
// default mux: `Err` becomes a logged 500 without a match at every step.
pub fn handle_get_result(path: str, handler: fn(&Request) -> Result<Response, String>) {
    let mux = default_router();
    mux.get_result(path, handler);
}

pub fn handle_post_result(path: str, handler: fn(&Request) -> Result<Response, String>) {
    let mux = default_router();
    mux.post_result(path, handler);
}

pub fn handle_put_result(path: str, handler: fn(&Request) -> Result<Response, String>) {
    let mux = default_router();
    mux.put_result(path, handler);
}

pub fn handle_delete_result(path: str, handler: fn(&Request) -> Result<Response, String>) {
    let mux = default_router();
    mux.delete_result(path, handler);
}

// use_before/use_after attach middleware to the default mux, mirroring the
// Router methods of the same name.
pub fn use_before(mw: fn(&Request) -> Response) {
    let mux = default_router();
    mux.use_before(mw);
}

pub fn use_after(mw: fn(&Request, &mut Response)) {
    let mux = default_router();
    mux.use_after(mw);
}

// listen serves the default mux on an address string: ":8080", "8080",
// "127.0.0.1:8080", or "http://127.0.0.1:8080". It runs until the process
// stops; a non-zero return means the address was invalid or bind failed.
pub fn listen(addr: str = "0.0.0.0:8000") -> i32 {
    let mux = default_router();
    return mux.listen(addr);
}

// listen_and_serve is the Go-flavoured alias for listen.
pub fn listen_and_serve(addr: str = "0.0.0.0:8000") -> i32 {
    return listen(addr);
}

// listen_n is listen with a request budget, useful for tests and one-shot
// services.
pub fn listen_n(addr: str, max_requests: i32) -> i32 {
    let mux = default_router();
    return mux.listen_n(addr, max_requests);
}

// accept_retryable reports whether the listener's last accept failure was
// transient. A persistent failure (such as running out of file descriptors)
// must stop the server instead of spinning on a hot loop.
fn accept_retryable() -> bool {
    return zxn_accept_retryable() == 1;
}

// serve is the high-level server entry point: register handlers on a Router,
// then call `serve(&router, 8000)`. It listens on all IPv4 interfaces by
// default and runs until the process is stopped. A non-zero return means the
// listener could not be opened.
pub fn serve(router: &Router, port: i32 = 8000, host: str = "0.0.0.0") -> i32 {
    let mut listener = listen_tcp(host, port);
    if !listener.ok() {
        return 1;
    }
    loop {
        let mut conn = listener.accept();
        if !conn.ok() {
            if accept_retryable() {
                continue;
            }
            listener.close();
            return 1;
        }
        router.serve(&conn);
        conn.close();
    }
}

// serve_local is the safer local-development form of serve: it listens only on
// 127.0.0.1 instead of every IPv4 interface.
pub fn serve_local(router: &Router, port: i32 = 8000) -> i32 {
    return serve(router, port, "127.0.0.1");
}

// serve_n is serve with a request budget, useful for tests, command-line tools,
// and graceful single-purpose services. Empty TCP probes do not count because
// Router.serve returns false for them.
pub fn serve_n(router: &Router, max_requests: i32, port: i32 = 8000, host: str = "0.0.0.0") -> i32 {
    let mut listener = listen_tcp(host, port);
    if !listener.ok() {
        return 1;
    }
    let mut served: i32 = 0;
    while served < max_requests {
        let mut conn = listener.accept();
        if !conn.ok() {
            if accept_retryable() {
                continue;
            }
            listener.close();
            return 1;
        }
        if router.serve(&conn) {
            served += 1;
        }
        conn.close();
    }
    listener.close();
    return 0;
}

// serve_local_n is serve_n constrained to loopback for deterministic local
// tools and tests.
pub fn serve_local_n(router: &Router, max_requests: i32, port: i32 = 8000) -> i32 {
    return serve_n(router, max_requests, port, "127.0.0.1");
}

// --- serving many users at once --------------------------------------------

// A worker pool is how one process serves many users: the single-threaded
// `listen` accepts, serves, and closes one connection before looking at the
// next, so a slow request stalls everyone behind it. Here N OS threads accept
// on one shared listener (the kernel hands each connection to whichever thread
// is idle), dispatch it, and go back for more. Handlers stay ordinary
// functions; each thread has its own stack and its own request/response
// values.

// The worker-side state — the pinned-router slots, the pool-wide counters, and
// the cooperative stop flag — lives in the networking C shim as C11 atomics.
// Worker threads receive integers only (the language has no closures yet), so
// a Router travels into a thread as a slot number.
extern "C" fn zxh_mux_slot(slot: i32) -> *Router;
extern "C" fn zxh_mux_claim() -> i32;
extern "C" fn zxh_mux_release(slot: i32);
extern "C" fn zxh_count_conn();
extern "C" fn zxh_count_request();
extern "C" fn zxh_stats_reset();
extern "C" fn zxh_conns_served() -> i64;
extern "C" fn zxh_requests_served() -> i64;
extern "C" fn zxh_set_budget(n: i64);
extern "C" fn zxh_budget() -> i64;
extern "C" fn zxh_stop();
extern "C" fn zxh_clear_stop();
extern "C" fn zxh_stopping() -> i32;

// WORKER_POLL_MS bounds how long a worker waits on an idle listener before it
// re-checks the stop flag, so a pool shuts down promptly instead of hanging on
// a blocking accept.
const WORKER_POLL_MS: i32 = 100;

// MAX_WORKERS caps a pool: past a few hundred threads the kernel, not the CPU,
// becomes the bottleneck, and each worker needs its own stack.
const MAX_WORKERS: i32 = 64;

// DEFAULT_WORKERS is the pool size when a program does not choose one (and the
// processor count cannot be read).
const DEFAULT_WORKERS: i32 = 8;

// pin_router copies a router into a fixed slot so worker threads can reach it
// through an integer handle. The copy is field by field because the language
// has no raw-pointer reinterpret of a borrowed value — adding a field here is
// easy to forget, and forgetting one (the header timeout, once) leaves the
// worker with a zeroed setting.
fn pin_router(src: &Router, dst: *Router) {
    let mut i: usize = 0;
    while i < 32 {
        let method = src.methods[i];
        (*dst).methods[i] = method;
        let path = src.paths[i];
        (*dst).paths[i] = path;
        let handler = src.handlers[i];
        (*dst).handlers[i] = handler;
        i += 1;
    }
    let mut b: usize = 0;
    while b < 8 {
        let before = src.before[b];
        (*dst).before[b] = before;
        let after = src.after[b];
        (*dst).after[b] = after;
        b += 1;
    }
    let mut m: usize = 0;
    while m < (MAX_MOUNTS as usize) {
        let prefix = src.mounts[m];
        (*dst).mounts[m] = prefix;
        let root = src.roots[m];
        (*dst).roots[m] = root;
        m += 1;
    }
    (*dst).mount_count = src.mount_count;
    (*dst).views = src.views;
    (*dst).fallback = src.fallback;
    (*dst).before_count = src.before_count;
    (*dst).after_count = src.after_count;
    (*dst).count = src.count;
    (*dst).header_timeout_ms = src.header_timeout_ms;
}

// drain is the worker loop: accept bounded so the stop flag is noticed, serve
// one request per connection, count it, and repeat. It returns how many
// requests this worker served.
fn drain(mux: *Router, listener_fd: i64) -> i64 {
    let mut server = Server::from_fd(listener_fd as i32);
    let mut served: i64 = 0;
    loop {
        if zxh_stopping() == 1 {
            break;
        }
        let mut conn = server.accept_timeout(WORKER_POLL_MS);
        if !conn.is_open() {
            continue;
        }
        zxh_count_conn();
        if mux.serve(&conn) {
            zxh_count_request();
            served += 1;
            let budget = zxh_budget();
            if budget > 0 && zxh_requests_served() >= budget {
                zxh_stop();
            }
        }
        conn.close();
    }
    return served;
}

// worker_slot serves a router that was pinned into a slot.
fn worker_slot(listener_fd: i64, slot: i64) -> i64 {
    return drain(zxh_mux_slot(slot as i32), listener_fd);
}

// worker_default serves the process-wide default mux, which lives in a fixed
// slot already, so nothing needs pinning.
fn worker_default(listener_fd: i64, slot: i64) -> i64 {
    return drain(default_router(), listener_fd);
}

// run_pool starts `workers` threads on one listener and joins them. A
// max_requests of 0 means "serve until stopped".
fn run_pool(fd: i64, workers: i32, max_requests: i64, entry: fn(i64, i64) -> i64, slot: i32) -> i32 {
    let mut n = workers;
    if n <= 0 {
        // Two threads per core covers the common case where a handler waits on
        // I/O; a CPU-bound handler still runs close to one core per thread.
        n = net::cpu_count() * 2;
        if n < 2 {
            n = DEFAULT_WORKERS;
        }
    }
    if n > MAX_WORKERS {
        n = MAX_WORKERS;
    }
    zxh_set_budget(max_requests);
    let mut handles: [i64; 64] = [0; 64];
    let mut started: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        let h = thread::spawn2(entry, fd, slot as i64);
        if h == 0 {
            break;
        }
        handles[i as usize] = h;
        started += 1;
        i += 1;
    }
    if started == 0 {
        // The thread table is full or pthread_create failed: serve inline so
        // the program still makes progress.
        let mux = zxh_mux_slot(slot);
        drain_until_budget(mux, fd, max_requests);
        zxh_set_budget(0);
        zxh_clear_stop();
        return 0;
    }
    let mut j: i32 = 0;
    while j < started {
        thread::join(handles[j as usize]);
        j += 1;
    }
    zxh_set_budget(0);
    zxh_clear_stop();
    return 0;
}

// drain_until_budget is the no-thread fallback: serve on this thread, honouring
// the request budget, so a pool that cannot start still answers.
fn drain_until_budget(mux: *Router, listener_fd: i64, max_requests: i64) {
    let mut server = Server::from_fd(listener_fd as i32);
    let mut served: i64 = 0;
    while max_requests == 0 || served < max_requests {
        let mut conn = server.accept_timeout(WORKER_POLL_MS);
        if !conn.is_open() {
            if zxh_stopping() == 1 {
                break;
            }
            continue;
        }
        zxh_count_conn();
        if mux.serve(&conn) {
            zxh_count_request();
            served += 1;
        }
        conn.close();
    }
}

// serve_workers serves an explicit Router with a thread pool. `workers` 0
// picks DEFAULT_WORKERS; the pool runs until the process stops or
// `stop_serving()` is called. A non-zero return means the address could not be
// bound.
pub fn serve_workers(router: &Router, workers: i32 = 0, port: i32 = 8000, host: str = "0.0.0.0") -> i32 {
    return serve_workers_n(router, workers, 0, port, host);
}

// serve_workers_n is serve_workers with a total request budget across the
// whole pool: after max_requests (0 = unlimited) the workers stop and the call
// returns. Tests and one-shot tools use it for a deterministic exit.
pub fn serve_workers_n(router: &Router, workers: i32, max_requests: i32, port: i32 = 8000, host: str = "0.0.0.0") -> i32 {
    let mut listener = listen_tcp(host, port);
    if !listener.ok() {
        return 1;
    }
    // A pooled server polls the listener from several threads. Without a
    // non-blocking listener two workers can wake for one connection, the first
    // accepts it, and the second blocks in accept() forever, so a bounded
    // pool never shuts down. The accepted sockets stay blocking.
    listener.set_nonblocking(true);
    let slot = zxh_mux_claim();
    if slot < 0 {
        // Every slot is in use: fall back to serving on this thread rather
        // than failing a server that is already running.
        zxh_stats_reset();
        drain_until_budget(default_router(), listener.fd() as i64, max_requests as i64);
        listener.close();
        return 0;
    }
    pin_router(router, zxh_mux_slot(slot));
    zxh_stats_reset();
    let rc = run_pool(listener.fd() as i64, workers, max_requests as i64, worker_slot, slot);
    listener.close();
    zxh_mux_release(slot);
    return rc;
}

// serve_local_workers is serve_workers bound to loopback, the safe choice for
// development servers.
pub fn serve_local_workers(router: &Router, workers: i32 = 0, port: i32 = 8000) -> i32 {
    return serve_workers(router, workers, port, "127.0.0.1");
}

// serve_local_workers_n is serve_workers_n bound to loopback.
pub fn serve_local_workers_n(router: &Router, workers: i32, max_requests: i32, port: i32 = 8000) -> i32 {
    return serve_workers_n(router, workers, max_requests, port, "127.0.0.1");
}

// files serves a folder for URLs under `prefix` on the default mux.
pub fn files(prefix: str, root: str) {
    let mux = default_router();
    mux.files(prefix, root);
}

// pages serves a folder as the whole site on the default mux.
pub fn pages(root: str) {
    let mux = default_router();
    mux.pages(root);
}

// views_dir names the template folder `web::template` reads from.
pub fn views_dir(dir: str) {
    let mux = default_router();
    mux.views(dir);
}

// views_path is the configured template folder ("templates" by default).
pub fn views_path() -> String {
    let mux = default_router();
    if mux.views.len() == 0 {
        return project_path("templates");
    }
    return project_path(mux.views);
}

// serve_page serves one file from a folder, trying the exact path, then
// "<path>.html", then "<path>/index.html" — so /about can be about.html.
pub fn serve_page(root: str, url_path: str) -> Response {
    let mut result = serve_static(root, url_path);
    if result.status == 404 {
        let raw = String::from(url_path);
        let q = raw.find("?");
        let bare = if q < 0 { raw.clone() } else { raw.substr(0, q as usize) };
        if bare.len() > 0 && !bare.ends_with("/") {
            let mut html_path = bare.clone();
            html_path.push_str(".html");
            result = serve_static(root, html_path.as_str());
            if result.status == 404 {
                let mut index_path = bare.clone();
                index_path.push_byte(47);
                index_path.push_str("index.html");
                result = serve_static(root, index_path.as_str());
            }
        }
    }
    return result;
}

// collect_query_into decodes `a=1&b=2` into `out` (first value wins).
pub fn collect_query_into(raw: &String, out: &mut HashMap<String, String>) {
    let mut pos: usize = 0;
    while pos <= raw.len() {
        let rest = raw.substr(pos, SUBSTR_ALL);
        let amp = rest.find("&");
        let piece = if amp < 0 { rest.clone() } else { rest.substr(0, amp as usize) };
        if piece.len() > 0 {
            let eq = piece.find("=");
            if eq >= 0 {
                let key = url_decode(piece.substr(0, eq as usize).as_str());
                let value = url_decode(piece.substr((eq + 1) as usize, SUBSTR_ALL).as_str());
                if !out.contains_key(key.clone()) {
                    out.insert(key, value);
                }
            }
        }
        if amp < 0 {
            break;
        }
        pos = pos + (amp as usize) + 1;
    }
}

// last_slash is the index of the final "/" in s, or -1.
fn last_slash(s: &String) -> i64 {
    let mut i: usize = 0;
    let mut found: i64 = -1;
    while i < s.len() {
        if s.byte_at(i) == 47 {
            found = i as i64;
        }
        i += 1;
    }
    return found;
}

// listen_workers serves the process-wide default mux with a worker pool, so a
// Go-style program scales to many users by changing one call:
//
//     handle_get("/", home);
//     listen_workers(":8080", 8)
pub fn listen_workers(addr: str = "0.0.0.0:8000", workers: i32 = 0) -> i32 {
    let a = parse_addr(addr);
    if !a.ok {
        return 2;
    }
    let mux = default_router();
    let mut listener = listen_tcp(a.host.as_str(), a.port);
    if !listener.ok() {
        return 1;
    }
    zxh_stats_reset();
    let rc = run_pool(listener.fd() as i64, workers, 0, worker_default, 0);
    listener.close();
    return rc;
}

// listen_workers_n is listen_workers with a request budget (0 = unlimited).
pub fn listen_workers_n(addr: str, workers: i32, max_requests: i32) -> i32 {
    let a = parse_addr(addr);
    if !a.ok {
        return 2;
    }
    let mut listener = listen_tcp(a.host.as_str(), a.port);
    if !listener.ok() {
        return 1;
    }
    zxh_stats_reset();
    let rc = run_pool(listener.fd() as i64, workers, max_requests as i64, worker_default, 0);
    listener.close();
    return rc;
}

// requests_served is how many requests the pool has answered in total; every
// worker counts into the same cell.
pub fn requests_served() -> i64 {
    return zxh_requests_served();
}

// connections_served is how many connections the pool has accepted.
pub fn connections_served() -> i64 {
    return zxh_conns_served();
}

// stop_serving asks every worker to wind down after its current request. The
// pool's `serve_workers` call returns once they all have.
pub fn stop_serving() {
    zxh_stop();
}

// serving_stopped reports whether stop_serving has been called.
pub fn serving_stopped() -> bool {
    return zxh_stopping() == 1;
}

// reset_stats clears the pool-wide counters (and the stop flag).
pub fn reset_stats() {
    zxh_stats_reset();
}

// path_matches supports exact routes and a trailing "/*" prefix; the bare
// pattern "*" matches everything.
fn path_matches(pattern: str, path: &String) -> bool {
    let p = String::from(pattern);
    if p.as_str() == "*" {
        return true;
    }
    if p.ends_with("/*") {
        let prefix = p.substr(0, p.len() - 1);
        return path.starts_with(prefix.as_str());
    }
    return path.as_str() == p.as_str();
}

// take_segment returns the next "/"-separated segment of s and advances pos
// past it. An empty segment (for example between "//") is returned as "".
fn take_segment(s: &String, pos: &mut usize) -> String {
    if *pos >= s.len() {
        return String::new();
    }
    if s.substr(*pos, 1).as_str() == "/" {
        *pos = *pos + 1;
    }
    if *pos >= s.len() {
        return String::new();
    }
    let rest = s.substr(*pos, SUBSTR_ALL);
    let slash = rest.find("/");
    if slash < 0 {
        *pos = s.len();
        return rest.clone();
    }
    let seg = rest.substr(0, slash as usize);
    *pos = *pos + (slash as usize) + 1;
    return seg;
}

// route_match matches a route pattern against a request path, filling out with
// `\x1fname\x1fvalue` pairs for every `{name}` segment. Patterns without braces
// keep the exact / trailing-`/*` / `*` behaviour of path_matches. A `*` segment
// after named segments matches the remaining path.
fn route_match(pattern: str, path: &String, out: &mut String) -> bool {
    let p = String::from(pattern).trim();
    if p.find("{") < 0 {
        return path_matches(p.as_str(), path);
    }
    let mut pat = p;
    let mut actual = path.clone();
    if pat.len() > 1 && pat.ends_with("/") {
        pat = pat.substr(0, pat.len() - 1);
    }
    if actual.len() > 1 && actual.ends_with("/") {
        actual = actual.substr(0, actual.len() - 1);
    }
    let mut pi: usize = 0;
    let mut si: usize = 0;
    loop {
        let pdone = pi >= pat.len();
        let sdone = si >= actual.len();
        if pdone && sdone {
            return true;
        }
        if pdone || sdone {
            return false;
        }
        let ps = take_segment(&pat, &mut pi);
        let ss = take_segment(&actual, &mut si);
        if ps.len() >= 2 && ps.starts_with("{") && ps.ends_with("}") {
            if ss.len() == 0 {
                return false;
            }
            let inner = ps.substr(1, ps.len() - 2);
            out.push_str("\x1f");
            out.push_str(inner.as_str());
            out.push_str("\x1f");
            out.push_str(ss.as_str());
        } else if ps.as_str() == "*" {
            return true;
        } else if ps.as_str() != ss.as_str() {
            return false;
        }
    }
}

// Addr is a parsed listen address. ok is false when the text was not a valid
// port (1..65535) or used https.
pub struct Addr {
    pub host: String,
    pub port: i32,
    pub ok: bool,
}

// last_colon returns the index of the final ':' in s, or -1.
fn last_colon(s: &String) -> i64 {
    let mut pos: usize = 0;
    let mut last: i64 = -1;
    while pos < s.len() {
        let rest = s.substr(pos, SUBSTR_ALL);
        let idx = rest.find(":");
        if idx < 0 {
            break;
        }
        last = (pos + (idx as usize)) as i64;
        pos = pos + (idx as usize) + 1;
    }
    return last;
}

// parse_addr accepts the forms ":8080", "8080", "127.0.0.1:8080",
// "localhost:8080", and "http://host:8080/path". A bare port or an empty host
// listens on all IPv4 interfaces; "localhost" is mapped to 127.0.0.1. The
// stack is plaintext HTTP, so an https URL is rejected.
pub fn parse_addr(raw: str) -> Addr {
    let trimmed = String::from(raw).trim();
    if trimmed.starts_with("https://") {
        return Addr { host: String::new(), port: 0, ok: false };
    }
    let mut rest = trimmed;
    if rest.starts_with("http://") {
        let after_scheme = rest.substr(7, SUBSTR_ALL);
        rest = after_scheme;
    }
    let slash = rest.find("/");
    if slash >= 0 {
        let authority = rest.substr(0, slash as usize);
        rest = authority;
    }
    let mut host = String::from("0.0.0.0");
    let mut port_s = rest.clone();
    let colon = last_colon(&rest);
    if colon >= 0 {
        let h = rest.substr(0, colon as usize);
        if h.len() > 0 {
            host = h;
        }
        port_s = rest.substr((colon + 1) as usize, SUBSTR_ALL);
    }
    let p = parse_dec(&port_s);
    let mut ok = true;
    let mut port: i32 = 0;
    if p <= 0 || p > 65535 {
        ok = false;
    } else {
        port = p as i32;
    }
    if host.as_str() == "localhost" {
        host = String::from("127.0.0.1");
    }
    return Addr { host: host, port: port, ok: ok };
}

// --- files and static serving ----------------------------------------------

// read_file reads a whole file as bytes (binary-safe, capped at MAX_FILE).
// A missing file yields "".
pub fn read_file(path: str) -> String {
    let mut out = String::new();
    let handle = zxn_file_open(path);
    if handle >= 0 {
        let mut buf: [u8; 8192] = [0; 8192];
        loop {
            let n = zxn_file_read(handle, &mut buf, 8192);
            if n <= 0 {
                break;
            }
            out.push_bytes(buf[0..n as usize]);
            if out.len() >= MAX_FILE {
                break;
            }
        }
        zxn_file_close(handle);
    }
    return out;
}

// write_file writes text to a file. For binary data (including embedded NUL
// bytes), use write_file_bytes with an owning String below.
pub fn write_file(path: str, data: str) -> i32 {
    let n = len(data);
    if n > 2147483647 {
        return -1;
    }
    return zxn_write_file(path, data, n as i32);
}

// write_file_bytes writes every byte of an owning String, including NULs.
pub fn write_file_bytes(path: str, data: &String) -> i32 {
    let n = data.len();
    if n > 2147483647 {
        return -1;
    }
    return zxn_write_file(path, data.as_str(), n as i32);
}

// file_size returns the size of a regular file, or -1 when absent.
pub fn file_size(path: str) -> i64 {
    return zxn_file_size(path);
}

// serve_file builds a response from a filesystem path. Missing files get a
// 404 and oversized files a 413; the content type follows the extension.
// The body is copied byte-for-byte, so images and other binary files work.
pub fn serve_file(path: str) -> Response {
    let size = zxn_file_size(path);
    if size < 0 {
        return Response::empty(404);
    }
    if size > MAX_FILE as i64 {
        return Response::empty(413);
    }
    let body = read_file(path);
    let mut r = Response::from_string(200, body);
    let p = String::from(path);
    let ct = content_type_for(&p);
    r.content_type = String::from(ct);
    return r;
}

// project_path resolves a folder or file named relative to the program's
// entry directory (the value of `project_dir()`), so `pages("public")` means
// the same folder no matter which directory the binary is started from. An
// absolute path, or a build with no project directory, is returned unchanged.
pub fn project_path(path: str) -> String {
    let p = String::from(path);
    let absolute = p.starts_with("/");
    let base = project_dir();
    if absolute || p.len() == 0 || base.len() == 0 {
        return String::from(path);
    }
    let mut out = base.clone();
    if !out.ends_with("/") {
        out.push_byte(47);
    }
    out.push_str(p.as_str());
    return out;
}

// serve_static maps a URL path onto a directory. "/" serves index.html;
// traversal ("..", backslashes, NUL) is refused with 403. A relative `root` is
// resolved against the program's entry directory.
pub fn serve_static(root: str, url_path: str) -> Response {
    let root_s = project_path(root);
    let raw = String::from(url_path);
    let q = raw.find("?");
    let p0 = if q < 0 { raw.clone() } else { raw.substr(0, q as usize) };
    let path = url_decode(p0.as_str());
    if path.contains("..") || path.contains("\\") || has_byte(&path, 0) {
        return Response::empty(403);
    }
    let rel = if path.len() == 0 || path.as_str() == "/" {
        String::from("index.html")
    } else if path.starts_with("/") {
        path.substr(1, SUBSTR_ALL)
    } else {
        path.clone()
    };
    let mut full = root_s.clone();
    if !root_s.ends_with("/") {
        full.push_byte(47); // '/'
    }
    full.push_str(rel.as_str());

    // Resolve symlinks before opening, so a link inside the tree cannot expose
    // a file outside the served root. A path that cannot be resolved is a
    // missing file (404); a resolved path outside root is refused (403).
    let real_root = resolve_real_path(root_s.as_str());
    if real_root.len() == 0 {
        return Response::empty(404);
    }
    let real_full = resolve_real_path(full.as_str());
    if real_full.len() == 0 {
        return Response::empty(404);
    }
    if !path_within_root(&real_root, &real_full) {
        return Response::empty(403);
    }
    return serve_file(real_full.as_str());
}

// resolve_real_path returns the canonical absolute path for `path` (following
// symlinks), or an empty String when it cannot be resolved.
fn resolve_real_path(path: str) -> String {
    let mut buf: [u8; 4096] = [0; 4096];
    let n = zxn_realpath(path, &mut buf, 4096);
    let mut out = String::new();
    if n > 0 {
        out.push_bytes(buf[0..n as usize]);
    }
    return out;
}

// path_within_root reports whether resolved path `full` is `root` itself or a
// descendant of it. The separator check keeps "/srv/www-evil" from passing as
// a child of "/srv/www".
fn path_within_root(root: &String, full: &String) -> bool {
    if root.len() == 0 || full.len() < root.len() {
        return false;
    }
    if !full.starts_with(root.as_str()) {
        return false;
    }
    if full.len() == root.len() {
        return true;
    }
    return full.byte_at(root.len()) == 47; // '/'
}

// serve_dir_connection handles one static-file request. It intentionally uses
// the same request-size and malformed-request rules as Router.serve.
fn serve_dir_connection(c: &Conn, root: str) -> bool {
    if !c.wait_readable(FIRST_BYTE_MS) {
        return false;
    }
    c.set_timeout(HEAD_TIMEOUT_MS);
    let req = read_request(c);
    if req.head_overflow {
        let too_big = Response::empty(431);
        send_response(c, &too_big);
        c.drain(DRAIN_MS);
        return true;
    }
    if !req.valid() {
        if req.head_bytes == 0 {
            return false;
        }
        let bad = Response::empty(400);
        send_response(c, &bad);
        c.drain(DRAIN_MS);
        return true;
    }
    if req.body_too_large() {
        let too_large = Response::empty(413);
        send_response(c, &too_large);
        return true;
    }
    if !req.body_complete() {
        let bad = Response::empty(400);
        send_response(c, &bad);
        return true;
    }
    let request_path = req.path_only();
    let res = serve_static(root, request_path.as_str());
    send_response(c, &res);
    if req.chunked() {
        c.drain(DRAIN_MS);
    }
    return true;
}

// serve_dir is the compact "python -m http.server" equivalent: serve a
// directory with safe path handling, index.html support, and MIME types.
pub fn serve_dir(root: str, port: i32 = 8000, host: str = "0.0.0.0") -> i32 {
    let mut listener = listen_tcp(host, port);
    if !listener.ok() {
        return 1;
    }
    loop {
        let mut conn = listener.accept();
        if !conn.ok() {
            if accept_retryable() {
                continue;
            }
            listener.close();
            return 1;
        }
        serve_dir_connection(&conn, root);
        conn.close();
    }
}

// serve_dir_n is the bounded static-server form for controlled services/tests.
pub fn serve_dir_n(root: str, max_requests: i32, port: i32 = 8000, host: str = "0.0.0.0") -> i32 {
    let mut listener = listen_tcp(host, port);
    if !listener.ok() {
        return 1;
    }
    let mut served: i32 = 0;
    while served < max_requests {
        let mut conn = listener.accept();
        if !conn.ok() {
            if accept_retryable() {
                continue;
            }
            listener.close();
            return 1;
        }
        if serve_dir_connection(&conn, root) {
            served += 1;
        }
        conn.close();
    }
    listener.close();
    return 0;
}

// serve_dir_local serves a directory only on loopback, ideal for previews and
// local development without exposing the directory to the LAN.
pub fn serve_dir_local(root: str, port: i32 = 8000) -> i32 {
    return serve_dir(root, port, "127.0.0.1");
}

// serve_dir_local_n is the bounded loopback static-server form.
pub fn serve_dir_local_n(root: str, max_requests: i32, port: i32 = 8000) -> i32 {
    return serve_dir_n(root, max_requests, port, "127.0.0.1");
}

// content_type_for guesses a Content-Type from a filename extension.
fn content_type_for(path: &String) -> str {
    let mut dot: i64 = -1;
    let mut i: usize = 0;
    while i < path.len() {
        if path.byte_at(i) == 46 { // '.'
            dot = i as i64;
        }
        i += 1;
    }
    if dot < 0 {
        return "application/octet-stream";
    }
    let ext_raw = path.substr((dot + 1) as usize, SUBSTR_ALL);
    let ext = http_lower(&ext_raw);
    if ext.as_str() == "html" || ext.as_str() == "htm" { return "text/html; charset=utf-8"; }
    if ext.as_str() == "css" { return "text/css; charset=utf-8"; }
    if ext.as_str() == "js" { return "text/javascript; charset=utf-8"; }
    if ext.as_str() == "json" { return "application/json"; }
    if ext.as_str() == "txt" { return "text/plain; charset=utf-8"; }
    if ext.as_str() == "xml" { return "application/xml"; }
    if ext.as_str() == "svg" { return "image/svg+xml"; }
    if ext.as_str() == "png" { return "image/png"; }
    if ext.as_str() == "jpg" || ext.as_str() == "jpeg" { return "image/jpeg"; }
    if ext.as_str() == "gif" { return "image/gif"; }
    if ext.as_str() == "ico" { return "image/x-icon"; }
    if ext.as_str() == "wasm" { return "application/wasm"; }
    if ext.as_str() == "pdf" { return "application/pdf"; }
    if ext.as_str() == "woff2" { return "font/woff2"; }
    return "application/octet-stream";
}

fn has_byte(s: &String, want: i64) -> bool {
    let mut i: usize = 0;
    while i < s.len() {
        if s.byte_at(i) == want {
            return true;
        }
        i += 1;
    }
    return false;
}

// --- helpers ---------------------------------------------------------------

// head_end returns the index just past the blank line ending the head, or -1.
fn head_end(raw: &String) -> i64 {
    let at = raw.find("\r\n\r\n");
    if at < 0 {
        return -1;
    }
    return at + 4;
}

// header_block returns the raw header lines between the start line and the
// blank line, without line terminators at either end.
fn header_block(raw: &String) -> String {
    let first = raw.find("\r\n");
    let he = head_end(raw);
    if first < 0 || he < 0 {
        return String::new();
    }
    let start = (first + 2) as usize;
    let stop = (he - 4) as usize;
    if stop <= start {
        return String::new();
    }
    return raw.substr(start, stop - start);
}

// header_value returns the value of the named header, matched
// case-insensitively, with surrounding whitespace removed. Absent headers
// yield "".
fn header_value(headers: &String, name: str) -> String {
    let want = String::from(name);
    let mut pos: usize = 0;
    while pos < headers.len() {
        let rest = headers.substr(pos, SUBSTR_ALL);
        let nl = rest.find("\r\n");
        let line = if nl < 0 { rest.clone() } else { rest.substr(0, nl as usize) };
        let colon = line.find(":");
        if colon > 0 {
            let key = line.substr(0, colon as usize).trim();
            if same_ignore_case(&key, &want) {
                return line.substr((colon + 1) as usize, SUBSTR_ALL).trim();
            }
        }
        if nl < 0 {
            break;
        }
        pos = pos + (nl as usize) + 2;
    }
    return String::new();
}

// same_ignore_case compares two ASCII strings without regard to case.
fn same_ignore_case(a: &String, b: &String) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i: usize = 0;
    while i < a.len() {
        if lower_byte(a.byte_at(i)) != lower_byte(b.byte_at(i)) {
            return false;
        }
        i += 1;
    }
    return true;
}

fn contains_crlf(s: str) -> bool {
    let v = String::from(s);
    return v.find("\r") >= 0 || v.find("\n") >= 0;
}

fn lower_byte(b: i64) -> i64 {
    if b >= 65 && b <= 90 {
        return b + 32;
    }
    return b;
}

// http_lower returns an ASCII-lowercased copy of s. Its private-style
// prefix avoids colliding with text.lower while modules are still flat.
fn http_lower(s: &String) -> String {
    let mut out = String::with_capacity(s.len());
    let mut i: usize = 0;
    while i < s.len() {
        out.push_byte(lower_byte(s.byte_at(i)) as u8);
        i += 1;
    }
    return out;
}

// parse_dec parses a non-negative decimal integer, or returns -1.
fn parse_dec(s: &String) -> i64 {
    if s.len() == 0 {
        return -1;
    }
    let mut v: i64 = 0;
    let mut i: usize = 0;
    while i < s.len() {
        let b = s.byte_at(i);
        if b < 48 || b > 57 {
            return -1;
        }
        if v > 922337203685477579 {
            return -1; // would overflow
        }
        v = v * 10 + (b - 48);
        i += 1;
    }
    return v;
}

// parse_hex parses a hexadecimal chunk size, ignoring chunk extensions.
fn parse_hex(s: &String) -> i64 {
    let mut v: i64 = 0;
    let mut digits: i32 = 0;
    let mut i: usize = 0;
    while i < s.len() {
        let b = s.byte_at(i);
        let mut d: i64 = -1;
        if b >= 48 && b <= 57 {
            d = b - 48;
        } else if b >= 65 && b <= 70 {
            d = b - 55;
        } else if b >= 97 && b <= 102 {
            d = b - 87;
        }
        if d < 0 {
            break;
        }
        if v > 268435455 {
            return -1; // would overflow a sane chunk size
        }
        v = v * 16 + d;
        digits += 1;
        i += 1;
    }
    if digits == 0 {
        return -1;
    }
    return v;
}

// read_chunked decodes a chunked body, stopping at the terminating zero
// chunk (and draining any trailer lines) or at max bytes.
fn read_chunked(c: &Conn, max: usize) -> String {
    let mut body = String::new();
    loop {
        let line = c.read_line();
        if line.len() == 0 {
            break;
        }
        let size = parse_hex(&line);
        if size < 0 {
            break;
        }
        if size == 0 {
            loop {
                let trailer = c.read_line();
                if trailer.len() == 0 {
                    break;
                }
            }
            break;
        }
        if body.len() + (size as usize) > max {
            break;
        }
        let chunk = c.read_exact(size as usize);
        let got = chunk.len();
        body.push_str(chunk);
        if got < (size as usize) {
            break;
        }
        let crlf = c.read_exact(2);
        if crlf.len() < 2 {
            break;
        }
    }
    return body;
}

fn push_int(s: &mut String, n: i64) {
    if n == 0 {
        s.push_byte(48);
        return;
    }
    let neg = n < 0;
    let mut v = n;
    if neg {
        v = 0 - v;
    }
    let mut digits: [u8; 24] = [0; 24];
    let mut i: usize = 0;
    while v > 0 {
        digits[i] = ((v % 10) as u8) + (48 as u8);
        v = v / 10;
        i += 1;
    }
    if neg {
        s.push_byte(45);
    }
    while i > 0 {
        i -= 1;
        s.push_byte(digits[i]);
    }
}

// The worker-side state — the pinned-router slots, the pool-wide counters, and
// the cooperative stop flag — is C. It lives here rather than in a driver-side
// shim because the block is compiled into the same translation unit as the
// generated code, so it can name `zx_Router` and store real Routers instead of
// an oversized byte buffer. Worker threads receive integers only, so a Router
// travels into a thread as a slot number.
c """
#include <stdatomic.h>
#include <stdint.h>

#define ZXH_MUX_SLOTS 4

/* Slots are written once, when a router is pinned, then read-only; 64-byte
 * alignment keeps the default mux off a pinned slot's cache line. */
_Alignas(64) static zx_Router zxh_mux_base;
_Alignas(64) static zx_Router zxh_mux_extra[ZXH_MUX_SLOTS];
static _Atomic int zxh_mux_pinned[ZXH_MUX_SLOTS];
static int zxh_mux_ready = 0;

zx_Router *zxh_default_mux(void) { return &zxh_mux_base; }

int32_t zxh_default_mux_ready(void) {
    if (!zxh_mux_ready) {
        zxh_mux_ready = 1;
        return 1;
    }
    return 0;
}

zx_Router *zxh_mux_slot(int32_t slot) {
    if (slot <= 0 || slot >= ZXH_MUX_SLOTS) return &zxh_mux_base;
    return &zxh_mux_extra[slot];
}

int32_t zxh_mux_claim(void) {
    for (int i = 1; i < ZXH_MUX_SLOTS; i++) {
        int expected = 0;
        if (atomic_compare_exchange_strong(&zxh_mux_pinned[i], &expected, 1))
            return i;
    }
    return -1;
}

void zxh_mux_release(int32_t slot) {
    if (slot > 0 && slot < ZXH_MUX_SLOTS) atomic_store(&zxh_mux_pinned[slot], 0);
}

int32_t zxh_mux_slot_count(void) { return ZXH_MUX_SLOTS; }

/* A worker pool needs to know how much work the whole pool has done, not just
 * its own share, so the counters live here (C11 atomics, no mutex). */
static _Atomic int64_t zxh_conns = 0;
static _Atomic int64_t zxh_requests = 0;
static _Atomic int zxh_stop_flag = 0;

void zxh_stats_reset(void) {
    atomic_store(&zxh_conns, 0);
    atomic_store(&zxh_requests, 0);
    atomic_store(&zxh_stop_flag, 0);
}

void zxh_count_conn(void) { atomic_fetch_add(&zxh_conns, 1); }

void zxh_count_request(void) { atomic_fetch_add(&zxh_requests, 1); }

int64_t zxh_conns_served(void) { return atomic_load(&zxh_conns); }

int64_t zxh_requests_served(void) { return atomic_load(&zxh_requests); }

void zxh_stop(void) { atomic_store(&zxh_stop_flag, 1); }

void zxh_clear_stop(void) { atomic_store(&zxh_stop_flag, 0); }

int32_t zxh_stopping(void) { return atomic_load(&zxh_stop_flag) != 0; }

/* zxh_set_budget caps how many requests a worker pool serves before the
 * workers ask each other to stop; 0 means "serve forever". A bounded pool is
 * what tests and one-shot tools use, and it makes shutdown deterministic
 * instead of racing against a signal. */
static _Atomic int64_t zxh_budget_requests = 0;

void zxh_set_budget(int64_t n) { atomic_store(&zxh_budget_requests, n); }

int64_t zxh_budget(void) { return atomic_load(&zxh_budget_requests); }
"""
