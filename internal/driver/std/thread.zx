// thread — OS threads, i64 channels, and i64 atomics for Zexi.
//
// A spawned function takes its inputs as arguments and returns its result by
// joining. A closure that captures by value may be passed in place of a plain
// `fn` (see docs/15-closures.md), but only i64 arguments, results, and handles
// are guaranteed across the thread boundary:
//
//     use thread;
//
//     fn square(x: i64) -> i64 { return x * x; }
//
//     fn main() -> i32 {
//         let t = Thread::spawn(square, 21);
//         println(t.join());          // 441
//         0
//     }
//
// Channels connect threads. A channel carries i64 values and blocks when it is
// full (send) or empty (recv); close unblocks every waiter, and buffered values
// stay readable until drained. A `Chan` is not `Copy`, so sharing it with
// several workers goes through the raw i64 handle that `Chan.id()` exposes
// (an i64 is exactly what a closure can capture):
//
//     fn producer(ch: i64) -> i64 {
//         let mut i: i64 = 0;
//         while i < 5 {
//             chan_send(ch, i);
//             i += 1;
//         }
//         chan_close(ch);
//         return 0;
//     }
//
//     fn main() -> i32 {
//         let ch = Chan::new(4);
//         let t = Thread::spawn(producer, ch.id());
//         let mut v: i64 = 0;
//         while ch.recv(&mut v) {
//             println(v);
//         }
//         t.join();
//         0
//     }
//
// Atomics are lock-free i64 cells for counters shared without a channel. All
// three primitives are handle-based; a handle is a small integer, and a stale
// handle fails cleanly rather than aliasing a reused slot.
//
// Spreading work across threads: `Pool` keeps N worker threads alive and feeds
// them jobs, which is the cheap way to use more than one core without spawning
// a thread per item. A job is `fn(i64) -> i64` plus one argument, and `map`
// wraps the common case (run f over a range, sum the results):
//
//     fn square(x: i64) -> i64 { return x * x; }
//
//     fn main() -> i32 {
//         let pool = Pool::new();          // one worker per core
//         println(pool.map(square, 1, 10_001));   // 333_383_350_000
//         pool.free();
//         0
//     }
//
// Submit more than one job at a time and collect results in submission order:
// `let a = pool.submit(f, 1); let b = pool.submit(f, 2); pool.wait();
// pool.result(a) + pool.result(b)`.
//
// Limits: 256 live threads, 256 channels, 256 atomics, and 256 pools per
// process; a pool holds up to 4096 jobs and 256 workers; channel capacity is
// clamped to 1..65536. There is no `Send`/`Sync` checking yet, but
// no Zexi value (String, struct, reference) can cross a thread boundary — only
// i64 handles and i64 arguments/return values do — so the primitives here are
// data-race-free for the types they accept.

// --- threads ---------------------------------------------------------------

extern "C" fn zxt_spawn(entry: fn(i64) -> i64, arg: i64) -> i64;
extern "C" fn zxt_spawn2(entry: fn(i64, i64) -> i64, a: i64, b: i64) -> i64;
extern "C" fn zxt_spawn_void(entry: fn()) -> i64;
extern "C" fn zxt_join(handle: i64) -> i64;

// spawn runs `f(arg)` on a new OS thread and returns its handle.
pub fn spawn(f: fn(i64) -> i64, arg: i64) -> i64 {
    return zxt_spawn(f, arg);
}

// spawn2 runs `f(a, b)` on a new OS thread.
pub fn spawn2(f: fn(i64, i64) -> i64, a: i64, b: i64) -> i64 {
    return zxt_spawn2(f, a, b);
}

// spawn_void runs `f()` on a new OS thread.
pub fn spawn_void(f: fn()) -> i64 {
    return zxt_spawn_void(f);
}

// join waits for the thread and returns its result (0 for spawn_void). Joining
// an unknown or already-joined handle returns 0 instead of misbehaving.
pub fn join(handle: i64) -> i64 {
    return zxt_join(handle);
}

// Thread is the owning wrapper around a spawned thread. `join` consumes it.
pub struct Thread { id: i64 }

impl Thread {
    pub fn spawn(f: fn(i64) -> i64, arg: i64) -> Thread {
        return Thread { id: zxt_spawn(f, arg) };
    }

    pub fn spawn2(f: fn(i64, i64) -> i64, a: i64, b: i64) -> Thread {
        return Thread { id: zxt_spawn2(f, a, b) };
    }

    pub fn spawn_void(f: fn()) -> Thread {
        return Thread { id: zxt_spawn_void(f) };
    }

    pub fn id(&self) -> i64 {
        return self.id;
    }

    pub fn join(self) -> i64 {
        return zxt_join(self.id);
    }
}

// --- channels (i64) --------------------------------------------------------

extern "C" fn zxt_chan_new(cap: i64) -> i64;
extern "C" fn zxt_chan_send(handle: i64, value: i64) -> i32;
extern "C" fn zxt_chan_recv(handle: i64, out: &mut i64) -> i32;
extern "C" fn zxt_chan_try_recv(handle: i64, out: &mut i64) -> i32;
extern "C" fn zxt_chan_close(handle: i64) -> i32;
extern "C" fn zxt_chan_len(handle: i64) -> i64;
extern "C" fn zxt_chan_closed(handle: i64) -> i32;

// chan_new creates a bounded channel; cap is clamped to 1..65536.
pub fn chan_new(cap: i32) -> i64 {
    return zxt_chan_new(cap as i64);
}

// chan_send blocks until there is room, returning false if closed.
pub fn chan_send(handle: i64, value: i64) -> bool {
    return zxt_chan_send(handle, value) == 1;
}

// chan_recv blocks until a value arrives, writing it to out. It returns false
// when the channel is closed and drained.
pub fn chan_recv(handle: i64, out: &mut i64) -> bool {
    return zxt_chan_recv(handle, out) == 1;
}

// chan_try_recv is the non-blocking form of chan_recv.
pub fn chan_try_recv(handle: i64, out: &mut i64) -> bool {
    return zxt_chan_try_recv(handle, out) == 1;
}

// chan_close marks the channel closed and wakes every blocked sender/receiver.
pub fn chan_close(handle: i64) {
    zxt_chan_close(handle);
}

// chan_len is the number of buffered values.
pub fn chan_len(handle: i64) -> i64 {
    return zxt_chan_len(handle);
}

// chan_closed reports whether the channel was closed.
pub fn chan_closed(handle: i64) -> bool {
    return zxt_chan_closed(handle) == 1;
}

// Chan is the owning wrapper with method syntax; `id()` exposes the raw handle
// to a spawned function, which uses the free functions above.
pub struct Chan { id: i64 }

impl Chan {
    pub fn new(cap: i32) -> Chan {
        return Chan { id: zxt_chan_new(cap as i64) };
    }

    pub fn id(&self) -> i64 {
        return self.id;
    }

    pub fn send(&self, value: i64) -> bool {
        return zxt_chan_send(self.id, value) == 1;
    }

    pub fn recv(&self, out: &mut i64) -> bool {
        return zxt_chan_recv(self.id, out) == 1;
    }

    pub fn try_recv(&self, out: &mut i64) -> bool {
        return zxt_chan_try_recv(self.id, out) == 1;
    }

    pub fn close(&self) {
        zxt_chan_close(self.id);
    }

    pub fn len(&self) -> i64 {
        return zxt_chan_len(self.id);
    }

    pub fn closed(&self) -> bool {
        return zxt_chan_closed(self.id) == 1;
    }
}

// --- atomics (i64) ---------------------------------------------------------

extern "C" fn zxt_atomic_new(value: i64) -> i64;
extern "C" fn zxt_atomic_add(handle: i64, delta: i64) -> i64;
extern "C" fn zxt_atomic_get(handle: i64) -> i64;
extern "C" fn zxt_atomic_set(handle: i64, value: i64);

// atomic_new creates an i64 cell shared across threads.
pub fn atomic_new(value: i64) -> i64 {
    return zxt_atomic_new(value);
}

// atomic_add adds delta and returns the new value.
pub fn atomic_add(handle: i64, delta: i64) -> i64 {
    return zxt_atomic_add(handle, delta);
}

pub fn atomic_get(handle: i64) -> i64 {
    return zxt_atomic_get(handle);
}

pub fn atomic_set(handle: i64, value: i64) {
    zxt_atomic_set(handle, value);
}

// Atomic is the owning wrapper with method syntax.
pub struct Atomic { id: i64 }

impl Atomic {
    pub fn new(value: i64) -> Atomic {
        return Atomic { id: zxt_atomic_new(value) };
    }

    pub fn id(&self) -> i64 {
        return self.id;
    }

    pub fn add(&self, delta: i64) -> i64 {
        return zxt_atomic_add(self.id, delta);
    }

    pub fn get(&self) -> i64 {
        return zxt_atomic_get(self.id);
    }

    pub fn set(&self, value: i64) {
        zxt_atomic_set(self.id, value);
    }
}

// --- task pools ------------------------------------------------------------

extern "C" fn zxt_cpu_count() -> i32;
extern "C" fn zxt_pool_new(workers: i32) -> i64;
extern "C" fn zxt_pool_submit(handle: i64, entry: fn(i64) -> i64, arg: i64) -> i64;
extern "C" fn zxt_pool_wait(handle: i64) -> i32;
extern "C" fn zxt_pool_result(handle: i64, seq: i64) -> i64;
extern "C" fn zxt_pool_done_count(handle: i64) -> i32;
extern "C" fn zxt_pool_workers(handle: i64) -> i32;
extern "C" fn zxt_pool_capacity(handle: i64) -> i64;
extern "C" fn zxt_pool_queued(handle: i64) -> i64;
extern "C" fn zxt_pool_free(handle: i64) -> i32;

// cpu_count reports how many processors this process may run on.
pub fn cpu_count() -> i32 {
    return zxt_cpu_count();
}

// MAX_POOL_JOBS is how many jobs one queue holds before submit fails: the wrap
// point where `Pool::map` banks its results. The C side is the source of truth
// (`ZXT_MAX_JOBS`); this is the documented number.
const MAX_POOL_JOBS: i32 = 4096;

// Pool is a set of long-lived worker threads draining a job queue. Create it
// once, submit work, `wait` for it, then `free` the pool. Jobs may be submitted
// from several threads; results are collected by the sequence number `submit`
// returns, in submission order.
pub struct Pool {
    id: i64,
}

impl Pool {
    // new starts a pool of `workers` threads. 0 means "one per processor"
    // (at least two, at most 64).
    pub fn new(workers: i32 = 0) -> Pool {
        let mut n = workers;
        if n <= 0 {
            n = zxt_cpu_count();
            if n < 2 {
                n = 2;
            }
        }
        if n > 64 {
            n = 64;
        }
        return Pool { id: zxt_pool_new(n) };
    }

    // ok reports whether the pool started.
    pub fn ok(&self) -> bool {
        return self.id != 0;
    }

    // id exposes the integer handle, for passing to free functions.
    pub fn id(&self) -> i64 {
        return self.id;
    }

    // workers is how many worker threads are actually running.
    pub fn workers(&self) -> i32 {
        return zxt_pool_workers(self.id);
    }

    // submit queues `f(arg)` and returns its sequence number, or -1 when the
    // queue is full (call `wait` to drain it) or the pool is invalid.
    pub fn submit(&self, f: fn(i64) -> i64, arg: i64) -> i64 {
        return zxt_pool_submit(self.id, f, arg);
    }

    // wait blocks until every submitted job has finished and returns how many
    // ran.
    pub fn wait(&self) -> i32 {
        return zxt_pool_wait(self.id);
    }

    // result is the value a finished job returned (0 if it has not finished,
    // so call wait first).
    pub fn result(&self, seq: i64) -> i64 {
        return zxt_pool_result(self.id, seq);
    }

    // done is how many jobs have finished so far.
    pub fn done(&self) -> i32 {
        return zxt_pool_done_count(self.id);
    }

    // map runs `f(i)` for every i in lo..hi across the pool and returns the sum
    // of the results — the shortest way to parallelise a loop. Ranges larger
    // than the job queue work too, but the queue is a single shared ring: once
    // it is full and every job in it, past or present, has finished, the next
    // submit recycles it and destroys any result that has not been collected.
    // So map counts the room the queue actually has left — the whole queue
    // minus what an earlier caller may have left queued — and waits and banks
    // every result *at* that wrap point, before submitting again. Reacting only
    // to a failed submit comes too late.
    pub fn map(&self, f: fn(i64) -> i64, lo: i64, hi: i64) -> i64 {
        let mut total: i64 = 0;
        let mut base: i64 = -1;
        let mut submitted: i64 = 0;
        let mut i = lo;
        let cap = zxt_pool_capacity(self.id);
        let mut room = cap - zxt_pool_queued(self.id);
        if room < 0 {
            room = 0;
        }
        while i < hi {
            if base >= 0 && room > 0 && submitted >= room {
                self.wait();
                total += self.bank(base, submitted);
                submitted = 0;
                base = -1;
                // The queue is full and fully drained now, so the next submit
                // reclaims it: the following batch has the whole queue again.
                room = cap;
            }
            let mut seq = zxt_pool_submit(self.id, f, i);
            if seq < 0 {
                // Queue full with jobs still running: drain it, bank what is
                // there, and try this job again — that retry is the one that
                // reclaims the queue.
                self.wait();
                total += self.bank(base, submitted);
                submitted = 0;
                base = -1;
                room = cap;
                seq = zxt_pool_submit(self.id, f, i);
            }
            if seq < 0 {
                break;
            }
            if base < 0 {
                base = seq;
            }
            submitted += 1;
            i += 1;
        }
        self.wait();
        total += self.bank(base, submitted);
        return total;
    }

    // bank adds up the results of `submitted` jobs queued starting at `base`.
    // Call it only after `wait`, or unfinished jobs contribute 0.
    fn bank(&self, base: i64, submitted: i64) -> i64 {
        let mut total: i64 = 0;
        let mut k: i64 = 0;
        while k < submitted {
            total += zxt_pool_result(self.id, base + k);
            k += 1;
        }
        return total;
    }

    // free stops the workers and releases the pool. No job may be running.
    pub fn free(&self) {
        zxt_pool_free(self.id);
    }
}

// Threads, mutexes, channels, and the worker pool are C. It travels with this
// file, so `use thread;` links it (and `-pthread`) with no driver-side list.
#[link("pthread")]
c """
#define _POSIX_C_SOURCE 200809L
#define _DEFAULT_SOURCE
#include <pthread.h>
#include <stdint.h>
#include <stdatomic.h>
#include <stdlib.h>
#include <string.h>
#include <sched.h>
#include <unistd.h>

#define ZXT_SLOTS 256
#define ZXT_HANDLE(slot, gen) (((int64_t)((uint64_t)(gen) << 8)) | (int64_t)(slot))

/* A Zexi function value is a pointer to a closure record whose first fields
 * are the reference count and the C function to run; the function receives the
 * record itself as its first argument (see codegen's closureRuntime). */
typedef struct { long rc; void *fn; } zxt_closure;

typedef int64_t (*zxt_fn1)(void *, int64_t);
typedef int64_t (*zxt_fn2)(void *, int64_t, int64_t);
typedef void (*zxt_fn0)(void *);

#define ZXT_CALL0(p) (((zxt_fn0)((zxt_closure *)(p))->fn)((void *)(p)))
#define ZXT_CALL1(p, a) (((zxt_fn1)((zxt_closure *)(p))->fn)((void *)(p), (a)))
#define ZXT_CALL2(p, a, b) (((zxt_fn2)((zxt_closure *)(p))->fn)((void *)(p), (a), (b)))

/* ---- threads -------------------------------------------------------------- */

typedef struct {
    int used;
    int joined;
    int joining;
    uint32_t gen;
    pthread_t tid;
    int kind; /* 0 void, 1 fn1, 2 fn2 */
    void *entry;
    int64_t a, b, result;
} zxt_thread_t;

static zxt_thread_t g_threads[ZXT_SLOTS];
static pthread_mutex_t g_threads_mu = PTHREAD_MUTEX_INITIALIZER;

static void *zxt_thread_main(void *p) {
    zxt_thread_t *t = (zxt_thread_t *)p;
    if (t->kind == 0) {
        ZXT_CALL0(t->entry);
    } else if (t->kind == 1) {
        t->result = ZXT_CALL1(t->entry, t->a);
    } else {
        t->result = ZXT_CALL2(t->entry, t->a, t->b);
    }
    return NULL;
}

static int64_t zxt_thread_start(int kind, void *entry, int64_t a, int64_t b) {
    pthread_mutex_lock(&g_threads_mu);
    int slot = -1;
    for (int i = 0; i < ZXT_SLOTS; i++) {
        if (!g_threads[i].used || g_threads[i].joined) {
            slot = i;
            break;
        }
    }
    if (slot < 0) {
        pthread_mutex_unlock(&g_threads_mu);
        return 0; /* too many live threads */
    }
    zxt_thread_t *t = &g_threads[slot];
    t->gen++;
    t->used = 1;
    t->joined = 0;
    t->joining = 0;
    t->kind = kind;
    t->entry = entry;
    t->a = a;
    t->b = b;
    t->result = 0;
    if (pthread_create(&t->tid, NULL, zxt_thread_main, t) != 0) {
        t->used = 0;
        pthread_mutex_unlock(&g_threads_mu);
        return 0;
    }
    int64_t h = ZXT_HANDLE(slot, t->gen);
    pthread_mutex_unlock(&g_threads_mu);
    return h;
}

int64_t zxt_spawn(void *entry, int64_t arg) {
    return zxt_thread_start(1, entry, arg, 0);
}

int64_t zxt_spawn2(void *entry, int64_t a, int64_t b) {
    return zxt_thread_start(2, entry, a, b);
}

int64_t zxt_spawn_void(void *entry) {
    return zxt_thread_start(0, entry, 0, 0);
}

/* zxt_join waits for the thread named by h and returns its i64 result. A stale
 * or already-joined handle returns the stored result (0 for void threads or an
 * unknown handle), so joining twice is harmless. */
int64_t zxt_join(int64_t h) {
    uint64_t slot = (uint64_t)h & 0xff;
    uint32_t gen = (uint32_t)((uint64_t)h >> 8);
    if (slot >= ZXT_SLOTS) {
        return 0;
    }
    pthread_mutex_lock(&g_threads_mu);
    zxt_thread_t *t = &g_threads[slot];
    if (!t->used || t->gen != gen) {
        pthread_mutex_unlock(&g_threads_mu);
        return 0;
    }
    while (t->joining) {
        pthread_mutex_unlock(&g_threads_mu);
        sched_yield();
        pthread_mutex_lock(&g_threads_mu);
        if (t->gen != gen) {
            pthread_mutex_unlock(&g_threads_mu);
            return 0;
        }
    }
    if (t->joined) {
        int64_t r = t->result;
        pthread_mutex_unlock(&g_threads_mu);
        return r;
    }
    t->joining = 1;
    pthread_t tid = t->tid;
    pthread_mutex_unlock(&g_threads_mu);

    pthread_join(tid, NULL);

    pthread_mutex_lock(&g_threads_mu);
    t->joined = 1;
    t->joining = 0;
    int64_t r = t->result;
    pthread_mutex_unlock(&g_threads_mu);
    return r;
}

/* ---- channels (i64) ------------------------------------------------------- */

typedef struct {
    int used;
    uint32_t gen;
    int cap;
    int count;
    int head;
    int closed;
    int64_t *buf;
    pthread_mutex_t mu;
    pthread_cond_t not_full;
    pthread_cond_t not_empty;
} zxt_chan_t;

static zxt_chan_t g_chans[ZXT_SLOTS];
static pthread_mutex_t g_chans_mu = PTHREAD_MUTEX_INITIALIZER;

static zxt_chan_t *zxt_chan_resolve(int64_t h) {
    uint64_t slot = (uint64_t)h & 0xff;
    uint32_t gen = (uint32_t)((uint64_t)h >> 8);
    if (slot >= ZXT_SLOTS) {
        return NULL;
    }
    zxt_chan_t *c = &g_chans[slot];
    if (!c->used || c->gen != gen) {
        return NULL;
    }
    return c;
}

/* zxt_chan_new creates a bounded channel with room for cap values (cap is
 * clamped to 1..65536). It returns 0 when the channel table is full. */
int64_t zxt_chan_new(int64_t cap) {
    if (cap < 1) {
        cap = 1;
    }
    if (cap > 65536) {
        cap = 65536;
    }
    pthread_mutex_lock(&g_chans_mu);
    int slot = -1;
    for (int i = 0; i < ZXT_SLOTS; i++) {
        if (!g_chans[i].used) {
            slot = i;
            break;
        }
    }
    if (slot < 0) {
        pthread_mutex_unlock(&g_chans_mu);
        return 0;
    }
    zxt_chan_t *c = &g_chans[slot];
    c->buf = (int64_t *)malloc((size_t)cap * sizeof(int64_t));
    if (!c->buf) {
        pthread_mutex_unlock(&g_chans_mu);
        return 0;
    }
    c->gen++;
    c->used = 1;
    c->cap = (int)cap;
    c->count = 0;
    c->head = 0;
    c->closed = 0;
    pthread_mutex_init(&c->mu, NULL);
    pthread_cond_init(&c->not_full, NULL);
    pthread_cond_init(&c->not_empty, NULL);
    int64_t h = ZXT_HANDLE(slot, c->gen);
    pthread_mutex_unlock(&g_chans_mu);
    return h;
}

/* zxt_chan_send blocks until there is room, then enqueues v. Returns 1 on
 * success and 0 if the channel is (or becomes) closed. */
int zxt_chan_send(int64_t h, int64_t v) {
    zxt_chan_t *c = zxt_chan_resolve(h);
    if (!c) {
        return 0;
    }
    pthread_mutex_lock(&c->mu);
    while (c->count == c->cap && !c->closed) {
        pthread_cond_wait(&c->not_full, &c->mu);
    }
    if (c->closed) {
        pthread_mutex_unlock(&c->mu);
        return 0;
    }
    int tail = (c->head + c->count) % c->cap;
    c->buf[tail] = v;
    c->count++;
    pthread_cond_signal(&c->not_empty);
    pthread_mutex_unlock(&c->mu);
    return 1;
}

/* zxt_chan_recv blocks until a value is available. It writes the value to out
 * and returns 1, or returns 0 when the channel is closed and drained. */
int zxt_chan_recv(int64_t h, int64_t *out) {
    zxt_chan_t *c = zxt_chan_resolve(h);
    if (!c) {
        return 0;
    }
    pthread_mutex_lock(&c->mu);
    while (c->count == 0 && !c->closed) {
        pthread_cond_wait(&c->not_empty, &c->mu);
    }
    if (c->count == 0) {
        pthread_mutex_unlock(&c->mu);
        return 0;
    }
    int64_t v = c->buf[c->head];
    c->head = (c->head + 1) % c->cap;
    c->count--;
    pthread_cond_signal(&c->not_full);
    pthread_mutex_unlock(&c->mu);
    *out = v;
    return 1;
}

/* zxt_chan_try_recv returns 1 with a value, or 0 when empty/closed/invalid. */
int zxt_chan_try_recv(int64_t h, int64_t *out) {
    zxt_chan_t *c = zxt_chan_resolve(h);
    if (!c) {
        return 0;
    }
    pthread_mutex_lock(&c->mu);
    if (c->count == 0) {
        pthread_mutex_unlock(&c->mu);
        return 0;
    }
    int64_t v = c->buf[c->head];
    c->head = (c->head + 1) % c->cap;
    c->count--;
    pthread_cond_signal(&c->not_full);
    pthread_mutex_unlock(&c->mu);
    *out = v;
    return 1;
}

/* zxt_chan_close marks the channel closed and wakes every waiter. Buffered
 * values remain available to recv. Returns 1 if this call closed it. */
int zxt_chan_close(int64_t h) {
    zxt_chan_t *c = zxt_chan_resolve(h);
    if (!c) {
        return 0;
    }
    pthread_mutex_lock(&c->mu);
    int first = !c->closed;
    c->closed = 1;
    pthread_cond_broadcast(&c->not_empty);
    pthread_cond_broadcast(&c->not_full);
    pthread_mutex_unlock(&c->mu);
    return first;
}

int64_t zxt_chan_len(int64_t h) {
    zxt_chan_t *c = zxt_chan_resolve(h);
    if (!c) {
        return 0;
    }
    pthread_mutex_lock(&c->mu);
    int64_t n = c->count;
    pthread_mutex_unlock(&c->mu);
    return n;
}

int zxt_chan_closed(int64_t h) {
    zxt_chan_t *c = zxt_chan_resolve(h);
    if (!c) {
        return 1;
    }
    pthread_mutex_lock(&c->mu);
    int v = c->closed;
    pthread_mutex_unlock(&c->mu);
    return v;
}

/* ---- atomics (i64) -------------------------------------------------------- */

typedef struct {
    int used;
    uint32_t gen;
    _Atomic int64_t v;
} zxt_atom_t;

static zxt_atom_t g_atoms[ZXT_SLOTS];
static pthread_mutex_t g_atoms_mu = PTHREAD_MUTEX_INITIALIZER;

static zxt_atom_t *zxt_atom_resolve(int64_t h) {
    uint64_t slot = (uint64_t)h & 0xff;
    uint32_t gen = (uint32_t)((uint64_t)h >> 8);
    if (slot >= ZXT_SLOTS) {
        return NULL;
    }
    zxt_atom_t *a = &g_atoms[slot];
    if (!a->used || a->gen != gen) {
        return NULL;
    }
    return a;
}

int64_t zxt_atomic_new(int64_t v) {
    pthread_mutex_lock(&g_atoms_mu);
    int slot = -1;
    for (int i = 0; i < ZXT_SLOTS; i++) {
        if (!g_atoms[i].used) {
            slot = i;
            break;
        }
    }
    if (slot < 0) {
        pthread_mutex_unlock(&g_atoms_mu);
        return 0;
    }
    zxt_atom_t *a = &g_atoms[slot];
    a->gen++;
    a->used = 1;
    atomic_store(&a->v, v);
    int64_t h = ZXT_HANDLE(slot, a->gen);
    pthread_mutex_unlock(&g_atoms_mu);
    return h;
}

int64_t zxt_atomic_add(int64_t h, int64_t d) {
    zxt_atom_t *a = zxt_atom_resolve(h);
    if (!a) {
        return 0;
    }
    return atomic_fetch_add(&a->v, d) + d; /* returns the new value */
}

int64_t zxt_atomic_get(int64_t h) {
    zxt_atom_t *a = zxt_atom_resolve(h);
    if (!a) {
        return 0;
    }
    return atomic_load(&a->v);
}

void zxt_atomic_set(int64_t h, int64_t v) {
    zxt_atom_t *a = zxt_atom_resolve(h);
    if (!a) {
        return;
    }
    atomic_store(&a->v, v);
}

/* ---- task pools -----------------------------------------------------------
 * A pool is N long-lived worker threads draining a shared job queue. Jobs are
 * `fn(i64) -> i64` plus one argument, which is what Zexi can pass across a
 * thread boundary today. Submitting is non-blocking; `wait` blocks until every
 * submitted job has finished, and each job keeps its result so a caller can
 * collect them in submission order — the usual map-over-a-range shape.
 *
 * Pools are named by the same slot+generation handle as threads, channels, and
 * atomics, so a stale handle fails cleanly instead of aliasing a new pool.
 */

#define ZXT_MAX_JOBS 4096

typedef struct {
    void *entry;
    int64_t arg;
    int64_t result;
    int done;
    int claimed;
    uint64_t seq;
} zxt_job_t;

typedef struct {
    int used;
    uint32_t gen;
    pthread_t *threads;
    int workers;
    int stop;
    uint64_t next_seq;
    uint64_t done_count;
    zxt_job_t *jobs;
    int njobs;
    int cap;
    pthread_mutex_t mu;
    pthread_cond_t work;   /* signalled when a job arrives or the pool stops */
    pthread_cond_t idle;   /* signalled when a job finishes */
} zxt_pool_t;

static zxt_pool_t g_pools[ZXT_SLOTS];
static pthread_mutex_t g_pools_mu = PTHREAD_MUTEX_INITIALIZER;

static zxt_pool_t *zxt_pool_resolve(int64_t h) {
    uint64_t slot = (uint64_t)h & 0xff;
    uint32_t gen = (uint32_t)((uint64_t)h >> 8);
    if (slot >= ZXT_SLOTS) {
        return NULL;
    }
    zxt_pool_t *p = &g_pools[slot];
    if (!p->used || p->gen != gen) {
        return NULL;
    }
    return p;
}

static int zxt_pool_next_job(zxt_pool_t *p, zxt_job_t *out) {
    /* Returns 1 when a job was taken, 0 when the pool is stopping. Caller
     * holds the mutex. */
    for (;;) {
        for (int i = 0; i < p->njobs; i++) {
            zxt_job_t *j = &p->jobs[i];
            if (!j->done && !j->claimed && j->entry) {
                j->claimed = 1;
                *out = *j;
                return 1;
            }
        }
        if (p->stop) {
            return 0;
        }
        pthread_cond_wait(&p->work, &p->mu);
    }
}

static void *zxt_pool_main(void *arg) {
    zxt_pool_t *p = (zxt_pool_t *)arg;
    pthread_mutex_lock(&p->mu);
    for (;;) {
        zxt_job_t job;
        if (!zxt_pool_next_job(p, &job)) {
            break;
        }
        pthread_mutex_unlock(&p->mu);
        int64_t result = ZXT_CALL1(job.entry, job.arg);
        pthread_mutex_lock(&p->mu);
        for (int i = 0; i < p->njobs; i++) {
            if (p->jobs[i].seq == job.seq) {
                p->jobs[i].result = result;
                p->jobs[i].done = 1;
                break;
            }
        }
        p->done_count++;
        pthread_cond_broadcast(&p->idle);
    }
    pthread_mutex_unlock(&p->mu);
    return NULL;
}

int64_t zxt_pool_new(int workers) {
    if (workers < 1) workers = 1;
    if (workers > 256) workers = 256;
    pthread_mutex_lock(&g_pools_mu);
    int slot = -1;
    for (int i = 0; i < ZXT_SLOTS; i++) {
        if (!g_pools[i].used) {
            slot = i;
            break;
        }
    }
    if (slot < 0) {
        pthread_mutex_unlock(&g_pools_mu);
        return 0;
    }
    zxt_pool_t *p = &g_pools[slot];
    memset(p, 0, sizeof *p);
    p->gen++;
    p->used = 1;
    p->workers = workers;
    p->jobs = (zxt_job_t *)calloc(ZXT_MAX_JOBS, sizeof(zxt_job_t));
    p->threads = (pthread_t *)calloc((size_t)workers, sizeof(pthread_t));
    if (!p->jobs || !p->threads) {
        free(p->jobs);
        free(p->threads);
        p->used = 0;
        pthread_mutex_unlock(&g_pools_mu);
        return 0;
    }
    p->cap = ZXT_MAX_JOBS;
    pthread_mutex_init(&p->mu, NULL);
    pthread_cond_init(&p->work, NULL);
    pthread_cond_init(&p->idle, NULL);
    int started = 0;
    for (int i = 0; i < workers; i++) {
        if (pthread_create(&p->threads[i], NULL, zxt_pool_main, p) != 0) break;
        started++;
    }
    p->workers = started;
    if (started == 0) {
        free(p->jobs);
        free(p->threads);
        p->used = 0;
        pthread_mutex_unlock(&g_pools_mu);
        return 0;
    }
    int64_t h = ZXT_HANDLE(slot, p->gen);
    pthread_mutex_unlock(&g_pools_mu);
    return h;
}

int zxt_pool_workers(int64_t h) {
    zxt_pool_t *p = zxt_pool_resolve(h);
    return p ? p->workers : 0;
}

/* zxt_pool_capacity is how many jobs the queue holds before submit fails. It is
 * the wrap point at which Pool::map banks its queued results, so callers never
 * have to guess the size. */
int64_t zxt_pool_capacity(int64_t h) {
    zxt_pool_t *p = zxt_pool_resolve(h);
    return p ? p->cap : 0;
}

/* zxt_pool_queued is how many jobs the queue currently holds, finished or not.
 * map uses it to see how much room it has before a submit would recycle the
 * queue and destroy results that have not been collected yet. */
int64_t zxt_pool_queued(int64_t h) {
    zxt_pool_t *p = zxt_pool_resolve(h);
    return p ? p->njobs : 0;
}

/* zxt_pool_submit queues one job and returns its index (>= 0), or -1 when the
 * pool is full or the handle is stale. */
int64_t zxt_pool_submit(int64_t h, void *entry, int64_t arg) {
    zxt_pool_t *p = zxt_pool_resolve(h);
    if (!p) return -1;
    pthread_mutex_lock(&p->mu);
    if (p->njobs >= p->cap) {
        /* Make room by recycling the queue once every job has finished. A
         * caller that still needs an old result must collect it before
         * submitting another full queue's worth of work. */
        if (p->done_count == (uint64_t)p->njobs) {
            p->njobs = 0;
            p->done_count = 0;
        } else {
            pthread_mutex_unlock(&p->mu);
            return -1;
        }
    }
    int idx = p->njobs++;
    p->jobs[idx].entry = entry;
    p->jobs[idx].arg = arg;
    p->jobs[idx].result = 0;
    p->jobs[idx].done = 0;
    p->jobs[idx].claimed = 0;
    p->jobs[idx].seq = ++p->next_seq;
    int64_t out = p->jobs[idx].seq;
    pthread_cond_signal(&p->work);
    pthread_mutex_unlock(&p->mu);
    return out;
}

/* zxt_pool_wait blocks until every submitted job has finished. Returns the
 * number of jobs completed. */
int zxt_pool_wait(int64_t h) {
    zxt_pool_t *p = zxt_pool_resolve(h);
    if (!p) return 0;
    pthread_mutex_lock(&p->mu);
    while (p->done_count < (uint64_t)p->njobs) {
        pthread_cond_wait(&p->idle, &p->mu);
    }
    int n = (int)p->done_count;
    pthread_mutex_unlock(&p->mu);
    return n;
}

/* zxt_pool_result returns the result of the job with sequence number seq, or 0
 * when it has not finished (use wait first to avoid that). */
int64_t zxt_pool_result(int64_t h, int64_t seq) {
    zxt_pool_t *p = zxt_pool_resolve(h);
    if (!p) return 0;
    pthread_mutex_lock(&p->mu);
    int64_t out = 0;
    for (int i = 0; i < p->njobs; i++) {
        if (p->jobs[i].seq == (uint64_t)seq && p->jobs[i].done) {
            out = p->jobs[i].result;
            break;
        }
    }
    pthread_mutex_unlock(&p->mu);
    return out;
}

int zxt_pool_done_count(int64_t h) {
    zxt_pool_t *p = zxt_pool_resolve(h);
    if (!p) return 0;
    pthread_mutex_lock(&p->mu);
    int n = (int)p->done_count;
    pthread_mutex_unlock(&p->mu);
    return n;
}

/* zxt_pool_free stops the workers, joins them, and releases the pool. It waits
 * for running jobs to finish so no thread keeps using the slot afterwards. */
int zxt_pool_free(int64_t h) {
    zxt_pool_t *p = zxt_pool_resolve(h);
    if (!p) return -1;
    pthread_mutex_lock(&g_pools_mu);
    pthread_mutex_lock(&p->mu);
    p->stop = 1;
    pthread_cond_broadcast(&p->work);
    pthread_mutex_unlock(&p->mu);
    for (int i = 0; i < p->workers; i++) {
        pthread_join(p->threads[i], NULL);
    }
    free(p->jobs);
    free(p->threads);
    pthread_cond_destroy(&p->work);
    pthread_cond_destroy(&p->idle);
    pthread_mutex_destroy(&p->mu);
    p->jobs = NULL;
    p->threads = NULL;
    p->used = 0;
    pthread_mutex_unlock(&g_pools_mu);
    return 0;
}

/* zxt_cpu_count is the number of processors this process may run on. */
int zxt_cpu_count(void) {
#ifdef _SC_NPROCESSORS_ONLN
    long n = sysconf(_SC_NPROCESSORS_ONLN);
    if (n > 0 && n < 4096) return (int)n;
#endif
    return 1;
}
"""
