// text — a practical string toolkit, part of the Zexi standard library.
// Import with `use text;` or `use std::text;`.
//
// Functions take `str` inputs (string literals pass directly) and return
// owning `String`s. Scanning/ASCII only — no Unicode case folding yet.

// repeat_text returns `s` concatenated `n` times.
pub fn repeat_text(s: str, n: i32) -> String {
    let mut out = String::new();
    let mut i = 0;
    while i < n {
        out.push_str(s);
        i += 1;
    }
    out
}

// exclaim returns `s` with a trailing "!".
pub fn exclaim(s: str) -> String {
    let mut out = String::from(s);
    out.push_str("!");
    out
}

// pad_start pads `s` on the left with `ch` until it is `width` bytes long.
pub fn pad_start(s: str, width: i32, ch: char) -> String {
    let mut out = String::new();
    let mut missing = width - (len(s) as i32);
    while missing > 0 {
        out.push(ch);
        missing -= 1;
    }
    out.push_str(s);
    out
}

// pad_end pads `s` on the right with `ch` until it is `width` bytes long.
pub fn pad_end(s: str, width: i32, ch: char) -> String {
    let mut out = String::from(s);
    let mut missing = width - (len(s) as i32);
    while missing > 0 {
        out.push(ch);
        missing -= 1;
    }
    out
}

// join_with returns a + sep + b.
pub fn join_with(a: str, sep: str, b: str) -> String {
    let mut out = String::from(a);
    out.push_str(sep);
    out.push_str(b);
    out
}

// shout wraps `s` in asterisks, for emphasis in plain-text output.
pub fn shout(s: str) -> String {
    let mut out = String::from("*");
    out.push_str(s);
    out.push_str("*");
    out
}

// to_upper returns an ASCII-uppercased copy of `s`.
pub fn to_upper(s: str) -> String {
    let v = String::from(s);
    let mut out = String::with_capacity(v.len());
    let mut i: usize = 0;
    while i < v.len() {
        let b = v.byte_at(i);
        if b >= 97 && b <= 122 {
            out.push_byte((b - 32) as u8);
        } else {
            out.push_byte(b as u8);
        }
        i += 1;
    }
    return out;
}

// to_lower returns an ASCII-lowercased copy of `s`.
pub fn to_lower(s: str) -> String {
    let v = String::from(s);
    let mut out = String::with_capacity(v.len());
    let mut i: usize = 0;
    while i < v.len() {
        let b = v.byte_at(i);
        if b >= 65 && b <= 90 {
            out.push_byte((b + 32) as u8);
        } else {
            out.push_byte(b as u8);
        }
        i += 1;
    }
    return out;
}

// index_of returns the byte offset of the first occurrence of `sub` in `s`,
// or -1. (String.find is the same operation on an owning String.)
pub fn index_of(s: str, sub: str) -> i64 {
    let v = String::from(s);
    return v.find(sub);
}

// last_index_of returns the byte offset of the last occurrence of `sub`, or -1.
pub fn last_index_of(s: str, sub: str) -> i64 {
    let v = String::from(s);
    let needle = String::from(sub);
    if needle.len() == 0 {
        return v.len() as i64;
    }
    if needle.len() > v.len() {
        return -1;
    }
    let mut i = (v.len() - needle.len()) as i64;
    while i >= 0 {
        let piece = v.substr(i as usize, needle.len());
        if piece.as_str() == needle.as_str() {
            return i;
        }
        i -= 1;
    }
    return -1;
}

// count_occurrences counts non-overlapping occurrences of `sub` in `s`.
pub fn count_occurrences(s: str, sub: str) -> i64 {
    let v = String::from(s);
    let needle = String::from(sub);
    if needle.len() == 0 {
        return 0;
    }
    let mut count: i64 = 0;
    let mut pos: usize = 0;
    while pos <= v.len() {
        let rest = v.substr(pos, 4294967295);
        let at = rest.find(needle.as_str());
        if at < 0 {
            break;
        }
        count += 1;
        pos = pos + (at as usize) + needle.len();
    }
    return count;
}

// replace_all returns `s` with every occurrence of `from` replaced by `to`.
pub fn replace_all(s: str, from: str, to: str) -> String {
    let v = String::from(s);
    let needle = String::from(from);
    let mut out = String::new();
    if needle.len() == 0 {
        out.push_str(v.as_str());
    } else {
        let mut pos: usize = 0;
        while pos < v.len() {
            let rest = v.substr(pos, 4294967295);
            let at = rest.find(needle.as_str());
            if at < 0 {
                out.push_str(rest.as_str());
                break;
            }
            let piece = rest.substr(0, at as usize);
            out.push_str(piece.as_str());
            out.push_str(to);
            pos = pos + (at as usize) + needle.len();
        }
    }
    return out;
}

// slice_text returns s[start..end], clamped to the string bounds (never
// panics; an empty result means the range was out of bounds or inverted).
pub fn slice_text(s: str, start: usize, end: usize) -> String {
    let v = String::from(s);
    let n = v.len();
    if start >= n || end <= start {
        return String::new();
    }
    let last = if end < n { end } else { n };
    return v.substr(start, last - start);
}

// trim_start removes leading ASCII whitespace.
pub fn trim_start(s: str) -> String {
    let v = String::from(s);
    let mut i: usize = 0;
    while i < v.len() && is_space_byte(v.byte_at(i)) {
        i += 1;
    }
    return v.substr(i, 4294967295);
}

// trim_end removes trailing ASCII whitespace.
pub fn trim_end(s: str) -> String {
    let v = String::from(s);
    let mut end = v.len();
    while end > 0 && is_space_byte(v.byte_at(end - 1)) {
        end -= 1;
    }
    return v.substr(0, end);
}

// compare is a lexicographic byte comparison: negative when a < b, zero when
// equal, positive when a > b. Handy for sorting.
pub fn compare(a: str, b: str) -> i32 {
    let x = String::from(a);
    let y = String::from(b);
    let n = if x.len() < y.len() { x.len() } else { y.len() };
    let mut i: usize = 0;
    while i < n {
        let bx = x.byte_at(i);
        let by = y.byte_at(i);
        if bx < by {
            return -1;
        }
        if bx > by {
            return 1;
        }
        i += 1;
    }
    if x.len() < y.len() {
        return -1;
    }
    if x.len() > y.len() {
        return 1;
    }
    return 0;
}

// is_digit reports whether `c` is '0'..'9'.
pub fn is_digit(c: char) -> bool {
    let b = c as i64;
    return b >= 48 && b <= 57;
}

// is_alpha reports whether `c` is an ASCII letter.
pub fn is_alpha(c: char) -> bool {
    let b = c as i64;
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
}

// is_alnum reports whether `c` is an ASCII letter or digit.
pub fn is_alnum(c: char) -> bool {
    return is_alpha(c) || is_digit(c);
}

// is_space reports whether `c` is one of space, tab, CR, LF, VT, FF.
pub fn is_space(c: char) -> bool {
    return is_space_byte(c as i64);
}

// is_digits_only reports whether `s` is non-empty and all ASCII digits.
pub fn is_digits_only(s: str) -> bool {
    let v = String::from(s);
    if v.len() == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < v.len() {
        let b = v.byte_at(i);
        if b < 48 || b > 57 {
            return false;
        }
        i += 1;
    }
    return true;
}

// format_bool renders a bool as "true"/"false".
pub fn format_bool(b: bool) -> String {
    if b {
        return String::from("true");
    }
    return String::from("false");
}

fn is_space_byte(b: i64) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12;
}
