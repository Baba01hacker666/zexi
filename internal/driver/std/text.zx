// text — a practical string toolkit, part of the Zexi standard library.
// Import with `use text;`, `use std::text;`, or `import text;`.
//
// Functions take `str` inputs (string literals pass directly) and return
// owning `String`s. Scanning/ASCII only — no Unicode case folding yet.
//
// Scanning borrows: each function reads its input through `as_bytes()` and
// walks a `&[u8]`, so a `String` argument is never copied just to be inspected,
// and the byte-level helpers (`find_bytes`) work over any slice.

// find_bytes is the byte offset of the first occurrence of `needle` in `hay` at
// or after `from`, or -1. An empty needle matches at `from` when it is in range.
// It is the primitive every search below is built on.
pub fn find_bytes(hay: &[u8], needle: &[u8], from: usize) -> i64 {
    if from > hay.len() {
        return -1;
    }
    let n = needle.len();
    if n == 0 {
        return from as i64;
    }
    if n > hay.len() {
        return -1;
    }
    let mut i: usize = from;
    while i + n <= hay.len() {
        if match_at(hay, needle, i) {
            return i as i64;
        }
        i += 1;
    }
    return -1;
}

// match_at reports whether `needle` sits at byte offset `at` in `hay`.
// Out-of-range offsets are a non-match, never a panic.
pub fn match_at(hay: &[u8], needle: &[u8], at: usize) -> bool {
    if at > hay.len() || needle.len() > hay.len() - at {
        return false;
    }
    let mut k: usize = 0;
    while k < needle.len() {
        if hay[at + k] != needle[k] {
            return false;
        }
        k += 1;
    }
    return true;
}

// repeat_text returns `s` concatenated `n` times.
pub fn repeat_text(s: str, n: i32) -> String {
    let mut out = String::new();
    let mut i = 0;
    while i < n {
        out.push_str(s);
        i += 1;
    }
    out
}

// exclaim returns `s` with a trailing "!".
pub fn exclaim(s: str) -> String {
    let mut out = String::from(s);
    out.push_str("!");
    out
}

// pad_start pads `s` on the left with `ch` until it is `width` bytes long.
pub fn pad_start(s: str, width: i32, ch: char) -> String {
    let mut out = String::new();
    let mut missing = width - (len(s) as i32);
    while missing > 0 {
        out.push(ch);
        missing -= 1;
    }
    out.push_str(s);
    out
}

// pad_end pads `s` on the right with `ch` until it is `width` bytes long.
pub fn pad_end(s: str, width: i32, ch: char) -> String {
    let mut out = String::from(s);
    let mut missing = width - (len(s) as i32);
    while missing > 0 {
        out.push(ch);
        missing -= 1;
    }
    out
}

// join_with returns a + sep + b.
pub fn join_with(a: str, sep: str, b: str) -> String {
    let mut out = String::from(a);
    out.push_str(sep);
    out.push_str(b);
    out
}

// shout wraps `s` in asterisks, for emphasis in plain-text output.
pub fn shout(s: str) -> String {
    let mut out = String::from("*");
    out.push_str(s);
    out.push_str("*");
    out
}

// to_upper returns an ASCII-uppercased copy of `s`.
pub fn to_upper(s: str) -> String {
    let hay = s.as_bytes();
    let mut out = String::with_capacity(hay.len());
    let mut i: usize = 0;
    while i < hay.len() {
        let b = hay[i];
        if b >= 97 && b <= 122 {
            out.push_byte(b - 32);
        } else {
            out.push_byte(b);
        }
        i += 1;
    }
    return out;
}

// to_lower returns an ASCII-lowercased copy of `s`.
pub fn to_lower(s: str) -> String {
    let hay = s.as_bytes();
    let mut out = String::with_capacity(hay.len());
    let mut i: usize = 0;
    while i < hay.len() {
        let b = hay[i];
        if b >= 65 && b <= 90 {
            out.push_byte(b + 32);
        } else {
            out.push_byte(b);
        }
        i += 1;
    }
    return out;
}

// index_of returns the byte offset of the first occurrence of `sub` in `s`,
// or -1. (String.find is the same operation on an owning String.)
pub fn index_of(s: str, sub: str) -> i64 {
    return find_bytes(s.as_bytes(), sub.as_bytes(), 0);
}

// last_index_of returns the byte offset of the last occurrence of `sub`, or -1.
pub fn last_index_of(s: str, sub: str) -> i64 {
    let hay = s.as_bytes();
    let needle = sub.as_bytes();
    let n = needle.len();
    if n == 0 {
        return hay.len() as i64;
    }
    if n > hay.len() {
        return -1;
    }
    let mut i = (hay.len() - n) as i64;
    while i >= 0 {
        if match_at(hay, needle, i as usize) {
            return i;
        }
        i -= 1;
    }
    return -1;
}

// count_occurrences counts non-overlapping occurrences of `sub` in `s`.
pub fn count_occurrences(s: str, sub: str) -> i64 {
    let hay = s.as_bytes();
    let needle = sub.as_bytes();
    if needle.len() == 0 {
        return 0;
    }
    let mut count: i64 = 0;
    let mut pos: usize = 0;
    while pos <= hay.len() {
        let at = find_bytes(hay, needle, pos);
        if at < 0 {
            break;
        }
        count += 1;
        pos = (at as usize) + needle.len();
    }
    return count;
}

// replace_all returns `s` with every occurrence of `from` replaced by `to`.
pub fn replace_all(s: str, from: str, to: str) -> String {
    let hay = s.as_bytes();
    let needle = from.as_bytes();
    let mut out = String::with_capacity(hay.len());
    if needle.len() == 0 {
        out.push_bytes(hay);
        return out;
    }
    let mut pos: usize = 0;
    while pos < hay.len() {
        let at = find_bytes(hay, needle, pos);
        if at < 0 {
            out.push_bytes(hay[pos..hay.len()]);
            break;
        }
        let start = at as usize;
        out.push_bytes(hay[pos..start]);
        out.push_str(to);
        pos = start + needle.len();
    }
    return out;
}

// slice_text returns s[start..end], clamped to the string bounds (never
// panics; an empty result means the range was out of bounds or inverted).
pub fn slice_text(s: str, start: usize, end: usize) -> String {
    let hay = s.as_bytes();
    let n = hay.len();
    let mut out = String::new();
    if start >= n || end <= start {
        return out;
    }
    let last = if end < n { end } else { n };
    out.push_bytes(hay[start..last]);
    return out;
}

// trim_start removes leading ASCII whitespace.
pub fn trim_start(s: str) -> String {
    let hay = s.as_bytes();
    let mut i: usize = 0;
    while i < hay.len() && is_space_byte(hay[i] as i64) {
        i += 1;
    }
    let mut out = String::with_capacity(hay.len() - i);
    out.push_bytes(hay[i..hay.len()]);
    return out;
}

// trim_end removes trailing ASCII whitespace.
pub fn trim_end(s: str) -> String {
    let hay = s.as_bytes();
    let mut end = hay.len();
    while end > 0 && is_space_byte(hay[end - 1] as i64) {
        end -= 1;
    }
    let mut out = String::with_capacity(end);
    out.push_bytes(hay[0..end]);
    return out;
}

// compare is a lexicographic byte comparison: negative when a < b, zero when
// equal, positive when a > b. Handy for sorting.
pub fn compare(a: str, b: str) -> i32 {
    let x = a.as_bytes();
    let y = b.as_bytes();
    let n = if x.len() < y.len() { x.len() } else { y.len() };
    let mut i: usize = 0;
    while i < n {
        if x[i] < y[i] {
            return -1;
        }
        if x[i] > y[i] {
            return 1;
        }
        i += 1;
    }
    if x.len() < y.len() {
        return -1;
    }
    if x.len() > y.len() {
        return 1;
    }
    return 0;
}

// is_digit reports whether `c` is '0'..'9'.
pub fn is_digit(c: char) -> bool {
    let b = c as i64;
    return b >= 48 && b <= 57;
}

// is_alpha reports whether `c` is an ASCII letter.
pub fn is_alpha(c: char) -> bool {
    let b = c as i64;
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
}

// is_alnum reports whether `c` is an ASCII letter or digit.
pub fn is_alnum(c: char) -> bool {
    return is_alpha(c) || is_digit(c);
}

// is_space reports whether `c` is one of space, tab, CR, LF, VT, FF.
pub fn is_space(c: char) -> bool {
    return is_space_byte(c as i64);
}

// is_digits_only reports whether `s` is non-empty and all ASCII digits.
pub fn is_digits_only(s: str) -> bool {
    let hay = s.as_bytes();
    if hay.len() == 0 {
        return false;
    }
    let mut i: usize = 0;
    while i < hay.len() {
        let b = hay[i];
        if b < 48 || b > 57 {
            return false;
        }
        i += 1;
    }
    return true;
}

// format_bool renders a bool as "true"/"false".
pub fn format_bool(b: bool) -> String {
    if b {
        return String::from("true");
    }
    return String::from("false");
}

fn is_space_byte(b: i64) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12;
}

// --- familiar convenience spellings ---------------------------------------
// These aliases keep tiny scripts readable for people coming from Python and
// other batteries-included languages. They operate on byte-oriented `str`
// input just like the rest of this ASCII-focused module.

pub fn upper(s: str) -> String { to_upper(s) }
pub fn lower(s: str) -> String { to_lower(s) }

// strip removes ASCII whitespace from both ends.
pub fn strip(s: str) -> String {
    let left = trim_start(s);
    return trim_end(left.as_str());
}

pub fn contains(s: str, sub: str) -> bool { index_of(s, sub) >= 0 }

pub fn starts_with(s: str, prefix: str) -> bool {
    let hay = s.as_bytes();
    let p = prefix.as_bytes();
    if p.len() > hay.len() {
        return false;
    }
    return match_at(hay, p, 0);
}

pub fn ends_with(s: str, suffix: str) -> bool {
    let hay = s.as_bytes();
    let sfx = suffix.as_bytes();
    if sfx.len() > hay.len() {
        return false;
    }
    return match_at(hay, sfx, hay.len() - sfx.len());
}

pub fn replace(s: str, from: str, to: str) -> String {
    return replace_all(s, from, to);
}

// is_blank reports whether s is empty or all ASCII whitespace.
pub fn is_blank(s: str) -> bool {
    let hay = s.as_bytes();
    let mut i: usize = 0;
    while i < hay.len() {
        if !is_space_byte(hay[i] as i64) {
            return false;
        }
        i += 1;
    }
    return true;
}
