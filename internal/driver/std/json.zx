// json — parse, build, and print JSON with no dependencies.
//
//     use json;
//
//     fn main() -> i32 {
//         let doc = match json::parse("{\"name\": \"zexi\", \"stars\": 7}") {
//             Ok(v) => v,
//             Err(e) => {
//                 println(e);
//                 return 1;
//             }
//         };
//         println(doc.get_str("name"));    // zexi
//         println(doc.get_int("stars"));   // 7
//         println(json::stringify(&doc));  // {"name":"zexi","stars":7}
//         0
//     }
//
// A value is a small tagged record rather than an enum: `kind` says what it
// holds and the unused fields stay empty. That keeps every accessor usable
// through a borrowed value (`&Value`), which matters because patterns cannot
// yet bind owned payloads out of a borrow. Objects keep insertion order, so the
// same document always prints the same way — handy for tests, caches, and
// stable HTTP bodies.
//
// Numbers: integers that fit in `i64` stay integers (kind INT) and print
// exactly; anything else becomes a double (kind NUM) and prints in the
// shortest form that reads back as the same value. Serialising a non-finite
// double (inf/nan) writes `null`, so the output is always valid JSON.

// Kind tags. They are plain integers so `if v.kind == json::ARR` reads clearly.
pub const NULL: i64 = 0;
pub const BOOL: i64 = 1;
pub const INT: i64 = 2;
pub const NUM: i64 = 3;
pub const STR: i64 = 4;
pub const ARR: i64 = 5;
pub const OBJ: i64 = 6;

// MAX_DEPTH bounds nesting while parsing, so a hostile document cannot exhaust
// the stack.
pub const MAX_DEPTH: i32 = 128;

extern "C" fn zxj_format_double(v: f64, buf: &mut [u8; 64], cap: i32) -> i32;
extern "C" fn zxj_parse_double(s: str, out: &mut f64) -> i32;
extern "C" fn zxj_parse_int(s: str, out: &mut i64) -> i32;
extern "C" fn zxj_utf8_encode(cp: i32, buf: &mut [u8; 4]) -> i32;

// Field is one member of a JSON object. Objects are `Vec<Field>` so their order
// is the order the document used.
pub struct Field {
    pub key: String,
    pub value: Value,
}

// Value is one JSON value.
pub struct Value {
    pub kind: i64,
    pub b: bool,
    pub i: i64,
    pub n: f64,
    pub s: String,
    pub items: Vec<Value>,
    pub fields: Vec<Field>,
}

// --- constructors ----------------------------------------------------------

// null makes the JSON `null` value.
pub fn null() -> Value {
    return Value {
        kind: NULL,
        b: false,
        i: 0,
        n: 0.0,
        s: String::new(),
        items: Vec::new(),
        fields: Vec::new(),
    };
}

pub fn of_bool(b: bool) -> Value {
    let mut v = null();
    v.kind = BOOL;
    v.b = b;
    return v;
}

pub fn of_int(n: i64) -> Value {
    let mut v = null();
    v.kind = INT;
    v.i = n;
    return v;
}

pub fn of_num(x: f64) -> Value {
    let mut v = null();
    v.kind = NUM;
    v.n = x;
    return v;
}

// of_str copies a borrowed string into an owned JSON string.
pub fn of_str(s: str) -> Value {
    let mut v = null();
    v.kind = STR;
    v.s = String::from(s);
    return v;
}

// of_string takes ownership of a String without copying it.
pub fn of_string(s: String) -> Value {
    let mut v = null();
    v.kind = STR;
    v.s = s;
    return v;
}

// array makes an empty JSON array; use `push` (or `items.push`) to fill it.
pub fn array() -> Value {
    let mut v = null();
    v.kind = ARR;
    return v;
}

// object makes an empty JSON object; use `set` to add members.
pub fn object() -> Value {
    let mut v = null();
    v.kind = OBJ;
    return v;
}

// --- inspection ------------------------------------------------------------

impl Value {
    pub fn is_null(&self) -> bool {
        return self.kind == NULL;
    }

    pub fn is_bool(&self) -> bool {
        return self.kind == BOOL;
    }

    pub fn is_int(&self) -> bool {
        return self.kind == INT;
    }

    pub fn is_num(&self) -> bool {
        return self.kind == NUM;
    }

    pub fn is_number(&self) -> bool {
        return self.kind == INT || self.kind == NUM;
    }

    pub fn is_str(&self) -> bool {
        return self.kind == STR;
    }

    pub fn is_array(&self) -> bool {
        return self.kind == ARR;
    }

    pub fn is_object(&self) -> bool {
        return self.kind == OBJ;
    }

    pub fn as_bool(&self) -> bool {
        if self.kind == BOOL {
            return self.b;
        }
        return false;
    }

    // as_i64 reads an integer, truncating a double and yielding 0 otherwise.
    pub fn as_i64(&self) -> i64 {
        if self.kind == INT {
            return self.i;
        }
        if self.kind == NUM {
            return self.n as i64;
        }
        return 0;
    }

    pub fn as_f64(&self) -> f64 {
        if self.kind == INT {
            return self.i as f64;
        }
        if self.kind == NUM {
            return self.n;
        }
        return 0.0;
    }

    // text is the string payload ("" for every other kind).
    pub fn text(&self) -> String {
        if self.kind == STR {
            return self.s.clone();
        }
        return String::new();
    }

    // len is the number of array items or object members (0 otherwise).
    pub fn len(&self) -> usize {
        if self.kind == ARR {
            return self.items.len();
        }
        if self.kind == OBJ {
            return self.fields.len();
        }
        return 0;
    }

    pub fn is_empty(&self) -> bool {
        return self.len() == 0;
    }

    // item is element i of an array (null when out of range).
    pub fn item(&self, i: usize) -> Value {
        if self.kind != ARR || i >= self.items.len() {
            return null();
        }
        return self.items[i].clone();
    }

    // index_of is the position of `key` in an object, or -1.
    pub fn index_of(&self, key: str) -> i64 {
        if self.kind != OBJ {
            return -1;
        }
        let want = String::from(key);
        let mut i: usize = 0;
        while i < self.fields.len() {
            if self.fields[i].key.as_str() == want.as_str() {
                return i as i64;
            }
            i += 1;
        }
        return -1;
    }

    // has reports whether an object has a member with this key.
    pub fn has(&self, key: str) -> bool {
        return self.index_of(key) >= 0;
    }

    // key_at is the name of member i of an object ("" when out of range), so an
    // object can be walked:
    //
    //     let mut i: usize = 0;
    //     while i < doc.len() {
    //         println(doc.key_at(i), doc.value_at(i).as_i64());
    //         i += 1;
    //     }
    pub fn key_at(&self, i: usize) -> String {
        if self.kind != OBJ || i >= self.fields.len() {
            return String::new();
        }
        return self.fields[i].key.clone();
    }

    // value_at is a copy of member i's value (null when out of range).
    pub fn value_at(&self, i: usize) -> Value {
        if self.kind != OBJ || i >= self.fields.len() {
            return null();
        }
        return self.fields[i].value.clone();
    }

    // get is the member named `key` (null when absent).
    pub fn get(&self, key: str) -> Value {
        let i = self.index_of(key);
        if i < 0 {
            return null();
        }
        return self.fields[i as usize].value.clone();
    }

    // get_str is `get(key).text()` -- the usual way to read a JSON string.
    pub fn get_str(&self, key: str) -> String {
        return self.get(key).text();
    }

    // get_int reads a member as an integer, with `fallback` when it is absent
    // or not a number.
    pub fn get_int(&self, key: str, fallback: i64 = 0) -> i64 {
        let v = self.get(key);
        if !v.is_number() {
            return fallback;
        }
        return v.as_i64();
    }

    pub fn get_f64(&self, key: str, fallback: f64 = 0.0) -> f64 {
        let v = self.get(key);
        if !v.is_number() {
            return fallback;
        }
        return v.as_f64();
    }

    pub fn get_bool(&self, key: str, fallback: bool = false) -> bool {
        let v = self.get(key);
        if !v.is_bool() {
            return fallback;
        }
        return v.b;
    }

    // push appends to an array (and converts an empty object/other value into
    // an array first, so builders do not need to check kind).
    pub fn push(&mut self, v: Value) {
        if self.kind != ARR {
            self.kind = ARR;
            self.items.clear();
        }
        self.items.push(v);
    }

    pub fn push_str(&mut self, s: str) {
        self.push(of_str(s));
    }

    pub fn push_int(&mut self, n: i64) {
        self.push(of_int(n));
    }

    // set inserts or replaces a member, converting the value into an object
    // when needed. It returns false only when `key` is empty.
    pub fn set(&mut self, key: str, v: Value) -> bool {
        if len(key) == 0 {
            return false;
        }
        if self.kind != OBJ {
            self.kind = OBJ;
            self.fields.clear();
        }
        let want = String::from(key);
        let mut found: i64 = -1;
        let mut i: usize = 0;
        while i < self.fields.len() {
            if self.fields[i].key.as_str() == want.as_str() {
                found = i as i64;
                break;
            }
            i += 1;
        }
        if found >= 0 {
            self.fields[found as usize].value = v;
        } else {
            self.fields.push(Field { key: want, value: v });
        }
        return true;
    }

    pub fn set_str(&mut self, key: str, s: str) -> bool {
        return self.set(key, of_str(s));
    }

    pub fn set_int(&mut self, key: str, n: i64) -> bool {
        return self.set(key, of_int(n));
    }

    pub fn set_f64(&mut self, key: str, x: f64) -> bool {
        return self.set(key, of_num(x));
    }

    pub fn set_bool(&mut self, key: str, b: bool) -> bool {
        return self.set(key, of_bool(b));
    }

    pub fn set_null(&mut self, key: str) -> bool {
        return self.set(key, null());
    }

    // remove deletes a member and returns its value (null when absent).
    pub fn remove(&mut self, key: str) -> Value {
        let i = self.index_of(key);
        if i < 0 {
            return null();
        }
        return self.fields.remove(i as usize).value;
    }

    // clone is a deep copy: the result owns its own strings and arrays.
    pub fn clone(&self) -> Value {
        let mut out = null();
        out.kind = self.kind;
        out.b = self.b;
        out.i = self.i;
        out.n = self.n;
        out.s = self.s.clone();
        if self.kind == ARR {
            let mut i: usize = 0;
            while i < self.items.len() {
                out.items.push(self.items[i].clone());
                i += 1;
            }
        }
        if self.kind == OBJ {
            let mut i: usize = 0;
            while i < self.fields.len() {
                out.fields.push(Field {
                    key: self.fields[i].key.clone(),
                    value: self.fields[i].value.clone(),
                });
                i += 1;
            }
        }
        return out;
    }
}

// --- printing --------------------------------------------------------------

// quote renders a string as a JSON string literal, quotes included. It escapes
// the characters JSON requires and leaves UTF-8 bytes alone.
pub fn quote(s: str) -> String {
    let mut out = String::with_capacity(len(s) + 2);
    let owned = String::from(s);
    out.push_byte(34); // "
    let mut i: usize = 0;
    while i < owned.len() {
        let c = owned.byte_at(i) as u8;
        if c == 34 {
            out.push_str("\\\"");
        } else if c == 92 {
            out.push_str("\\\\");
        } else if c == 10 {
            out.push_str("\\n");
        } else if c == 13 {
            out.push_str("\\r");
        } else if c == 9 {
            out.push_str("\\t");
        } else if c == 8 {
            out.push_str("\\b");
        } else if c == 12 {
            out.push_str("\\f");
        } else if c < 32 {
            out.push_str("\\u00");
            out.push_byte(hex_digit((c / 16) as i64));
            out.push_byte(hex_digit((c % 16) as i64));
        } else {
            out.push_byte(c);
        }
        i += 1;
    }
    out.push_byte(34);
    return out;
}

fn hex_digit(n: i64) -> u8 {
    if n < 10 {
        return (48 + n) as u8; // '0'..'9'
    }
    return (87 + n) as u8; // 'a'..'f'
}

// num_text renders a double in the shortest round-tripping form.
fn num_text(x: f64) -> String {
    let mut buf: [u8; 64] = [0; 64];
    let n = zxj_format_double(x, &mut buf, 64);
    let mut out = String::new();
    let mut i: usize = 0;
    while i < (n as usize) {
        out.push_byte(buf[i]);
        i += 1;
    }
    return out;
}

fn scalar_text(v: &Value) -> String {
    if v.kind == BOOL {
        if v.b {
            return String::from("true");
        }
        return String::from("false");
    }
    if v.kind == INT {
        let mut out = String::new();
        out += v.i;
        return out;
    }
    if v.kind == NUM {
        return num_text(v.n);
    }
    if v.kind == STR {
        return quote(v.s.as_str());
    }
    return String::from("null");
}

fn write_value(v: &Value, out: &mut String, indent: i32, level: i32) {
    if v.kind != ARR && v.kind != OBJ {
        out.push_str(scalar_text(v).as_str());
        return;
    }
    if v.kind == ARR {
        if v.items.len() == 0 {
            out.push_str("[]");
            return;
        }
        out.push_str("[");
        let mut i: usize = 0;
        while i < v.items.len() {
            if i > 0 {
                out.push_str(",");
            }
            newline_indent(out, indent, level + 1);
            write_value(&v.items[i], out, indent, level + 1);
            i += 1;
        }
        newline_indent(out, indent, level);
        out.push_str("]");
        return;
    }
    if v.fields.len() == 0 {
        out.push_str("{}");
        return;
    }
    out.push_str("{");
    let mut i: usize = 0;
    while i < v.fields.len() {
        if i > 0 {
            out.push_str(",");
        }
        newline_indent(out, indent, level + 1);
        out.push_str(quote(v.fields[i].key.as_str()).as_str());
        out.push_str(":");
        if indent >= 0 {
            out.push_str(" ");
        }
        write_value(&v.fields[i].value, out, indent, level + 1);
        i += 1;
    }
    newline_indent(out, indent, level);
    out.push_str("}");
}

// newline_indent writes a newline plus indentation, or nothing when indent is
// negative (compact output).
fn newline_indent(out: &mut String, indent: i32, level: i32) {
    if indent < 0 {
        return;
    }
    out.push_byte(10);
    let mut i: i32 = 0;
    while i < indent * level {
        out.push_byte(32);
        i += 1;
    }
}

// stringify renders a value as compact JSON.
pub fn stringify(v: &Value) -> String {
    let mut out = String::new();
    write_value(v, &mut out, -1, 0);
    return out;
}

// pretty renders a value with `indent` spaces per nesting level.
pub fn pretty(v: &Value, indent: i32 = 2) -> String {
    let mut out = String::new();
    write_value(v, &mut out, indent, 0);
    return out;
}

// --- parsing ---------------------------------------------------------------

struct Parser {
    raw: String,
    pos: usize,
    depth: i32,
}

fn err_at(pos: usize, what: str) -> String {
    let mut msg = String::from("json: ");
    msg.push_str(what);
    msg.push_str(" at byte ");
    msg += pos as i64;
    return msg;
}

impl Parser {
    fn peek(&self) -> i64 {
        if self.pos >= self.raw.len() {
            return -1;
        }
        return self.raw.byte_at(self.pos);
    }

    fn bump(&mut self) -> i64 {
        let c = self.peek();
        if c >= 0 {
            self.pos += 1;
        }
        return c;
    }

    fn skip_ws(&mut self) {
        loop {
            let c = self.peek();
            if c == 32 || c == 9 || c == 10 || c == 13 {
                self.pos += 1;
                continue;
            }
            break;
        }
    }

    // value dispatches on the next byte.
    fn value(&mut self) -> Result<Value, String> {
        if self.depth > MAX_DEPTH {
            return Err(err_at(self.pos, "document nests too deeply"));
        }
        self.skip_ws();
        let c = self.peek();
        if c < 0 {
            return Err(err_at(self.pos, "unexpected end of input"));
        }
        if c == 123 {
            return self.object();
        }
        if c == 91 {
            return self.array();
        }
        if c == 34 {
            let text = self.string()?;
            return Ok(of_string(text));
        }
        if c == 116 {
            return self.literal("true", of_bool(true));
        }
        if c == 102 {
            return self.literal("false", of_bool(false));
        }
        if c == 110 {
            return self.literal("null", null());
        }
        return self.number();
    }

    fn literal(&mut self, word: str, v: Value) -> Result<Value, String> {
        let got = self.raw.substr(self.pos, len(word));
        if got.as_str() != word {
            return Err(err_at(self.pos, "unknown literal"));
        }
        self.pos += len(word);
        return Ok(v);
    }

    fn string(&mut self) -> Result<String, String> {
        if self.bump() != 34 {
            return Err(err_at(self.pos, "expected a string"));
        }
        let mut out = String::new();
        loop {
            let c = self.bump();
            if c < 0 {
                return Err(err_at(self.pos, "unterminated string"));
            }
            if c == 34 {
                return Ok(out);
            }
            if c == 92 {
                let e = self.bump();
                if e == 34 {
                    out.push_byte(34);
                } else if e == 92 {
                    out.push_byte(92);
                } else if e == 47 {
                    out.push_byte(47);
                } else if e == 98 {
                    out.push_byte(8);
                } else if e == 102 {
                    out.push_byte(12);
                } else if e == 110 {
                    out.push_byte(10);
                } else if e == 114 {
                    out.push_byte(13);
                } else if e == 116 {
                    out.push_byte(9);
                } else if e == 117 {
                    let hi = self.hex4()?;
                    let mut cp = hi;
                    if hi >= 55296 && hi <= 56319 && self.peek() == 92 {
                        let save = self.pos;
                        self.pos += 1;
                        if self.peek() == 117 {
                            self.pos += 1;
                            let lo = self.hex4()?;
                            if lo >= 56320 && lo <= 57343 {
                                cp = 65536 + (hi - 55296) * 1024 + (lo - 56320);
                            } else {
                                self.pos = save;
                            }
                        } else {
                            self.pos = save;
                        }
                    }
                    self.push_codepoint(&mut out, cp);
                } else {
                    return Err(err_at(self.pos, "unknown escape"));
                }
                continue;
            }
            if c < 32 {
                return Err(err_at(self.pos, "raw control character in string"));
            }
            out.push_byte(c as u8);
        }
    }

    fn push_codepoint(&self, out: &mut String, cp: i64) {
        let mut buf: [u8; 4] = [0; 4];
        let n = zxj_utf8_encode(cp as i32, &mut buf);
        let mut i: usize = 0;
        while i < (n as usize) {
            out.push_byte(buf[i]);
            i += 1;
        }
    }

    fn hex4(&mut self) -> Result<i64, String> {
        let mut v: i64 = 0;
        let mut i: i32 = 0;
        while i < 4 {
            let c = self.bump();
            let d = hex_value(c);
            if d < 0 {
                return Err(err_at(self.pos, "bad \\u escape"));
            }
            v = v * 16 + d;
            i += 1;
        }
        return Ok(v);
    }

    fn number(&mut self) -> Result<Value, String> {
        let start = self.pos;
        let mut is_int = true;
        let mut c = self.peek();
        if c == 45 {
            self.pos += 1;
            c = self.peek();
        }
        let mut digits: i32 = 0;
        loop {
            c = self.peek();
            if c >= 48 && c <= 57 {
                self.pos += 1;
                digits += 1;
                continue;
            }
            break;
        }
        if c == 46 {
            is_int = false;
            self.pos += 1;
            loop {
                c = self.peek();
                if c >= 48 && c <= 57 {
                    self.pos += 1;
                    digits += 1;
                    continue;
                }
                break;
            }
        }
        if c == 101 || c == 69 {
            is_int = false;
            self.pos += 1;
            c = self.peek();
            if c == 43 || c == 45 {
                self.pos += 1;
            }
            loop {
                c = self.peek();
                if c >= 48 && c <= 57 {
                    self.pos += 1;
                    digits += 1;
                    continue;
                }
                break;
            }
        }
        if digits == 0 {
            return Err(err_at(start, "expected a value"));
        }
        let text = self.raw.substr(start, self.pos - start);
        if is_int {
            let mut iv: i64 = 0;
            if zxj_parse_int(text.as_str(), &mut iv) == 0 {
                return Ok(of_int(iv));
            }
        }
        let mut xv: f64 = 0.0;
        if zxj_parse_double(text.as_str(), &mut xv) != 0 {
            return Err(err_at(start, "number out of range"));
        }
        return Ok(of_num(xv));
    }

    fn array(&mut self) -> Result<Value, String> {
        self.pos += 1; // [
        self.depth += 1;
        let mut out = array();
        self.skip_ws();
        if self.peek() == 93 {
            self.pos += 1;
            self.depth -= 1;
            return Ok(out);
        }
        loop {
            let item = self.value()?;
            out.items.push(item);
            self.skip_ws();
            let c = self.bump();
            if c == 44 {
                continue;
            }
            if c == 93 {
                break;
            }
            return Err(err_at(self.pos, "expected `,` or `]`"));
        }
        self.depth -= 1;
        return Ok(out);
    }

    fn object(&mut self) -> Result<Value, String> {
        self.pos += 1; // {
        self.depth += 1;
        let mut out = object();
        self.skip_ws();
        if self.peek() == 125 {
            self.pos += 1;
            self.depth -= 1;
            return Ok(out);
        }
        loop {
            self.skip_ws();
            let key = self.string()?;
            self.skip_ws();
            if self.bump() != 58 {
                return Err(err_at(self.pos, "expected `:`"));
            }
            let v = self.value()?;
            out.fields.push(Field { key: key, value: v });
            self.skip_ws();
            let c = self.bump();
            if c == 44 {
                continue;
            }
            if c == 125 {
                break;
            }
            return Err(err_at(self.pos, "expected `,` or `}`"));
        }
        self.depth -= 1;
        return Ok(out);
    }
}

fn hex_value(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    if c >= 65 && c <= 70 {
        return c - 55;
    }
    return -1;
}

// parse turns JSON text into a Value. Errors carry the byte offset where the
// document stopped making sense.
pub fn parse(raw: str) -> Result<Value, String> {
    let mut p = Parser { raw: String::from(raw), pos: 0, depth: 0 };
    let v = p.value()?;
    p.skip_ws();
    if p.pos < p.raw.len() {
        return Err(err_at(p.pos, "trailing data after the document"));
    }
    return Ok(v);
}

// valid reports whether raw parses.
pub fn valid(raw: str) -> bool {
    match parse(raw) {
        Ok(_) => true,
        Err(_) => false,
    }
}

// Number conversion is the one place JSON needs libc: `%.17g`-style output
// round-trips and `strtod`/`strtoll` validate a complete token, neither of
// which the language runtime provides. The C travels with this file, so
// importing `json` is all a program has to do.
c """
#define ZXJ_BYTES(buf) ((char *)((buf)->e))

#include <errno.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* zxj_format_double writes a compact round-tripping form of v into buf.
 * Returns the length written, or -1 when the buffer is too small. */
int32_t zxj_format_double(double v, zx_arr64_u8 *buf, int32_t cap) {
    if (!buf || cap <= 0) return -1;
    char *out = ZXJ_BYTES(buf);
    char tmp[64];
    int n = -1;
    for (int prec = 1; prec <= 17; prec++) {
        snprintf(tmp, sizeof tmp, "%.*g", prec, v);
        char *end = NULL;
        double back = strtod(tmp, &end);
        if (end && *end == '\0' && back == v) {
            n = (int)strlen(tmp);
            break;
        }
    }
    if (n < 0) {
        snprintf(tmp, sizeof tmp, "%.17g", v);
        n = (int)strlen(tmp);
    }
    if (n >= cap) return -1;
    memcpy(out, tmp, (size_t)n);
    out[n] = '\0';
    return n;
}

/* zxj_parse_double parses a whole number token. Returns 0 on success. */
int32_t zxj_parse_double(const char *s, double *out) {
    if (!s || !out) return -1;
    errno = 0;
    char *end = NULL;
    double v = strtod(s, &end);
    if (end == s || (end && *end != '\0')) return -1;
    if (errno == ERANGE) return -1;
    *out = v;
    return 0;
}

/* zxj_parse_int parses a whole integer token into an int64. Returns 0 on
 * success, -1 on syntax error, -2 when it does not fit. */
int32_t zxj_parse_int(const char *s, int64_t *out) {
    if (!s || !out) return -1;
    errno = 0;
    char *end = NULL;
    long long v = strtoll(s, &end, 10);
    if (end == s || (end && *end != '\0')) return -1;
    if (errno == ERANGE) return -2;
    *out = (int64_t)v;
    return 0;
}

/* zxj_utf8_encode writes the UTF-8 form of code point cp into buf and returns
 * its length (1..4), or 0 when cp is not a valid scalar value. Used for JSON
 * \uXXXX escapes. */
int32_t zxj_utf8_encode(int32_t cp, zx_arr4_u8 *buf) {
    if (!buf) return 0;
    char *out = ZXJ_BYTES(buf);
    if (cp < 0 || cp > 0x10FFFF) return 0;
    if (cp >= 0xD800 && cp <= 0xDFFF) return 0; /* surrogate half */
    if (cp < 0x80) {
        out[0] = (char)cp;
        return 1;
    }
    if (cp < 0x800) {
        out[0] = (char)(0xC0 | (cp >> 6));
        out[1] = (char)(0x80 | (cp & 0x3F));
        return 2;
    }
    if (cp < 0x10000) {
        out[0] = (char)(0xE0 | (cp >> 12));
        out[1] = (char)(0x80 | ((cp >> 6) & 0x3F));
        out[2] = (char)(0x80 | (cp & 0x3F));
        return 3;
    }
    out[0] = (char)(0xF0 | (cp >> 18));
    out[1] = (char)(0x80 | ((cp >> 12) & 0x3F));
    out[2] = (char)(0x80 | ((cp >> 6) & 0x3F));
    out[3] = (char)(0x80 | (cp & 0x3F));
    return 4;
}
"""
