// io — console input/output, part of the Zexi standard library.
// Import with `use io;`, `use std::io;`, or `import io;`.
//
// Every operation can fail, so reads and writes return `Result<_, IoError>`.
// `IoError` lives in `sys` (which this module builds on): `Interrupted`,
// `NotFound`, `Permission`, `IsDir`, `TooLarge`, `Eof`, or `Other(errno)`.

use sys;

pub const STDIN: i32 = 0;
pub const STDOUT: i32 = 1;
pub const STDERR: i32 = 2;

// read_byte reads exactly one byte. End of input is `Err(IoError::Eof)` rather
// than a magic value, so an empty read and an error can never be confused.
pub fn read_byte() -> Result<u8, IoError> {
    let mut buf: [u8; 1] = [0; 1];
    match sys::read_fd(STDIN, &mut buf) {
        Ok(n) => {
            if n == 0 {
                return Err(IoError::Eof);
            }
            return Ok(buf[0]);
        }
        Err(e) => return Err(e),
    }
}

// read_line reads one line from standard input without its trailing newline.
// At end of input it returns `Ok("")`; carriage returns are ignored so CRLF
// input behaves. Interrupted reads are retried.
pub fn read_line() -> Result<String, IoError> {
    let mut out = String::new();
    read_line_into(&mut out)?;
    return Ok(out);
}

// read_line_into appends one line (without its newline) to `buf` and returns
// the number of bytes appended. At end of input it returns `Ok(0)`.
pub fn read_line_into(buf: &mut String) -> Result<usize, IoError> {
    let start = buf.len();
    loop {
        match read_byte() {
            Ok(b) => {
                if b == 10 {
                    break;
                }
                if b != 13 {
                    buf.push_byte(b);
                }
            }
            Err(e) => {
                match e {
                    IoError::Eof => break,
                    IoError::Interrupted => { /* retry */ }
                    _ => return Err(e),
                }
            }
        }
    }
    return Ok(buf.len() - start);
}

// read_all reads standard input to end of file (a pipe, a redirected file, or
// Ctrl-D) and returns everything read.
pub fn read_all() -> Result<String, IoError> {
    let mut out = String::with_capacity(4096);
    let mut buf: [u8; 4096] = [0; 4096];
    loop {
        match sys::read_fd(STDIN, &mut buf) {
            Ok(n) => {
                if n == 0 {
                    return Ok(out);
                }
                out.push_bytes(buf[0..n]);
            }
            Err(e) => {
                match e {
                    IoError::Interrupted => { /* retry */ }
                    _ => return Err(e),
                }
            }
        }
    }
}

// write writes every byte of `buf` to standard output and returns the count.
pub fn write(buf: &[u8]) -> Result<usize, IoError> {
    return sys::write_fd(STDOUT, buf);
}

// write_err writes every byte of `buf` to standard error.
pub fn write_err(buf: &[u8]) -> Result<usize, IoError> {
    return sys::write_fd(STDERR, buf);
}

// eprint writes a message to standard error (no newline added). A write failure
// is intentionally ignored: there is nowhere to report it that is not stderr.
pub fn eprint(s: str) {
    let ignored = sys::write_str_fd(STDERR, s);
}

// eprintln writes a message to standard error, followed by a newline.
pub fn eprintln(s: str) {
    eprint(s);
    eprint("\n");
}

// input prints an optional prompt (no newline), then reads a line.
pub fn input(prompt: str = "") -> Result<String, IoError> {
    if len(prompt) > 0 {
        let ignored = sys::write_str_fd(STDOUT, prompt);
    }
    return read_line();
}
