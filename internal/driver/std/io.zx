// io — console input/output, part of the Zexi standard library.
// Import with `use io;`, `use std::io;`, or `import io;`.

/* The syscall wrappers live in this module's own C so the ABI names cannot
 * collide with <unistd.h> declarations in a program that links several
 * modules (http, say), whose file descriptors have a different signature. */
c """
#include <unistd.h>
int64_t zxi_read(int zx_fd, zx_arr4096_u8 * zx_buf, size_t zx_n) { return read(zx_fd, zx_buf, zx_n); }
int64_t zxi_write(int zx_fd, const char *zx_buf, size_t zx_n) { return write(zx_fd, zx_buf, zx_n); }
"""

extern "C" fn zxi_read(fd: i32, buf: &mut [u8; 4096], n: usize) -> i64;
extern "C" fn zxi_write(fd: i32, buf: str, n: usize) -> i64;

// read_line reads one line from standard input (without the trailing
// newline) and returns it as a String. At end of input it returns "".
// Bytes are read one at a time, which is plenty for interactive input;
// carriage returns are ignored so CRLF input behaves.
pub fn read_line() -> String {
    let mut buf: [u8; 4096] = [0; 4096];
    let mut out = String::new();
    let mut done = false;
    while !done {
        let n = zxi_read(0, &mut buf, 1);
        if n <= 0 {
            done = true;
        } else if buf[0] == 10 {
            done = true;
        } else if buf[0] != 13 {
            out.push_byte(buf[0]);
        }
    }
    out
}

// prompt_line prints a prompt (no newline), then reads a line of input.
pub fn prompt_line(prompt: str) -> String {
    print(prompt);
    read_line()
}

// read_all reads standard input to end of file (a pipe, a redirected file,
// or Ctrl-D) and returns everything read.
pub fn read_all() -> String {
    let mut buf: [u8; 4096] = [0; 4096];
    let mut out = String::with_capacity(4096);
    let mut done = false;
    while !done {
        let n = zxi_read(0, &mut buf, 4096);
        if n <= 0 {
            done = true;
        } else {
            let mut i: usize = 0;
            while i < (n as usize) {
                out.push_byte(buf[i]);
                i += 1;
            }
        }
    }
    return out;
}

// print_err writes a message to standard error (no newline added).
pub fn print_err(s: str) {
    let n = len(s);
    zxi_write(2, s, n);
}

// eprintln_err writes a message to standard error, followed by a newline.
pub fn eprintln_err(s: str) {
    print_err(s);
    zxi_write(2, "\n", 1);
}

// input is a Python-shaped convenience wrapper around read_line. It accepts an
// optional prompt and returns the line without its trailing newline.
pub fn input(prompt: str = "") -> String {
    if len(prompt) > 0 {
        print(prompt);
    }
    return read_line();
}
