// fs — small, binary-safe file helpers for the Zexi standard library.
// Import with `use fs;`, `use io::fs;`, or `import io.fs;`.
//
// A String is Zexi's owning byte buffer, so read_bytes/read_text preserve NUL
// bytes and work for both ordinary text and small binary assets. Reads are
// capped to keep a malformed or unexpectedly large file from exhausting memory.

// net owns the shared opt-in POSIX C ABI declarations used below.
use net;

pub const FS_MAX_BYTES: usize = 33554432;
const FS_BUFFER_BYTES: usize = 8192;

// path_exists reports whether path names a regular file.
pub fn path_exists(path: str) -> bool {
    return zxn_file_size(path) >= 0;
}

// file_len returns a regular file's byte length, or -1 when it does not exist
// (or is not a regular file).
pub fn file_len(path: str) -> i64 {
    return zxn_file_size(path);
}

// read_bytes returns a whole file as an owning byte String. Missing files and
// files above FS_MAX_BYTES yield an empty String; call path_exists/file_len
// first when an empty file must be distinguished from an error.
pub fn read_bytes(path: str) -> String {
    let size = zxn_file_size(path);
    if size < 0 || size > FS_MAX_BYTES as i64 {
        return String::new();
    }
    let mut out = String::with_capacity(size as usize);
    let handle = zxn_file_open(path);
    if handle >= 0 {
        let mut buf: [u8; 8192] = [0; 8192];
        let mut done = false;
        while !done && out.len() < FS_MAX_BYTES {
            let left = FS_MAX_BYTES - out.len();
            let want = if left < FS_BUFFER_BYTES { left } else { FS_BUFFER_BYTES };
            let n = zxn_file_read(handle, &mut buf, want as i32);
            if n <= 0 {
                done = true;
            } else {
                let mut i: usize = 0;
                while i < n as usize {
                    out.push_byte(buf[i]);
                    i += 1;
                }
            }
        }
        zxn_file_close(handle);
    }
    return out;
}

// read_text is an alias for read_bytes. Zexi does not transcode file data:
// UTF-8 text stays text, and binary bytes (including NUL) are preserved.
pub fn read_text(path: str) -> String {
    return read_bytes(path);
}

// write_bytes writes every byte in an owning String, including embedded NUL
// bytes, up to FS_MAX_BYTES. It returns bytes written or -1. Parent directories
// are not created automatically. Taking &String is deliberate: `str` is
// C-ABI-shaped and has no independent byte length.
pub fn write_bytes(path: str, data: &String) -> i32 {
    let n = data.len();
    if n > FS_MAX_BYTES {
        return -1;
    }
    return zxn_write_file(path, data.as_str(), n as i32);
}

// write_text accepts a borrowed text string and writes its visible byte length.
pub fn write_text(path: str, data: str) -> i32 {
    let n = len(data);
    if n > FS_MAX_BYTES {
        return -1;
    }
    return zxn_write_file(path, data, n as i32);
}

// copy_file copies a capped regular file. It returns the bytes written, or -1
// for a missing, too-large, or unwritable file.
pub fn copy_file(from: str, to: str) -> i32 {
    let size = file_len(from);
    if size < 0 || size > FS_MAX_BYTES as i64 {
        return -1;
    }
    let data = read_bytes(from);
    // Detect a concurrent truncation/read failure instead of silently copying a
    // partial file. (The size is bounded above, so this cast is safe here.)
    if data.len() != size as usize {
        return -1;
    }
    return write_bytes(to, &data);
}
