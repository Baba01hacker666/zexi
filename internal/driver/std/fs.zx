// fs — small, binary-safe file helpers for the Zexi standard library.
// Import with `use fs;`, `use io::fs;`, or `import io.fs;`.
//
// A String is Zexi's owning byte buffer, so `read` preserves NUL bytes and works
// for both ordinary text and small binary assets. Every operation that can fail
// returns `Result<_, IoError>`, where `IoError` comes from `sys`.

use sys;

// MAX_BYTES caps a single read or write so a malformed or unexpectedly large
// file cannot exhaust memory.
pub const MAX_BYTES: usize = 33554432;

// FileKind is what a path names.
pub enum FileKind {
    File,
    Dir,
    Other,
}

// Metadata is the small, portable subset of a stat result the library exposes.
pub struct Metadata {
    pub size: u64,
    pub kind: FileKind,
}

// exists reports whether path names a file or directory.
pub fn exists(path: str) -> bool {
    return sys::path_kind(path) != 0;
}

// file_len returns a regular file's byte length.
pub fn file_len(path: str) -> Result<u64, IoError> {
    return sys::file_size(path);
}

// read reads a whole file into an owning byte String. Text stays text and
// binary bytes (including NUL) are preserved.
pub fn read(path: str) -> Result<String, IoError> {
    let size = sys::file_size(path)?;
    if size > MAX_BYTES as u64 {
        return Err(IoError::TooLarge);
    }
    let fd = sys::open_read(path)?;
    let mut out = String::with_capacity(size as usize);
    let mut buf: [u8; 8192] = [0; 8192];
    loop {
        match sys::read_fd(fd, &mut buf) {
            Ok(n) => {
                if n == 0 {
                    break;
                }
                if out.len() + n > MAX_BYTES {
                    let closed = sys::close_fd(fd);
                    return Err(IoError::TooLarge);
                }
                out.push_bytes(buf[0..n]);
            }
            Err(e) => {
                let closed = sys::close_fd(fd);
                return Err(e);
            }
        }
    }
    sys::close_fd(fd)?;
    return Ok(out);
}

// write writes every byte in `data` (up to MAX_BYTES) and returns the count.
// Parent directories are not created automatically.
pub fn write(path: str, data: &[u8]) -> Result<usize, IoError> {
    if data.len() > MAX_BYTES {
        return Err(IoError::TooLarge);
    }
    let fd = sys::open_write(path)?;
    match sys::write_fd(fd, data) {
        Ok(n) => {
            sys::close_fd(fd)?;
            return Ok(n);
        }
        Err(e) => {
            let closed = sys::close_fd(fd);
            return Err(e);
        }
    }
}

// append writes every byte in `data` to the end of `path`, creating the file
// when it does not exist, and returns the count.
pub fn append(path: str, data: &[u8]) -> Result<usize, IoError> {
    if data.len() > MAX_BYTES {
        return Err(IoError::TooLarge);
    }
    let fd = sys::open_append(path)?;
    match sys::write_fd(fd, data) {
        Ok(n) => {
            sys::close_fd(fd)?;
            return Ok(n);
        }
        Err(e) => {
            let closed = sys::close_fd(fd);
            return Err(e);
        }
    }
}
// copy copies a regular file, streaming through a fixed buffer, and returns the
// bytes written.
pub fn copy(from: str, to: str) -> Result<u64, IoError> {
    let src = sys::open_read(from)?;
    let dst = match sys::open_write(to) {
        Ok(fd) => fd,
        Err(e) => {
            let closed = sys::close_fd(src);
            return Err(e);
        }
    };
    let mut buf: [u8; 8192] = [0; 8192];
    let mut total: u64 = 0;
    loop {
        let n = match sys::read_fd(src, &mut buf) {
            Ok(n) => n,
            Err(e) => {
                let a = sys::close_fd(src);
                let b = sys::close_fd(dst);
                return Err(e);
            }
        };
        if n == 0 {
            break;
        }
        if total + (n as u64) > MAX_BYTES as u64 {
            let a = sys::close_fd(src);
            let b = sys::close_fd(dst);
            return Err(IoError::TooLarge);
        }
        match sys::write_fd(dst, buf[0..n]) {
            Ok(written) => total += written as u64,
            Err(e) => {
                let a = sys::close_fd(src);
                let b = sys::close_fd(dst);
                return Err(e);
            }
        }
    }
    sys::close_fd(src)?;
    sys::close_fd(dst)?;
    return Ok(total);
}

// remove removes a regular file or an empty directory. It never recurses.
pub fn remove(path: str) -> Result<(), IoError> {
    return sys::remove_path_status(path);
}

// list_dir returns the names of the entries in `path` (excluding "." and "..").
pub fn list_dir(path: str) -> Result<Vec<String>, IoError> {
    let d = sys::open_dir(path);
    if d < 0 {
        return Err(sys::error_of(sys::errno()));
    }
    let mut out: Vec<String> = Vec::new();
    let mut buf: [u8; 4096] = [0; 4096];
    loop {
        let n = sys::read_dir(d, &mut buf);
        if n < 0 {
            let e = sys::errno();
            let closed = sys::close_dir(d);
            return Err(sys::error_of(e));
        }
        if n == 0 {
            break;
        }
        let mut name = String::with_capacity(n as usize);
        name.push_bytes(buf[0..n as usize]);
        out.push(name);
    }
    let closed = sys::close_dir(d);
    return Ok(out);
}

// create_dir creates one directory level, treating an already-existing directory
// as success. It does not create missing parents.
pub fn create_dir(path: str) -> Result<(), IoError> {
    if sys::mkdir(path) == 0 {
        return Ok(());
    }
    return Err(sys::error_of(sys::errno()));
}

// create_dir_all creates `path` and any missing parents. It treats an existing
// directory at any level as success.
pub fn create_dir_all(path: str) -> Result<(), IoError> {
    let mut cur = String::from(path);
    // Drop trailing slashes (but keep the root "/" itself).
    while cur.len() > 1 && cur.byte_at(cur.len() - 1) == 47 {
        cur = cur.substr(0, cur.len() - 1);
    }
    if cur.len() == 0 {
        return Ok(());
    }
    let bytes = cur.as_bytes();
    let mut prefix = String::new();
    let mut i: usize = 0;
    if bytes.len() > 0 && bytes[0] == 47 {
        prefix.push_byte(47);
        i = 1;
    }
    while i < bytes.len() {
        prefix.push_byte(bytes[i]);
        if bytes[i] == 47 || i == bytes.len() - 1 {
            // Skip empty components (e.g. a double slash) and the root itself.
            if prefix.len() > 1 || (prefix.len() == 1 && prefix.byte_at(0) != 47) {
                if !(prefix.len() == 1 && prefix.byte_at(0) == 47) {
                    create_dir(prefix.as_str())?;
                }
            }
        }
        i += 1;
    }
    return Ok(());
}

// metadata reports a path's size and kind.
pub fn metadata(path: str) -> Result<Metadata, IoError> {
    let kind = sys::path_kind(path);
    if kind == 0 {
        return Err(sys::error_of(sys::errno()));
    }
    let mut size: u64 = 0;
    if kind == 1 {
        size = sys::file_size(path)?;
    }
    let mut k = FileKind::Other;
    if kind == 1 {
        k = FileKind::File;
    } else if kind == 2 {
        k = FileKind::Dir;
    }
    return Ok(Metadata { size: size, kind: k });
}
