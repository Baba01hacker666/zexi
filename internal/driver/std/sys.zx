// sys — practical local-system helpers: environment, paths, clocks, and pid.
// Import with `use sys;`, `use std::sys;`, `import os;`, or `import time;`.
//
// A small POSIX C shim (`zxs_*`) is linked only when this module is used.
// Path-returning helpers use a 4096-byte buffer; failures return an empty
// String and filesystem operations return 0 on success or -1 on failure.

extern "C" fn zxs_env_get(name: str, buf: &mut [u8; 4096], cap: i32) -> i32;
extern "C" fn zxs_env_has(name: str) -> i32;
extern "C" fn zxs_env_set(name: str, value: str, overwrite: i32) -> i32;
extern "C" fn zxs_env_unset(name: str) -> i32;
extern "C" fn zxs_time_ms() -> i64;
extern "C" fn zxs_mono_ms() -> i64;
extern "C" fn zxs_sleep_ms(ms: i64);
extern "C" fn zxs_pid() -> i32;
extern "C" fn zxs_cwd(buf: &mut [u8; 4096], cap: i32) -> i32;
extern "C" fn zxs_hostname(buf: &mut [u8; 4096], cap: i32) -> i32;
extern "C" fn zxs_chdir(path: str) -> i32;
extern "C" fn zxs_mkdir(path: str) -> i32;
extern "C" fn zxs_remove_path(path: str) -> i32;
extern "C" fn zxs_rename_path(from: str, to: str) -> i32;
extern "C" fn zxs_cpu_count() -> i32;

// env_get returns the value of an environment variable ("" when unset or
// empty). Use env_has to distinguish those two cases.
pub fn env_get(name: str) -> String {
    let mut buf: [u8; 4096] = [0; 4096];
    let n = zxs_env_get(name, &mut buf, 4096);
    let mut out = String::new();
    if n > 0 {
        let mut i: usize = 0;
        while i < (n as usize) {
            out.push_byte(buf[i]);
            i += 1;
        }
    }
    return out;
}

// env_has reports whether a variable is set, including when its value is "".
pub fn env_has(name: str) -> bool {
    return zxs_env_has(name) == 1;
}

// env_or returns an environment value when it is set, otherwise fallback.
pub fn env_or(name: str, fallback: str) -> String {
    if env_has(name) {
        return env_get(name);
    }
    return String::from(fallback);
}

// env_set sets a process-local environment variable. overwrite defaults to
// true; pass false to leave an already-set variable untouched. Returns 0/-1.
pub fn env_set(name: str, value: str, overwrite: bool = true) -> i32 {
    let mode = if overwrite { 1 } else { 0 };
    return zxs_env_set(name, value, mode);
}

// env_unset removes a process-local environment variable. Returns 0/-1.
pub fn env_unset(name: str) -> i32 {
    return zxs_env_unset(name);
}

// time_ms is wall-clock time in milliseconds since the Unix epoch.
pub fn time_ms() -> i64 {
    return zxs_time_ms();
}

// time_s is wall-clock time in whole seconds.
pub fn time_s() -> i64 {
    return zxs_time_ms() / 1000;
}

// mono_ms is a monotonic clock in milliseconds (for measuring intervals;
// it never jumps, unlike the wall clock).
pub fn mono_ms() -> i64 {
    return zxs_mono_ms();
}

// sleep_ms pauses the current thread for at least `ms` milliseconds.
pub fn sleep_ms(ms: i64) {
    zxs_sleep_ms(ms);
}

// pid is the current process id.
pub fn pid() -> i32 {
    return zxs_pid();
}

// millis_since returns how many milliseconds have passed since `start`,
// measured with the monotonic clock.
pub fn millis_since(start: i64) -> i64 {
    return zxs_mono_ms() - start;
}

// cwd returns the current working directory, or "" when it cannot be read.
pub fn cwd() -> String {
    let mut buf: [u8; 4096] = [0; 4096];
    let n = zxs_cwd(&mut buf, 4096);
    let mut out = String::new();
    if n > 0 {
        let mut i: usize = 0;
        while i < (n as usize) {
            out.push_byte(buf[i]);
            i += 1;
        }
    }
    return out;
}

// hostname returns the local host name, or "" when it cannot be read.
pub fn hostname() -> String {
    let mut buf: [u8; 4096] = [0; 4096];
    let n = zxs_hostname(&mut buf, 4096);
    let mut out = String::new();
    if n > 0 {
        let mut i: usize = 0;
        while i < (n as usize) {
            out.push_byte(buf[i]);
            i += 1;
        }
    }
    return out;
}

// home_dir returns HOME, then USERPROFILE, or "" when neither is set.
pub fn home_dir() -> String {
    if env_has("HOME") {
        return env_get("HOME");
    }
    if env_has("USERPROFILE") {
        return env_get("USERPROFILE");
    }
    return String::new();
}

// temp_dir returns TMPDIR when set, otherwise the conventional POSIX /tmp.
pub fn temp_dir() -> String {
    if env_has("TMPDIR") {
        return env_get("TMPDIR");
    }
    return String::from("/tmp");
}

// chdir changes the process working directory. Returns 0/-1.
pub fn chdir(path: str) -> i32 {
    return zxs_chdir(path);
}

// mkdir creates one directory level. It succeeds when path already names a
// directory; it does not create missing parents. Returns 0/-1.
pub fn mkdir(path: str) -> i32 {
    return zxs_mkdir(path);
}

// remove_path removes a regular file or an empty directory. It never recurses.
pub fn remove_path(path: str) -> i32 {
    return zxs_remove_path(path);
}

// rename_path renames or moves a file/directory within the local filesystem.
pub fn rename_path(from: str, to: str) -> i32 {
    return zxs_rename_path(from, to);
}

// cpu_count returns the online CPU count, or 1 when the OS cannot report it.
pub fn cpu_count() -> i32 {
    return zxs_cpu_count();
}

// The POSIX side of this module travels with it: a library can carry its own C,
// so adding a syscall wrapper is an edit here rather than a new file for the
// compiler to embed. These are process-local libc/POSIX helpers.
c """
/* zxsys.c — tiny POSIX helpers for Zexi's `sys` module.
 *
 * Linked only when a program selects sys/os/time (or random, which uses the
 * clock). These are process-local libc/POSIX helpers; no external runtime is
 * required.
 */
#include <errno.h>
#include <limits.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <time.h>
#include <unistd.h>

/* Copy a C string into a caller-owned buffer, always NUL-terminating it.
 * Returns the copied byte length, or -1 for invalid arguments. */
static int zxs_copy_string(const char *src, char *buf, int cap) {
    if (!src || !buf || cap <= 0) return -1;
    size_t n = strlen(src);
    if (n >= (size_t)cap) n = (size_t)cap - 1;
    memcpy(buf, src, n);
    buf[n] = 0;
    return (int)n;
}

/* A `&mut [u8; 4096]` parameter arrives as a pointer to the array's wrapper
 * struct; `->e` is the bytes. */ 
#define ZXS_BYTES(buf) ((char *)((buf)->e))

/* zxs_env_get copies an environment variable into buf, returning its length,
 * or -1 when the variable is unset. */
int32_t zxs_env_get(const char *name, struct zx_arr4096_u8 *buf, int32_t cap) {
    if (!name) return -1;
    return zxs_copy_string(getenv(name), ZXS_BYTES(buf), cap);
}

int zxs_env_has(const char *name) {
    return name && getenv(name) ? 1 : 0;
}

int zxs_env_set(const char *name, const char *value, int overwrite) {
    if (!name || !value) return -1;
    return setenv(name, value, overwrite ? 1 : 0);
}

int zxs_env_unset(const char *name) {
    if (!name) return -1;
    return unsetenv(name);
}

/* zxs_time_ms is wall-clock milliseconds since the Unix epoch. */
int64_t zxs_time_ms(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_REALTIME, &ts) != 0) return -1;
    return (int64_t)ts.tv_sec * 1000LL + (int64_t)(ts.tv_nsec / 1000000);
}

/* zxs_mono_ms is a monotonic millisecond clock, for measuring intervals. */
int64_t zxs_mono_ms(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return -1;
    return (int64_t)ts.tv_sec * 1000LL + (int64_t)(ts.tv_nsec / 1000000);
}

/* zxs_sleep_ms pauses for at least ms milliseconds, retrying on EINTR. */
void zxs_sleep_ms(int64_t ms) {
    if (ms <= 0) return;
    struct timespec ts;
    ts.tv_sec = (time_t)(ms / 1000);
    ts.tv_nsec = (long)((ms % 1000) * 1000000LL);
    while (nanosleep(&ts, &ts) != 0 && errno == EINTR) { /* retry remaining */ }
}

/* zxs_pid is the current process id. */
int zxs_pid(void) { return (int)getpid(); }

int32_t zxs_cwd(struct zx_arr4096_u8 *buf, int32_t cap) {
    if (!buf || cap <= 1) return -1;
    if (!getcwd(ZXS_BYTES(buf), (size_t)cap)) return -1;
    return (int)strlen(ZXS_BYTES(buf));
}

int32_t zxs_hostname(struct zx_arr4096_u8 *buf, int32_t cap) {
    if (!buf || cap <= 1) return -1;
    if (gethostname(ZXS_BYTES(buf), (size_t)cap) != 0) return -1;
    /* POSIX permits a non-terminated result when it exactly fills the buffer. */
    ZXS_BYTES(buf)[cap - 1] = 0;
    return (int)strlen(ZXS_BYTES(buf));
}

int zxs_chdir(const char *path) {
    return path ? chdir(path) : -1;
}

/* zxs_mkdir creates a single directory level and treats an existing directory
 * as success. It deliberately does not emulate recursive mkdir -p. */
int zxs_mkdir(const char *path) {
    if (!path) return -1;
    if (mkdir(path, 0777) == 0) return 0;
    if (errno == EEXIST) {
        struct stat st;
        if (stat(path, &st) == 0 && S_ISDIR(st.st_mode)) return 0;
    }
    return -1;
}

int zxs_remove_path(const char *path) {
    return path ? remove(path) : -1;
}

int zxs_rename_path(const char *from, const char *to) {
    return from && to ? rename(from, to) : -1;
}

int zxs_cpu_count(void) {
    long n = sysconf(_SC_NPROCESSORS_ONLN);
    if (n <= 0) return 1;
    if (n > INT_MAX) return INT_MAX;
    return (int)n;
}
"""
