// math — numeric helpers, part of the Zexi standard library.
// Import with `use math;`, `use std::math;`, or `import math;`.
//
// Pure Zexi (no libm link required). Integer math uses wrapping C semantics;
// the floor/ceil variants correct the truncated division explicitly.

// --- integers --------------------------------------------------------------

pub fn mini(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

pub fn maxi(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

pub fn clampi(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo { lo } elif x > hi { hi } else { x }
}

pub fn absi(x: i64) -> i64 {
    // i64::MIN has no representable positive counterpart, so saturate instead
    // of overflowing back to a negative value.
    if x == -9223372036854775808 {
        return 9223372036854775807;
    }
    if x < 0 { -x } else { x }
}

pub fn signi(x: i64) -> i64 {
    if x < 0 { -1 } elif x > 0 { 1 } else { 0 }
}

pub fn is_even(x: i64) -> bool {
    x % 2 == 0
}

pub fn is_odd(x: i64) -> bool {
    x % 2 != 0
}

// div_floor rounds division toward negative infinity (C truncates toward 0).
pub fn div_floor(a: i64, b: i64) -> i64 {
    // Keep a convenience helper from turning a bad command-line/config value
    // into a process-level divide-by-zero trap.
    if b == 0 {
        return 0;
    }
    let q = a / b;
    if a % b != 0 && ((a < 0) != (b < 0)) {
        return q - 1;
    }
    return q;
}

// mod_floor is the remainder paired with div_floor (it has b's sign when
// non-zero). It returns 0 when b is 0 rather than evaluating an undefined C
// remainder operation.
pub fn mod_floor(a: i64, b: i64) -> i64 {
    if b == 0 {
        return 0;
    }
    let r = a % b;
    if r != 0 && ((a < 0) != (b < 0)) {
        return r + b;
    }
    return r;
}

// div_ceil rounds division toward positive infinity (and returns 0 for b=0).
pub fn div_ceil(a: i64, b: i64) -> i64 {
    if b == 0 {
        return 0;
    }
    let q = a / b;
    if a % b != 0 && ((a > 0) == (b > 0)) {
        return q + 1;
    }
    return q;
}

pub fn gcdi(a0: i64, b0: i64) -> i64 {
    let mut a = absi(a0);
    let mut b = absi(b0);
    while b != 0 {
        let t = a % b;
        a = b;
        b = t;
    }
    a
}

// lcmi is the least common multiple (0 when either input is 0).
pub fn lcmi(a: i64, b: i64) -> i64 {
    if a == 0 || b == 0 {
        return 0;
    }
    return absi(a / gcdi(a, b) * b);
}

// powi raises an integer base to a non-negative exponent. A negative exponent
// would require a fractional result, so it returns 0 instead of silently 1.
pub fn powi(base: i64, exp: i32) -> i64 {
    if exp < 0 {
        return 0;
    }
    let mut r: i64 = 1;
    let mut i = 0;
    while i < exp {
        r *= base;
        i += 1;
    }
    r
}

// isqrt is the integer square root (floor), by binary search; no libm.
pub fn isqrt(n: i64) -> i64 {
    if n <= 0 {
        return 0;
    }
    let mut lo: i64 = 0;
    let mut hi: i64 = mini(n, 3037000499); // 2^63/2^31: avoids overflow at mid*mid
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if mid * mid <= n {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    return lo;
}

// pow_mod computes (base^exp) mod m with binary exponentiation in unsigned
// 64-bit arithmetic. Results are exact only when m <= 4294967296, since
// b*b and result*b can overflow u64 for larger moduli.
pub fn pow_mod(base: i64, exp: i64, m: i64) -> i64 {
    if m <= 1 || exp < 0 {
        return 0;
    }
    let mut result: u64 = 1;
    let mut bm = base % m;
    if bm < 0 {
        bm += m;
    }
    let mut b: u64 = bm as u64;
    let mut e = exp;
    while e > 0 {
        if e % 2 == 1 {
            result = (result * b) % (m as u64);
        }
        b = (b * b) % (m as u64);
        e = e / 2;
    }
    return (result as i64) % m;
}

// --- bits ------------------------------------------------------------------

// popcount is the number of set bits.
pub fn popcount(x: u64) -> i32 {
    let mut v = x;
    let mut n: i32 = 0;
    while v != 0 {
        n += (v & 1) as i32;
        v = v >> 1;
    }
    return n;
}

// trailing_zeros is the number of zero low bits (0 for 0).
pub fn trailing_zeros(x: u64) -> i32 {
    if x == 0 {
        return 64;
    }
    let mut v = x;
    let mut n: i32 = 0;
    while v & 1 == 0 {
        v = v >> 1;
        n += 1;
    }
    return n;
}

// leading_zeros is the number of zero high bits (64 for 0).
pub fn leading_zeros(x: u64) -> i32 {
    if x == 0 {
        return 64;
    }
    let mut n: i32 = 0;
    let mut v = x;
    while v < 9223372036854775808 { // bit 63 not set
        v = v << 1;
        n += 1;
    }
    return n;
}

pub fn is_pow2(x: u64) -> bool {
    return x != 0 && (x & (x - 1)) == 0;
}

// log2_floor is floor(log2(x)) for x > 0 (0 for 0).
pub fn log2_floor(x: u64) -> i32 {
    if x == 0 {
        return 0;
    }
    return 63 - leading_zeros(x);
}

// --- floats (pure Zexi; no libm) -------------------------------------------

// Casting an out-of-range float (or NaN) to i64 is undefined in C. At and
// beyond this power of two, every representable f64 is already integral, so
// floor/ceil/trunc can safely return it unchanged.
const MATH_F64_I64_LIMIT: f64 = 9223372036854775808.0;

pub fn minf(a: f64, b: f64) -> f64 {
    // Preserve exceptional values instead of quietly discarding a NaN because
    // every ordered comparison with it is false.
    if a != a { return a; }
    if b != b { return b; }
    if a < b { a } else { b }
}

pub fn maxf(a: f64, b: f64) -> f64 {
    if a != a { return a; }
    if b != b { return b; }
    if a > b { a } else { b }
}

pub fn clampf(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo { lo } elif x > hi { hi } else { x }
}

pub fn absf(x: f64) -> f64 {
    if x < 0.0 { -x } else { x }
}

// floor_f rounds toward negative infinity.
pub fn floor_f(x: f64) -> f64 {
    if x != x || x >= MATH_F64_I64_LIMIT || x <= 0.0 - MATH_F64_I64_LIMIT {
        return x;
    }
    let t = x as i64; // truncates toward zero within the checked range
    let f = t as f64;
    if f > x {
        return f - 1.0;
    }
    return f;
}

// ceil_f rounds toward positive infinity.
pub fn ceil_f(x: f64) -> f64 {
    if x != x || x >= MATH_F64_I64_LIMIT || x <= 0.0 - MATH_F64_I64_LIMIT {
        return x;
    }
    let t = x as i64;
    let f = t as f64;
    if f < x {
        return f + 1.0;
    }
    return f;
}

// round_f rounds half away from zero.
pub fn round_f(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 - floor_f(0.0 - x + 0.5);
    }
    return floor_f(x + 0.5);
}

// trunc_f rounds toward zero.
pub fn trunc_f(x: f64) -> f64 {
    if x != x || x >= MATH_F64_I64_LIMIT || x <= 0.0 - MATH_F64_I64_LIMIT {
        return x;
    }
    return (x as i64) as f64;
}

// --- friendly high-level helpers ------------------------------------------
//
// The short names in this section are intentionally Python-shaped. The older
// *_i / *_f helpers above remain available and are useful when a call site
// wants to advertise its numeric domain explicitly.

pub const PI: f64 = 3.14159265358979323846264338327950288;
pub const TAU: f64 = 6.28318530717958647692528676655900576;
pub const E: f64 = 2.71828182845904523536028747135266250;
pub const FRAC_PI_2: f64 = 1.57079632679489661923132169163975144;
pub const FRAC_PI_4: f64 = 0.78539816339744830961566084581987572;
pub const SQRT_2: f64 = 1.41421356237309504880168872420969808;
pub const LN_2: f64 = 0.69314718055994530941723212145817657;
pub const LN_10: f64 = 2.30258509299404568401799145468436421;
pub const LOG2_E: f64 = 1.44269504088896340735992468100189214;
pub const LOG10_E: f64 = 0.43429448190325182765112891891660508;
// MAX_F64 is the largest finite IEEE-754 f64 value. It is useful with the
// classification helpers and makes saturation behavior explicit.
pub const MAX_F64: f64 = 1.7976931348623157e308;

pub fn min(a: f64, b: f64) -> f64 { minf(a, b) }
pub fn max(a: f64, b: f64) -> f64 { maxf(a, b) }
pub fn clamp(x: f64, lo: f64, hi: f64) -> f64 { clampf(x, lo, hi) }
pub fn abs(x: f64) -> f64 { absf(x) }
pub fn floor(x: f64) -> f64 { floor_f(x) }
pub fn ceil(x: f64) -> f64 { ceil_f(x) }
pub fn round(x: f64) -> f64 { round_f(x) }
pub fn trunc(x: f64) -> f64 { trunc_f(x) }

pub fn min_i(a: i64, b: i64) -> i64 { mini(a, b) }
pub fn max_i(a: i64, b: i64) -> i64 { maxi(a, b) }
pub fn clamp_i(x: i64, lo: i64, hi: i64) -> i64 { clampi(x, lo, hi) }
pub fn abs_i(x: i64) -> i64 { absi(x) }
pub fn sign_i(x: i64) -> i64 { signi(x) }
pub fn gcd(a: i64, b: i64) -> i64 { gcdi(a, b) }
pub fn lcm(a: i64, b: i64) -> i64 { lcmi(a, b) }

// sqrt returns the non-negative square root of x. Negative inputs return 0.
// Scaling keeps Newton's method accurate for both very large and very small
// finite values without requiring libm.
pub fn sqrt(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0;
    }
    let mut y = x;
    let mut scale = 1.0;
    let mut scaled_up = false;
    let mut shifts: i32 = 0;
    // Finite f64 values need at most about 540 base-4 shifts. The cap keeps
    // +infinity from turning this pure helper into an accidental infinite loop.
    while y < 1.0 && shifts < 1024 {
        y *= 4.0;
        scale *= 2.0;
        scaled_up = true;
        shifts += 1;
    }
    while y > 4.0 && shifts < 1024 {
        y *= 0.25;
        scale *= 2.0;
        shifts += 1;
    }
    if y > 4.0 {
        return y;
    }
    let mut guess = (1.0 + y) / 2.0;
    let mut i = 0;
    while i < 16 {
        guess = (guess + y / guess) / 2.0;
        i += 1;
    }
    if scaled_up {
        return guess / scale;
    }
    return guess * scale;
}

// hypot returns sqrt(x*x + y*y) while avoiding intermediate overflow for
// ordinary finite inputs.
pub fn hypot(x: f64, y: f64) -> f64 {
    let ax = absf(x);
    let ay = absf(y);
    // Match the useful IEEE convention: an infinite side dominates a NaN
    // side, while a NaN is otherwise preserved.
    if is_infinite(ax) { return ax; }
    if is_infinite(ay) { return ay; }
    if is_nan(ax) { return ax; }
    if is_nan(ay) { return ay; }
    let hi = maxf(ax, ay);
    let lo = minf(ax, ay);
    if hi == 0.0 {
        return 0.0;
    }
    let r = lo / hi;
    return hi * sqrt(1.0 + r * r);
}

// pow raises a floating-point base to an integer exponent. Negative exponents
// produce the reciprocal. Like C arithmetic, overflow becomes an infinity.
pub fn pow(base: f64, exponent: i32) -> f64 {
    let mut e = exponent as i64;
    let invert = e < 0;
    if invert {
        e = -e;
    }
    let mut b = base;
    let mut out = 1.0;
    while e > 0 {
        if e % 2 == 1 {
            out *= b;
        }
        b *= b;
        e /= 2;
    }
    if invert {
        return 1.0 / out;
    }
    return out;
}

// wrap_angle reduces an angle to [-PI, PI]. A quotient reduction handles
// ordinary large inputs without a long subtraction loop; the bounded fallback
// keeps infinities and extreme values from hanging the process.
fn wrap_angle(x0: f64) -> f64 {
    let mut x = x0;
    if x > TAU || x < 0.0 - TAU {
        // Keep the float-to-int conversion in its defined finite range.
        if x < 9000000000000000000.0 && x > 0.0 - 9000000000000000000.0 {
            x -= trunc_f(x / TAU) * TAU;
        }
    }
    let mut steps: i32 = 0;
    while x > PI && steps < 1024 {
        x -= TAU;
        steps += 1;
    }
    while x < 0.0 - PI && steps < 1024 {
        x += TAU;
        steps += 1;
    }
    return x;
}

// sin and cos use a reduced-angle Taylor series. They are dependency-free,
// accurate enough for UI, games, and small numerical programs (not a libm
// replacement for scientific edge cases).
pub fn sin(x: f64) -> f64 {
    let y = wrap_angle(x);
    let mut term = y;
    let mut out = y;
    let mut k: i32 = 1;
    while k < 12 {
        let divisor = ((2 * k) * (2 * k + 1)) as f64;
        term = 0.0 - term * y * y / divisor;
        out += term;
        k += 1;
    }
    return out;
}

pub fn cos(x: f64) -> f64 {
    let y = wrap_angle(x);
    let mut term = 1.0;
    let mut out = 1.0;
    let mut k: i32 = 1;
    while k < 12 {
        let divisor = ((2 * k - 1) * (2 * k)) as f64;
        term = 0.0 - term * y * y / divisor;
        out += term;
        k += 1;
    }
    return out;
}

pub fn tan(x: f64) -> f64 { sin(x) / cos(x) }

pub fn lerp(a: f64, b: f64, t: f64) -> f64 { a + (b - a) * t }

// inverse_lerp reports where x lies between a and b. Equal endpoints have no
// useful ratio, so they return 0 instead of dividing by zero.
pub fn inverse_lerp(a: f64, b: f64, x: f64) -> f64 {
    if a == b {
        return 0.0;
    }
    return (x - a) / (b - a);
}

pub fn remap(in_lo: f64, in_hi: f64, out_lo: f64, out_hi: f64, x: f64) -> f64 {
    return lerp(out_lo, out_hi, inverse_lerp(in_lo, in_hi, x));
}

pub fn approx_eq(a: f64, b: f64, tolerance: f64) -> bool {
    return absf(a - b) <= absf(tolerance);
}

pub fn mean2(a: f64, b: f64) -> f64 { a / 2.0 + b / 2.0 }

// factorial returns n! for n >= 0, or 0 for a negative input. The i64 result
// wraps after 20!, matching the rest of Zexi's fixed-width integer helpers.
pub fn factorial(n: i32) -> i64 {
    if n < 0 {
        return 0;
    }
    let mut out: i64 = 1;
    let mut i: i64 = 2;
    while i <= n as i64 {
        out *= i;
        i += 1;
    }
    return out;
}

// choose returns "n choose k", or 0 when k is outside 0..n. It is exact while
// intermediate i64 arithmetic fits.
pub fn choose(n: i64, k0: i64) -> i64 {
    if n < 0 || k0 < 0 || k0 > n {
        return 0;
    }
    let k = if k0 < n - k0 { k0 } else { n - k0 };
    let mut out: i64 = 1;
    let mut i: i64 = 1;
    while i <= k {
        out = out * (n - k + i) / i;
        i += 1;
    }
    return out;
}

pub fn is_prime(n: i64) -> bool {
    if n < 2 {
        return false;
    }
    if n == 2 {
        return true;
    }
    if n % 2 == 0 {
        return false;
    }
    let mut divisor: i64 = 3;
    // n / divisor avoids an overflowing divisor*divisor test.
    while divisor <= n / divisor {
        if n % divisor == 0 {
            return false;
        }
        divisor += 2;
    }
    return true;
}

// next_prime returns the first prime strictly greater than n, or 0 when no
// greater i64 is representable. The final representable odd candidate is still
// tested rather than being skipped at the boundary.
pub fn next_prime(n: i64) -> i64 {
    if n < 2 {
        return 2;
    }
    if n >= 9223372036854775807 {
        return 0;
    }
    let mut candidate = n + 1;
    if candidate % 2 == 0 {
        candidate += 1;
    }
    loop {
        if is_prime(candidate) {
            return candidate;
        }
        // candidate is odd. Once it is MAX_I64, adding two would overflow.
        if candidate > 9223372036854775805 {
            return 0;
        }
        candidate += 2;
    }
}

// --- extended float helpers ------------------------------------------------
//
// These stay in Zexi rather than binding libm, so a small program can use the
// familiar APIs below without adding a platform-specific linker dependency.
// They target ordinary application/numerical work; for correctly-rounded
// scientific edge cases an explicit C/libm binding remains available.

// is_nan reports whether x is an IEEE NaN.
pub fn is_nan(x: f64) -> bool { return x != x; }

// is_finite reports whether x is neither NaN nor positive/negative infinity.
pub fn is_finite(x: f64) -> bool {
    return x == x && x <= MAX_F64 && x >= 0.0 - MAX_F64;
}

// is_infinite reports positive or negative infinity.
pub fn is_infinite(x: f64) -> bool {
    return !is_nan(x) && !is_finite(x);
}

// sign returns -1.0, 0.0, or 1.0. NaN has no ordering, so it returns 0.0.
pub fn sign(x: f64) -> f64 {
    if x < 0.0 {
        return -1.0;
    }
    if x > 0.0 {
        return 1.0;
    }
    return 0.0;
}

// copysign applies sign_source's sign to magnitude. A NaN sign source is
// treated as non-negative; signed zero is intentionally normalized to +0.
pub fn copysign(magnitude: f64, sign_source: f64) -> f64 {
    let mag = absf(magnitude);
    if sign_source < 0.0 {
        return 0.0 - mag;
    }
    return mag;
}

// fract returns the fractional part after truncation toward zero.
pub fn fract(x: f64) -> f64 { return x - trunc_f(x); }

// radians and degrees convert between the two common angle units.
pub fn radians(value: f64) -> f64 { return value * PI / 180.0; }
pub fn degrees(value: f64) -> f64 { return value * 180.0 / PI; }

// midpoint avoids overflow better than `(a + b) / 2.0` for large same-sign
// values. It is the two-value counterpart to mean2.
pub fn midpoint(a: f64, b: f64) -> f64 { return a / 2.0 + b / 2.0; }

// saturate clamps a value into the useful unit interval [0, 1].
pub fn saturate(x: f64) -> f64 { return clampf(x, 0.0, 1.0); }

// scale_pow2 multiplies a value by 2^exponent without needing libm. The
// extended helpers only call it with the bounded f64 exponent range.
fn scale_pow2(value: f64, exponent: i32) -> f64 {
    let mut out = value;
    let mut e = exponent;
    while e > 0 {
        out *= 2.0;
        e -= 1;
    }
    while e < 0 {
        out *= 0.5;
        e += 1;
    }
    return out;
}

// exp computes e^x using ln(2) range reduction and a Taylor series. Large
// positive inputs saturate at MAX_F64; sufficiently negative inputs underflow
// to 0.0 instead of requiring an infinity-producing runtime operation.
pub fn exp(x: f64) -> f64 {
    if x != x {
        return x;
    }
    if x >= 709.782712893384 {
        return MAX_F64;
    }
    if x <= -745.1332191019411 {
        return 0.0;
    }
    let exponent = floor_f(x / LN_2) as i32;
    let reduced = x - (exponent as f64) * LN_2;
    let mut term = 1.0;
    let mut out = 1.0;
    let mut i: i32 = 1;
    while i <= 18 {
        term = term * reduced / (i as f64);
        out += term;
        i += 1;
    }
    return scale_pow2(out, exponent);
}

// exp2 computes 2^x. It is useful for scalings, signal processing, and binary
// sizes when an integer-only pow is too restrictive.
pub fn exp2(x: f64) -> f64 { return exp(x * LN_2); }

// ln computes the natural logarithm of a positive x. It returns 0.0 for x <=
// 0 because this compact stdlib has no Result/NaN-construction API for a
// domain error. NaN is propagated and +infinity remains +infinity.
pub fn ln(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0;
    }
    if x != x {
        return x;
    }
    let mut y = x;
    let mut exponent: i32 = 0;
    while y >= 2.0 && exponent < 1024 {
        y *= 0.5;
        exponent += 1;
    }
    while y < 1.0 && exponent > -1074 {
        y *= 2.0;
        exponent -= 1;
    }
    // This is reached by +infinity after the bounded range-reduction loop.
    if y >= 2.0 || y < 1.0 {
        return y;
    }
    // atanh-style series: ln(y) = 2 * (z + z^3/3 + ...), where y is in
    // [1, 2), so |z| <= 1/3 and 20 terms are comfortably accurate.
    let z = (y - 1.0) / (y + 1.0);
    let z2 = z * z;
    let mut term = z;
    let mut out = z;
    let mut divisor: i32 = 3;
    while divisor <= 39 {
        term *= z2;
        out += term / (divisor as f64);
        divisor += 2;
    }
    return 2.0 * out + (exponent as f64) * LN_2;
}

// log is the conventional short name for the natural logarithm.
pub fn log(x: f64) -> f64 { return ln(x); }
pub fn log2(x: f64) -> f64 { return ln(x) / LN_2; }
pub fn log10(x: f64) -> f64 { return ln(x) / LN_10; }

// log_base computes log base `base` of x. Inputs outside x > 0, base > 0, and
// base != 1 return 0.0, following ln's compact domain-error convention.
pub fn log_base(x: f64, base: f64) -> f64 {
    if x <= 0.0 || base <= 0.0 || base == 1.0 {
        return 0.0;
    }
    return ln(x) / ln(base);
}

const MATH_F64_I32_LIMIT: f64 = 2147483648.0;

// powf raises a real base to a real exponent. Positive bases support any finite
// exponent; negative bases work for whole i32 exponents. Other real powers of
// a negative number have no real result here and return 0.0.
pub fn powf(base: f64, exponent: f64) -> f64 {
    // This also gives the conventional 0^0 and (+infinity)^0 result.
    if exponent == 0.0 {
        return 1.0;
    }
    if base == 0.0 {
        if exponent > 0.0 {
            return 0.0;
        }
        return 0.0;
    }
    if base > 0.0 {
        return exp(ln(base) * exponent);
    }
    let whole = trunc_f(exponent);
    if exponent != whole || whole < 0.0 - MATH_F64_I32_LIMIT || whole >= MATH_F64_I32_LIMIT {
        return 0.0;
    }
    return pow(base, whole as i32);
}

// atan_series assumes |x| <= sqrt(2)-1 and uses the alternating arctangent
// series. Range reduction in atan keeps it in that fast-converging interval.
fn atan_series(x: f64) -> f64 {
    let x2 = x * x;
    let mut term = x;
    let mut out = x;
    let mut k: i32 = 1;
    while k < 20 {
        term *= x2;
        let part = term / ((2 * k + 1) as f64);
        if k % 2 == 1 {
            out -= part;
        } else {
            out += part;
        }
        k += 1;
    }
    return out;
}

// atan returns the angle whose tangent is x, in radians.
pub fn atan(x: f64) -> f64 {
    if x != x {
        return x;
    }
    if x < 0.0 {
        return 0.0 - atan(0.0 - x);
    }
    if x > 1.0 {
        return FRAC_PI_2 - atan(1.0 / x);
    }
    if x > SQRT_2 - 1.0 {
        return FRAC_PI_4 + atan((x - 1.0) / (x + 1.0));
    }
    return atan_series(x);
}

// atan2 returns the signed angle from the positive x-axis to (x, y). The
// origin has no direction and returns 0.0.
pub fn atan2(y: f64, x: f64) -> f64 {
    if y != y {
        return y;
    }
    if x != x {
        return x;
    }
    if x > 0.0 {
        return atan(y / x);
    }
    if x < 0.0 {
        if y >= 0.0 {
            return atan(y / x) + PI;
        }
        return atan(y / x) - PI;
    }
    if y > 0.0 {
        return FRAC_PI_2;
    }
    if y < 0.0 {
        return 0.0 - FRAC_PI_2;
    }
    return 0.0;
}

// asin and acos return principal-value angles in radians. Inputs outside
// [-1, 1] have no real result and return 0.0.
pub fn asin(x: f64) -> f64 {
    if x < -1.0 || x > 1.0 {
        return 0.0;
    }
    return atan2(x, sqrt(1.0 - x * x));
}

pub fn acos(x: f64) -> f64 {
    if x < -1.0 || x > 1.0 {
        return 0.0;
    }
    return FRAC_PI_2 - asin(x);
}

// sinh, cosh, and tanh are the usual hyperbolic functions. exp's documented
// saturation behavior also bounds extreme inputs to these helpers.
pub fn sinh(x: f64) -> f64 {
    // exp(0.0 - x) keeps both terms bounded by exp's documented saturation,
    // so sinh is odd and symmetric instead of producing infinity for large
    // negative inputs (where 1.0 / exp(x) would divide by 0.0).
    return (exp(x) - exp(0.0 - x)) / 2.0;
}

pub fn cosh(x: f64) -> f64 {
    return (exp(x) + exp(0.0 - x)) / 2.0;
}

pub fn tanh(x: f64) -> f64 {
    if x > 20.0 {
        return 1.0;
    }
    if x < -20.0 {
        return -1.0;
    }
    let ex = exp(2.0 * x);
    return (ex - 1.0) / (ex + 1.0);
}

// cbrt returns the real cube root, including for negative inputs.
pub fn cbrt(x: f64) -> f64 {
    if x == 0.0 || is_infinite(x) {
        return x;
    }
    if x < 0.0 {
        return 0.0 - exp(ln(0.0 - x) / 3.0);
    }
    return exp(ln(x) / 3.0);
}

// root returns the real nth root for a positive n. Negative radicands are
// supported for odd n; even roots of a negative value and n <= 0 return 0.0.
pub fn root(x: f64, n: i32) -> f64 {
    if n <= 0 {
        return 0.0;
    }
    if x == 0.0 || is_infinite(x) {
        if x < 0.0 && n % 2 == 0 {
            return 0.0;
        }
        return x;
    }
    if x < 0.0 {
        if n % 2 == 0 {
            return 0.0;
        }
        return 0.0 - exp(ln(0.0 - x) / (n as f64));
    }
    return exp(ln(x) / (n as f64));
}

// smoothstep and smootherstep make a clamped, smooth transition from 0 to 1
// across [edge0, edge1]. Equal edges return 0.0 through inverse_lerp.
pub fn smoothstep(edge0: f64, edge1: f64, x: f64) -> f64 {
    let t = saturate(inverse_lerp(edge0, edge1, x));
    return t * t * (3.0 - 2.0 * t);
}

pub fn smootherstep(edge0: f64, edge1: f64, x: f64) -> f64 {
    let t = saturate(inverse_lerp(edge0, edge1, x));
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

// remap_clamped is remap with the source ratio constrained to [0, 1].
pub fn remap_clamped(in_lo: f64, in_hi: f64, out_lo: f64, out_hi: f64, x: f64) -> f64 {
    let t = saturate(inverse_lerp(in_lo, in_hi, x));
    return lerp(out_lo, out_hi, t);
}

// distance_sq and distance are 2D Cartesian helpers. distance uses hypot to
// avoid an intermediate overflow for ordinary finite coordinate differences.
pub fn distance_sq(x0: f64, y0: f64, x1: f64, y1: f64) -> f64 {
    let dx = x1 - x0;
    let dy = y1 - y0;
    return dx * dx + dy * dy;
}

pub fn distance(x0: f64, y0: f64, x1: f64, y1: f64) -> f64 {
    return hypot(x1 - x0, y1 - y0);
}
