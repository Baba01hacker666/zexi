// codec — encoders and checksums for byte strings.
//
// Pure Zexi over the built-in `String` (no C shim), `codec` covers the small
// conversions a program reaches for around the network edge: hex and base64 for
// tokens, Basic auth, data URIs, and cache keys, plus the checksums commonly
// used for ETags and integrity checks.
//
//     use codec;
//
//     println(codec::hex_encode("hi"));        // 6869
//     println(codec::base64_encode("hello"));  // aGVsbG8=
//     println(codec::crc32_hex("123456789"));  // cbf43926
//     println(codec::fnv1a64_hex("hello"));    // a430d84680aabd0b
//
// Inputs and outputs are `str`-shaped: a `String` argument is accepted anywhere
// a `str` is, and encode/checksum functions return an owning `String` or a
// numeric hash. Because Zexi has no byte-array type yet, decoded bytes are
// returned as a `String` (which is byte-safe for lengths and `byte_at`, but is
// intended for text-shaped data).

// codec_hex_digit maps 0..15 to its lowercase ASCII digit byte.
fn codec_hex_digit(d: i64) -> u8 {
    if d < 10 {
        return (48 as u8) + (d as u8); // '0'
    }
    return (87 as u8) + (d as u8); // 'a' - 10
}

// codec_hex_value is the numeric value of an ASCII hex digit, or -1.
fn codec_hex_value(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return c - 48; // 0-9
    }
    if c >= 97 && c <= 102 {
        return c - 87; // a-f
    }
    if c >= 65 && c <= 70 {
        return c - 55; // A-F
    }
    return -1;
}

// codec_hex_u64 renders v as exactly `width` (1..16) lowercase hex digits.
fn codec_hex_u64(v: u64, width: i32) -> String {
    let mut buf: [u8; 16] = [0; 16];
    let mut n = v;
    let mut i: usize = 0;
    while i < 16 {
        buf[i] = codec_hex_digit((n % 16) as i64);
        n = n / 16;
        i += 1;
    }
    let mut w = width;
    if w < 1 {
        w = 1;
    }
    if w > 16 {
        w = 16;
    }
    let mut out = String::from("");
    let mut j: usize = w as usize;
    while j > 0 {
        j -= 1;
        out.push_byte(buf[j]);
    }
    return out;
}

// --- hex -------------------------------------------------------------------

// hex_encode renders the bytes of s as lowercase hex.
pub fn hex_encode(s: str) -> String {
    let v = String::from(s);
    let mut out = String::from("");
    let mut i: usize = 0;
    while i < v.len() {
        let b = v.byte_at(i);
        out.push_byte(codec_hex_digit(b / 16));
        out.push_byte(codec_hex_digit(b % 16));
        i += 1;
    }
    return out;
}

// hex_encode_upper renders the bytes of s as uppercase hex.
pub fn hex_encode_upper(s: str) -> String {
    let v = String::from(s);
    let mut out = String::from("");
    let mut i: usize = 0;
    while i < v.len() {
        let b = v.byte_at(i);
        out.push_byte(codec_hex_digit(b / 16));
        let lo = codec_hex_digit(b % 16);
        if lo >= 97 && lo <= 102 {
            out.push_byte(lo - 32);
        } else {
            out.push_byte(lo);
        }
        i += 1;
    }
    return out;
}

// hex_decode parses hex into its bytes. Whitespace is ignored; an odd digit
// count or any non-hex character makes it return an empty string.
pub fn hex_decode(s: str) -> String {
    let v = String::from(s);
    let mut out = String::from("");
    let mut hi: i64 = -1;
    let mut i: usize = 0;
    while i < v.len() {
        let c = v.byte_at(i);
        i += 1;
        if c == 32 || c == 9 || c == 10 || c == 13 {
            continue;
        }
        let d = codec_hex_value(c);
        if d < 0 {
            return String::from("");
        }
        if hi < 0 {
            hi = d;
        } else {
            out.push_byte(((hi * 16 + d) as u8));
            hi = -1;
        }
    }
    if hi >= 0 {
        return String::from("");
    }
    return out;
}

// --- base64 ----------------------------------------------------------------

// codec_b64_at is the byte of the alphabet at index k.
fn codec_b64_at(alpha: str, k: i64) -> u8 {
    let a = String::from(alpha);
    return a.byte_at(k as usize) as u8;
}

// codec_b64 encodes s; url picks the URL-safe alphabet and pad adds `=`.
fn codec_b64(s: str, url: bool, pad: bool) -> String {
    let v = String::from(s);
    let mut alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    if url {
        alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
    }
    let mut out = String::from("");
    let mut i: usize = 0;
    while i + 3 <= v.len() {
        let b0 = v.byte_at(i);
        let b1 = v.byte_at(i + 1);
        let b2 = v.byte_at(i + 2);
        out.push_byte(codec_b64_at(alpha, b0 / 4));
        out.push_byte(codec_b64_at(alpha, (b0 % 4) * 16 + b1 / 16));
        out.push_byte(codec_b64_at(alpha, (b1 % 16) * 4 + b2 / 64));
        out.push_byte(codec_b64_at(alpha, b2 % 64));
        i += 3;
    }
    let rem = v.len() - i;
    if rem == 1 {
        let b0 = v.byte_at(i);
        out.push_byte(codec_b64_at(alpha, b0 / 4));
        out.push_byte(codec_b64_at(alpha, (b0 % 4) * 16));
        if pad {
            out.push('=');
            out.push('=');
        }
    } else if rem == 2 {
        let b0 = v.byte_at(i);
        let b1 = v.byte_at(i + 1);
        out.push_byte(codec_b64_at(alpha, b0 / 4));
        out.push_byte(codec_b64_at(alpha, (b0 % 4) * 16 + b1 / 16));
        out.push_byte(codec_b64_at(alpha, (b1 % 16) * 4));
        if pad {
            out.push('=');
        }
    }
    return out;
}

// base64_encode renders s with the standard alphabet and `=` padding.
pub fn base64_encode(s: str) -> String {
    return codec_b64(s, false, true);
}

// base64_encode_url renders s with the URL-safe alphabet and no padding.
pub fn base64_encode_url(s: str) -> String {
    return codec_b64(s, true, false);
}

// codec_b64_value is the 6-bit value of a base64 character from either
// alphabet, or -1.
fn codec_b64_value(c: i64) -> i64 {
    if c >= 65 && c <= 90 {
        return c - 65; // A-Z
    }
    if c >= 97 && c <= 122 {
        return c - 71; // a-z
    }
    if c >= 48 && c <= 57 {
        return c + 4; // 0-9
    }
    if c == 43 || c == 45 {
        return 62; // + or -
    }
    if c == 47 || c == 95 {
        return 63; // / or _
    }
    return -1;
}

// base64_decode decodes either alphabet, ignoring `=` and whitespace. A
// malformed length or character makes it return an empty string.
pub fn base64_decode(s: str) -> String {
    let v = String::from(s);
    let mut acc: [i64; 4] = [0; 4];
    let mut n: usize = 0;
    let mut out = String::from("");
    let mut i: usize = 0;
    while i < v.len() {
        let c = v.byte_at(i);
        i += 1;
        if c == 61 {
            continue; // '='
        }
        if c == 32 || c == 9 || c == 10 || c == 13 {
            continue;
        }
        let d = codec_b64_value(c);
        if d < 0 {
            return String::from("");
        }
        acc[n] = d;
        n += 1;
        if n == 4 {
            out.push_byte(((acc[0] * 4 + acc[1] / 16) as u8));
            out.push_byte(((acc[1] % 16 * 16 + acc[2] / 4) as u8));
            out.push_byte(((acc[2] % 4 * 64 + acc[3]) as u8));
            n = 0;
        }
    }
    if n == 2 {
        out.push_byte(((acc[0] * 4 + acc[1] / 16) as u8));
    } else if n == 3 {
        out.push_byte(((acc[0] * 4 + acc[1] / 16) as u8));
        out.push_byte(((acc[1] % 16 * 16 + acc[2] / 4) as u8));
    } else if n != 0 {
        return String::from("");
    }
    return out;
}

// --- checksums -------------------------------------------------------------

// crc32 is the standard (zlib/IEEE 802.3) CRC-32 of s, as an unsigned 32-bit
// value in an i64.
pub fn crc32(s: str) -> i64 {
    let v = String::from(s);
    let mut crc: i64 = 4294967295; // 0xFFFFFFFF
    let mut i: usize = 0;
    while i < v.len() {
        crc = (crc ^ v.byte_at(i)) & 4294967295;
        let mut k: i32 = 0;
        while k < 8 {
            if crc % 2 == 1 {
                crc = ((crc / 2) ^ 3988292384) & 4294967295; // 0xEDB88320
            } else {
                crc = crc / 2;
            }
            k += 1;
        }
        i += 1;
    }
    return (crc ^ 4294967295) & 4294967295;
}

// crc32_hex is crc32 rendered as eight lowercase hex digits.
pub fn crc32_hex(s: str) -> String {
    return codec_hex_u64(crc32(s) as u64, 8);
}

// adler32 is the zlib Adler-32 checksum of s, as an unsigned 32-bit value in an
// i64.
pub fn adler32(s: str) -> i64 {
    let v = String::from(s);
    let mut a: i64 = 1;
    let mut b: i64 = 0;
    let mut i: usize = 0;
    while i < v.len() {
        a = (a + v.byte_at(i)) % 65521;
        b = (b + a) % 65521;
        i += 1;
    }
    return b * 65536 + a;
}

// adler32_hex is adler32 rendered as eight lowercase hex digits.
pub fn adler32_hex(s: str) -> String {
    return codec_hex_u64(adler32(s) as u64, 8);
}

// fnv1a32 is the 32-bit FNV-1a hash of s, as an unsigned 32-bit value in an i64.
pub fn fnv1a32(s: str) -> i64 {
    let v = String::from(s);
    let mut h: i64 = 0x811c9dc5;
    let mut i: usize = 0;
    while i < v.len() {
        h = ((h ^ v.byte_at(i)) * 0x01000193) & 0xffffffff;
        i += 1;
    }
    return h;
}

// fnv1a32_hex is fnv1a32 rendered as eight lowercase hex digits.
pub fn fnv1a32_hex(s: str) -> String {
    return codec_hex_u64(fnv1a32(s) as u64, 8);
}

// fnv1a64 is the 64-bit FNV-1a hash of s.
pub fn fnv1a64(s: str) -> u64 {
    let v = String::from(s);
    let mut h: u64 = 0xcbf29ce484222325;
    let mut i: usize = 0;
    while i < v.len() {
        h = (h ^ (v.byte_at(i) as u64)) * 0x100000001b3;
        i += 1;
    }
    return h;
}

// fnv1a64_hex is fnv1a64 rendered as sixteen lowercase hex digits.
pub fn fnv1a64_hex(s: str) -> String {
    return codec_hex_u64(fnv1a64(s), 16);
}

// djb2 is Bernstein's djb2 hash of s over 64 bits.
pub fn djb2(s: str) -> u64 {
    let v = String::from(s);
    let mut h: u64 = 5381;
    let mut i: usize = 0;
    while i < v.len() {
        h = h * 33 + (v.byte_at(i) as u64);
        i += 1;
    }
    return h;
}

// djb2_hex is djb2 rendered as sixteen lowercase hex digits.
pub fn djb2_hex(s: str) -> String {
    return codec_hex_u64(djb2(s), 16);
}
