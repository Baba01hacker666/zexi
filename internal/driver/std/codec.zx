// codec — encoders and checksums for byte data.
//
// Pure Zexi over `String`/slices (no C shim), `codec` covers the small
// conversions a program reaches for around the network edge: hex and base64 for
// tokens, Basic auth, data URIs, and cache keys, plus the checksums commonly
// used for ETags and integrity checks.
//
//     use codec;
//
//     println(codec::hex_encode("hi"));        // 6869
//     println(codec::base64_encode("hello"));  // aGVsbG8=
//     println(codec::crc32_hex("123456789"));  // cbf43926
//     println(codec::fnv1a64_hex("hello"));    // a430d84680aabd0b
//
// Every encoder has a `_bytes` form taking a `&[u8]`, so binary data — a file
// read with `fs::read`, a request body, a socket frame — is encoded without a
// detour through text. The `str` spellings are one-line wrappers that lend
// their bytes, and decoded output is an owning `String` (Zexi's byte buffer),
// so NUL and high bytes survive a round trip.

// --- ASCII digit helpers ---------------------------------------------------

pub const ASCII_0: i64 = 48;
pub const ASCII_9: i64 = 57;
pub const ASCII_A: i64 = 65;
pub const ASCII_F: i64 = 70;
pub const ASCII_Z: i64 = 90;
pub const ASCII_a: i64 = 97;
pub const ASCII_f: i64 = 102;
pub const ASCII_z: i64 = 122;

// --- checksum algorithm constants ------------------------------------------

// CRC-32 (IEEE 802.3 / zlib) uses a reflected polynomial; the magic value is
// the bit-reversed form of x^32 + x^26 + x^23 + x^22 + x^16 + x^12 + x^11
// + x^10 + x^8 + x^7 + x^5 + x^4 + x^2 + x^1 + x^0.
pub const CRC32_POLY: i64 = 0xEDB88320;
// 0xFFFFFFFF initial/final XOR: all-bits-set is the standard seed and final
// flip that makes CRC-32 detect leading/trailing zero bytes.
pub const CRC32_XOR: i64 = 0xFFFFFFFF;

// FNV-1a 32-bit offset basis and prime (see http://www.isthe.com/chongo/tech/comp/fnv).
pub const FNV1A32_BASIS: i64 = 0x811C9DC5;
pub const FNV1A32_PRIME: i64 = 0x01000193;

// FNV-1a 64-bit offset basis and prime.
pub const FNV1A64_BASIS: u64 = 0xCBF29CE484222325;
pub const FNV1A64_PRIME: u64 = 0x100000001B3;

// DJB2 seed: the Bernstein hash starts from 5381.
pub const DJB2_SEED: u64 = 5381;

// Adler-32 prime modulus (largest prime under 65536).
pub const ADLER32_MOD: i64 = 65521;

// codec_hex_digit maps 0..15 to its lowercase ASCII digit byte.
fn codec_hex_digit(d: i64) -> u8 {
    if d < 10 {
        return (ASCII_0 as u8) + (d as u8); // '0'
    }
    return ((ASCII_a - 10) as u8) + (d as u8); // 'a'
}

// codec_hex_digit_upper maps 0..15 to its uppercase ASCII digit byte.
fn codec_hex_digit_upper(d: i64) -> u8 {
    if d < 10 {
        return (ASCII_0 as u8) + (d as u8); // '0'
    }
    return ((ASCII_A - 10) as u8) + (d as u8); // 'A'
}

// codec_hex_value is the numeric value of an ASCII hex digit, or -1.
fn codec_hex_value(c: i64) -> i64 {
    if c >= ASCII_0 && c <= ASCII_9 {
        return c - ASCII_0; // 0-9
    }
    if c >= ASCII_a && c <= ASCII_f {
        return c - (ASCII_a - 10); // a-f
    }
    if c >= ASCII_A && c <= ASCII_F {
        return c - (ASCII_A - 10); // A-F
    }
    return -1;
}

// codec_hex_u64 renders v as exactly `width` (1..16) lowercase hex digits.
fn codec_hex_u64(v: u64, width: i32) -> String {
    let mut buf: [u8; 16] = [0; 16];
    let mut n = v;
    let mut i: usize = 0;
    while i < 16 {
        buf[i] = codec_hex_digit((n % 16) as i64);
        n = n / 16;
        i += 1;
    }
    let mut w = width;
    if w < 1 {
        w = 1;
    }
    if w > 16 {
        w = 16;
    }
    let mut out = String::with_capacity(w as usize);
    let mut j: usize = w as usize;
    while j > 0 {
        j -= 1;
        out.push_byte(buf[j]);
    }
    return out;
}

// --- hex -------------------------------------------------------------------

// hex_encode_bytes renders data as lowercase hex. Its output is always twice
// the input length, so the buffer is sized once instead of grown.
pub fn hex_encode_bytes(data: &[u8]) -> String {
    let mut out = String::with_capacity(data.len() * 2);
    let mut i: usize = 0;
    while i < data.len() {
        let b = data[i] as i64;
        out.push_byte(codec_hex_digit(b / 16));
        out.push_byte(codec_hex_digit(b % 16));
        i += 1;
    }
    return out;
}

// hex_encode renders the bytes of s as lowercase hex.
pub fn hex_encode(s: str) -> String {
    return hex_encode_bytes(s.as_bytes());
}

// hex_encode_bytes_upper renders data as uppercase hex. Both nibbles go
// through the uppercase digit table, so `ff` is "FF" and not "fF".
pub fn hex_encode_bytes_upper(data: &[u8]) -> String {
    let mut out = String::with_capacity(data.len() * 2);
    let mut i: usize = 0;
    while i < data.len() {
        let b = data[i] as i64;
        out.push_byte(codec_hex_digit_upper(b / 16));
        out.push_byte(codec_hex_digit_upper(b % 16));
        i += 1;
    }
    return out;
}

// hex_encode_upper renders the bytes of s as uppercase hex.
pub fn hex_encode_upper(s: str) -> String {
    return hex_encode_bytes_upper(s.as_bytes());
}

// hex_decode_bytes parses hex into its bytes, ignoring ASCII whitespace. An odd
// digit count or a non-hex character is an error, so a truncated token cannot
// silently decode to a shorter value.
pub fn hex_decode_bytes(data: &[u8]) -> Result<String, String> {
    let mut out = String::with_capacity(data.len() / 2);
    let mut hi: i64 = -1;
    let mut i: usize = 0;
    while i < data.len() {
        let c = data[i] as i64;
        i += 1;
        if c == 32 || c == 9 || c == 10 || c == 13 {
            continue;
        }
        let d = codec_hex_value(c);
        if d < 0 {
            return Err(String::from("invalid hex digit"));
        }
        if hi < 0 {
            hi = d;
        } else {
            out.push_byte(((hi * 16 + d) as u8));
            hi = -1;
        }
    }
    if hi >= 0 {
        return Err(String::from("odd number of hex digits"));
    }
    return Ok(out);
}

// hex_decode parses hex into its bytes, returning "" on malformed input. Use
// hex_decode_bytes when the caller needs to tell bad input from empty output.
pub fn hex_decode(s: str) -> String {
    match hex_decode_bytes(s.as_bytes()) {
        Ok(out) => return out,
        Err(_) => return String::new(),
    }
}

// --- base64 ----------------------------------------------------------------

// codec_b64 encodes data; url picks the URL-safe alphabet and pad adds `=`.
fn codec_b64(data: &[u8], url: bool, pad: bool) -> String {
    let mut alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".as_bytes();
    if url {
        alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_".as_bytes();
    }
    let mut out = String::with_capacity((data.len() / 3 + 1) * 4);
    let mut i: usize = 0;
    while i + 3 <= data.len() {
        let b0 = data[i] as i64;
        let b1 = data[i + 1] as i64;
        let b2 = data[i + 2] as i64;
        out.push_byte(alpha[(b0 / 4) as usize]);
        out.push_byte(alpha[((b0 % 4) * 16 + b1 / 16) as usize]);
        out.push_byte(alpha[((b1 % 16) * 4 + b2 / 64) as usize]);
        out.push_byte(alpha[(b2 % 64) as usize]);
        i += 3;
    }
    let rem = data.len() - i;
    if rem == 1 {
        let b0 = data[i] as i64;
        out.push_byte(alpha[(b0 / 4) as usize]);
        out.push_byte(alpha[((b0 % 4) * 16) as usize]);
        if pad {
            out.push('=');
            out.push('=');
        }
    } else if rem == 2 {
        let b0 = data[i] as i64;
        let b1 = data[i + 1] as i64;
        out.push_byte(alpha[(b0 / 4) as usize]);
        out.push_byte(alpha[((b0 % 4) * 16 + b1 / 16) as usize]);
        out.push_byte(alpha[((b1 % 16) * 4) as usize]);
        if pad {
            out.push('=');
        }
    }
    return out;
}

// base64_encode_bytes renders data with the standard alphabet and `=` padding.
pub fn base64_encode_bytes(data: &[u8]) -> String {
    return codec_b64(data, false, true);
}

// base64_encode renders s with the standard alphabet and `=` padding.
pub fn base64_encode(s: str) -> String {
    return base64_encode_bytes(s.as_bytes());
}

// base64_encode_url_bytes is base64_encode_bytes with the URL-safe alphabet and
// no padding.
pub fn base64_encode_url_bytes(data: &[u8]) -> String {
    return codec_b64(data, true, false);
}

// base64_encode_url renders s with the URL-safe alphabet and no padding.
pub fn base64_encode_url(s: str) -> String {
    return base64_encode_url_bytes(s.as_bytes());
}

// codec_b64_value is the 6-bit value of a base64 character from either
// alphabet, or -1.
fn codec_b64_value(c: i64) -> i64 {
    if c >= ASCII_A && c <= ASCII_Z {
        return c - ASCII_A; // A-Z → 0..25
    }
    if c >= ASCII_a && c <= ASCII_z {
        return c - (ASCII_a - 26); // a-z → 26..51
    }
    if c >= ASCII_0 && c <= ASCII_9 {
        return c - (ASCII_0 - 52); // 0-9 → 52..61
    }
    if c == 43 || c == 45 {
        return 62; // + or -
    }
    if c == 47 || c == 95 {
        return 63; // / or _
    }
    return -1;
}

// base64_decode_bytes decodes either alphabet, ignoring `=` and whitespace. A
// malformed length or character is an error rather than a silent truncation.
pub fn base64_decode_bytes(data: &[u8]) -> Result<String, String> {
    let mut acc: [i64; 4] = [0; 4];
    let mut n: usize = 0;
    let mut out = String::with_capacity((data.len() / 4) * 3);
    let mut i: usize = 0;
    while i < data.len() {
        let c = data[i] as i64;
        i += 1;
        if c == 61 {
            continue; // '='
        }
        if c == 32 || c == 9 || c == 10 || c == 13 {
            continue;
        }
        let d = codec_b64_value(c);
        if d < 0 {
            return Err(String::from("invalid base64 character"));
        }
        acc[n] = d;
        n += 1;
        if n == 4 {
            out.push_byte(((acc[0] * 4 + acc[1] / 16) as u8));
            out.push_byte(((acc[1] % 16 * 16 + acc[2] / 4) as u8));
            out.push_byte(((acc[2] % 4 * 64 + acc[3]) as u8));
            n = 0;
        }
    }
    if n == 2 {
        out.push_byte(((acc[0] * 4 + acc[1] / 16) as u8));
    } else if n == 3 {
        out.push_byte(((acc[0] * 4 + acc[1] / 16) as u8));
        out.push_byte(((acc[1] % 16 * 16 + acc[2] / 4) as u8));
    } else if n != 0 {
        return Err(String::from("truncated base64 input"));
    }
    return Ok(out);
}

// base64_decode decodes either alphabet, returning "" on malformed input.
pub fn base64_decode(s: str) -> String {
    match base64_decode_bytes(s.as_bytes()) {
        Ok(out) => return out,
        Err(_) => return String::new(),
    }
}

// --- checksums -------------------------------------------------------------

// crc32_bytes is the standard (zlib/IEEE 802.3) CRC-32 of data, as an unsigned
// 32-bit value in an i64.
pub fn crc32_bytes(data: &[u8]) -> i64 {
    let mut crc: i64 = CRC32_XOR;
    let mut i: usize = 0;
    while i < data.len() {
        crc = (crc ^ (data[i] as i64)) & CRC32_XOR;
        let mut k: i32 = 0;
        while k < 8 {
            if crc % 2 == 1 {
                crc = ((crc / 2) ^ CRC32_POLY) & CRC32_XOR;
            } else {
                crc = crc / 2;
            }
            k += 1;
        }
        i += 1;
    }
    return (crc ^ CRC32_XOR) & CRC32_XOR;
}

// crc32 is the standard CRC-32 of s, as an unsigned 32-bit value in an i64.
pub fn crc32(s: str) -> i64 {
    return crc32_bytes(s.as_bytes());
}

// crc32_hex is crc32 rendered as eight lowercase hex digits.
pub fn crc32_hex(s: str) -> String {
    return codec_hex_u64(crc32(s) as u64, 8);
}

// adler32_bytes is the zlib Adler-32 checksum of data, as an unsigned 32-bit
// value in an i64.
pub fn adler32_bytes(data: &[u8]) -> i64 {
    let mut a: i64 = 1;
    let mut b: i64 = 0;
    let mut i: usize = 0;
    while i < data.len() {
        a = (a + (data[i] as i64)) % ADLER32_MOD;
        b = (b + a) % ADLER32_MOD;
        i += 1;
    }
    return b * 65536 + a;
}

// adler32 is the Adler-32 checksum of s, as an unsigned 32-bit value in an i64.
pub fn adler32(s: str) -> i64 {
    return adler32_bytes(s.as_bytes());
}

// adler32_hex is adler32 rendered as eight lowercase hex digits.
pub fn adler32_hex(s: str) -> String {
    return codec_hex_u64(adler32(s) as u64, 8);
}

// fnv1a32_bytes is the 32-bit FNV-1a hash of data, as an unsigned 32-bit value
// in an i64.
pub fn fnv1a32_bytes(data: &[u8]) -> i64 {
    let mut h: i64 = FNV1A32_BASIS;
    let mut i: usize = 0;
    while i < data.len() {
        h = ((h ^ (data[i] as i64)) * FNV1A32_PRIME) & CRC32_XOR;
        i += 1;
    }
    return h;
}

// fnv1a32 is the 32-bit FNV-1a hash of s, as an unsigned 32-bit value in an i64.
pub fn fnv1a32(s: str) -> i64 {
    return fnv1a32_bytes(s.as_bytes());
}

// fnv1a32_hex is fnv1a32 rendered as eight lowercase hex digits.
pub fn fnv1a32_hex(s: str) -> String {
    return codec_hex_u64(fnv1a32(s) as u64, 8);
}

// fnv1a64_bytes is the 64-bit FNV-1a hash of data.
pub fn fnv1a64_bytes(data: &[u8]) -> u64 {
    let mut h: u64 = FNV1A64_BASIS;
    let mut i: usize = 0;
    while i < data.len() {
        h = (h ^ (data[i] as u64)) * FNV1A64_PRIME;
        i += 1;
    }
    return h;
}

// fnv1a64 is the 64-bit FNV-1a hash of s.
pub fn fnv1a64(s: str) -> u64 {
    return fnv1a64_bytes(s.as_bytes());
}

// fnv1a64_hex is fnv1a64 rendered as sixteen lowercase hex digits.
pub fn fnv1a64_hex(s: str) -> String {
    return codec_hex_u64(fnv1a64(s), 16);
}

// djb2_bytes is Bernstein's djb2 hash of data over 64 bits.
pub fn djb2_bytes(data: &[u8]) -> u64 {
    let mut h: u64 = DJB2_SEED;
    let mut i: usize = 0;
    while i < data.len() {
        h = h * 33 + (data[i] as u64);
        i += 1;
    }
    return h;
}

// djb2 is Bernstein's djb2 hash of s over 64 bits.
pub fn djb2(s: str) -> u64 {
    return djb2_bytes(s.as_bytes());
}

// djb2_hex is djb2 rendered as sixteen lowercase hex digits.
pub fn djb2_hex(s: str) -> String {
    return codec_hex_u64(djb2(s), 16);
}
