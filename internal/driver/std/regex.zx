// regex — small POSIX regular-expression helpers for Zexi.
// Import with `use regex;`, `use std::regex;`, or `import text.regex;`.
//
// Patterns use POSIX extended regular expressions (ERE), not PCRE/Python
// syntax: use `[[:digit:]]` or `[0-9]` rather than `\d`. The C ABI accepts
// text strings, so embedded NUL bytes are not supported. Invalid patterns act
// like no match; call is_valid when that distinction matters.

// RegexSpan describes the first matching byte range. A failed search has
// start == -1 and end == -1. Offsets are byte offsets, matching String.len().
pub struct RegexSpan {
    pub start: i64,
    pub end: i64,
}

// The C shim's span struct has the same two i64 fields and is only passed by
// pointer, so its ABI matches RegexSpan without exposing C details to callers.
extern "C" fn zxr_is_valid(pattern: str) -> i32;
extern "C" fn zxr_search_span(pattern: str, text: str, span: &mut RegexSpan) -> i32;
extern "C" fn zxr_full_match(pattern: str, text: str) -> i32;

// is_valid reports whether pattern can be compiled as a POSIX ERE.
pub fn is_valid(pattern: str) -> bool {
    return zxr_is_valid(pattern) == 1;
}

// match_span finds the first match anywhere in text. Its start/end are -1
// when the pattern is invalid or no match exists.
pub fn match_span(pattern: str, text: str) -> RegexSpan {
    let mut span = RegexSpan { start: -1, end: -1 };
    zxr_search_span(pattern, text, &mut span);
    return span;
}

// is_match is a search-style predicate: it is true when any substring matches.
// Use full_match when the entire text must satisfy the pattern.
pub fn is_match(pattern: str, text: str) -> bool {
    return match_span(pattern, text).start >= 0;
}

// full_match reports whether the complete text matches pattern.
pub fn full_match(pattern: str, text: str) -> bool {
    return zxr_full_match(pattern, text) == 1;
}

// find_index returns the first matching byte index, or -1 when absent/invalid.
pub fn find_index(pattern: str, text: str) -> i64 {
    return match_span(pattern, text).start;
}

// find returns the first matching substring, or "" when absent/invalid.
pub fn find(pattern: str, text: str) -> String {
    let span = match_span(pattern, text);
    if span.start < 0 {
        return String::new();
    }
    let value = String::from(text);
    return value.substr(span.start as usize, (span.end - span.start) as usize);
}

// replace_first replaces only the first matching substring. A missing or
// invalid pattern leaves text unchanged. Empty matches are supported.
pub fn replace_first(pattern: str, text: str, replacement: str) -> String {
    let span = match_span(pattern, text);
    if span.start < 0 {
        return String::from(text);
    }
    let value = String::from(text);
    let mut out = value.substr(0, span.start as usize);
    out.push_str(replacement);
    let tail = value.substr(span.end as usize, value.len() - (span.end as usize));
    out.push_str(tail.as_str());
    return out;
}

// The POSIX ERE bridge travels with the module: `regex` is a thin Zexi wrapper
// around the system matcher, and the C it needs is right here.
c """
#define _POSIX_C_SOURCE 200809L
#define _DEFAULT_SOURCE
/* zxregex.c — small POSIX ERE bridge for Zexi's opt-in regex module.
 *
 * This deliberately uses the system POSIX regex implementation instead of
 * shipping a large PCRE-like runtime. It is linked only for `use regex;` /
 * `import text.regex;` programs.
 */
#include <stdint.h>
#include <regex.h>
#include <string.h>

/* The span struct comes from the Zexi declaration of `RegexSpan`, which the
 * generated program defines above this block. */

int zxr_is_valid(const char *pattern) {
    if (!pattern) return 0;
    regex_t re;
    int ok = regcomp(&re, pattern, REG_EXTENDED) == 0;
    if (ok) regfree(&re);
    return ok;
}

/* zxr_search_span returns 1 and fills the first matched byte range, or 0 for
 * an invalid pattern/no match. The generated Zexi ABI passes a compatible
 * two-i64 RegexSpan structure by pointer. */
int zxr_search_span(const char *pattern, const char *text, zx_RegexSpan *span) {
    if (!span) return 0;
    span->start = -1;
    span->end = -1;
    if (!pattern || !text) return 0;

    regex_t re;
    if (regcomp(&re, pattern, REG_EXTENDED) != 0) return 0;
    regmatch_t match;
    int found = regexec(&re, text, 1, &match, 0) == 0;
    if (found && match.rm_so >= 0 && match.rm_eo >= match.rm_so) {
        span->start = (int64_t)match.rm_so;
        span->end = (int64_t)match.rm_eo;
    } else {
        found = 0;
    }
    regfree(&re);
    return found;
}

int zxr_full_match(const char *pattern, const char *text) {
    if (!pattern || !text) return 0;
    regex_t re;
    if (regcomp(&re, pattern, REG_EXTENDED) != 0) return 0;
    regmatch_t match;
    int found = regexec(&re, text, 1, &match, 0) == 0;
    int full = found && match.rm_so == 0 && match.rm_eo == (regoff_t)strlen(text);
    regfree(&re);
    return full ? 1 : 0;
}
"""
