// bench/sort/sort.zx — in-place quicksort of an i64 array, four rounds of
// (fill by LCG, sort, checksum). The C twin is sort.c; both must print the
// same `sort <n>` line.

const N: i64 = 400000;

fn quicksort(a: &mut [i64; 400000], lo: i64, hi: i64) {
    if lo >= hi {
        return;
    }
    let pivot = (*a)[hi as usize];
    let mut i: i64 = lo;
    let mut j: i64 = hi - 1;
    while i <= j {
        if (*a)[i as usize] < pivot {
            i += 1;
        } else {
            let t = (*a)[i as usize];
            (*a)[i as usize] = (*a)[j as usize];
            (*a)[j as usize] = t;
            j -= 1;
        }
    }
    let t = (*a)[i as usize];
    (*a)[i as usize] = (*a)[hi as usize];
    (*a)[hi as usize] = t;
    quicksort(a, lo, i - 1);
    quicksort(a, i + 1, hi);
}

fn main() -> i32 {
    let mut a: [i64; 400000] = [0; 400000];
    let mut checksum: i64 = 0;
    let mut round: i64 = 0;
    while round < 4 {
        let mut x: i64 = 12345 + round;
        let mut i: i64 = 0;
        while i < N {
            x = x * 6364136223846793005 + 1442695040888963407;
            a[i as usize] = (x & 0x7fffffffffffffff) % 1000000;
            i += 1;
        }
        quicksort(&mut a, 0, N - 1);
        checksum += a[0] + a[(N / 2) as usize] + a[(N - 1) as usize];
        i = 0;
        while i < N {
            checksum += a[i as usize] % 97;
            i += 1;
        }
        round += 1;
    }
    println("sort", checksum);
    0
}
